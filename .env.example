# Supabase (project: startups-co-ke, ref eezqpsbhmnhuhnmiwnsz)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Optional: enable privacy-friendly analytics when set (Plausible-compatible)
# PUBLIC_ANALYTICS_DOMAIN=

# Worker runtime (the single backend). Public values also live in
# wrangler.jsonc vars; SECRETS go ONLY in the Cloudflare dashboard
# (Workers → startups-co-ke → Settings → Variables & Secrets), never in git.
# Email: Resend, sender domain startups.co.ke is VERIFIED → notices@startups.co.ke.
RESEND_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Desk identity (owner-only desk login + email recipient). NO code fallback: if this
# is missing, the desk fails closed. Use a mailbox that exists — Resend sends
# FROM your domain but does not host mailboxes.
DESK_EMAIL=desk@startups.co.ke
# Public Turnstile site key (also in wrangler.jsonc vars); the secret below is
# Worker-only. With no secret the bot check is skipped (fine for local dev).
# PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# RESEND_FROM=startups.co.ke <notices@startups.co.ke>
