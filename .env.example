PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Optional: enable privacy-friendly analytics when set (Plausible-compatible)
# PUBLIC_ANALYTICS_DOMAIN=

# Resend — review-queue email notifications (netlify/functions/notify.mjs)
# Server-side only: set these in Netlify UI → Site configuration → Environment variables
# startups.co.ke is VERIFIED in Resend → default sender is notices@startups.co.ke,
# deliverable to any inbox. NOTIFY_EMAIL can stay gmail or move to contact@startups.co.ke
# once that mailbox exists (Resend sends from your domain; it does not host mailboxes).
RESEND_API_KEY=
NOTIFY_EMAIL=jackblessed191@gmail.com
# RESEND_FROM=startups.co.ke <notices@startups.co.ke>
