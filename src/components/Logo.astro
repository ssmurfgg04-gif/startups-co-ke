---
/** Brand logo — hand-set "s." mark: chalk-drawn serif s, amber full-stop dot.
 * The dot is the point: a record that ends in evidence. Tilts slightly on hover. */
interface Props { variant?: 'dark' | 'light'; href?: string; class?: string }
const { variant = 'light', href = '/', class: cls = '' } = Astro.props;
const text = variant === 'light' ? 'text-ink' : 'text-dpaper';
---
<a href={href} class={`group inline-flex items-center gap-2.5 ${cls}`} aria-label="startups.co.ke home">
  <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true" class="shrink-0 transition-transform duration-300 group-hover:-rotate-6">
    <rect x="0" y="0" width="64" height="64" rx="12" fill="var(--color-green)"></rect>
    <path d="M43.5 23 C41.5 16.5, 26.5 15.5, 23.5 22.5 C21 29.5, 30 31.5, 34 33 C39 35, 43.5 37.5, 40.5 44 C37.5 50.5, 24 49, 20.5 41.5" fill="none" stroke="var(--color-paper)" stroke-width="7" stroke-linecap="round"></path>
    <circle cx="50.5" cy="46.5" r="5.2" fill="var(--color-amber2)"></circle>
  </svg>
  <span class={`text-[18px] leading-none ${text}`}>
    <span class="font-display font-bold tracking-tight">startups</span><span class="font-mono font-semibold text-amber">.co.ke</span>
  </span>
</a>
