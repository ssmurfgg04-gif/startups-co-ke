---
/** Cookie consent banner, compact, dismissible, bottom-left. Choice stored,
 *  analytics loads only after consent. Kept small so it never blocks page
 *  controls (audit fix): narrow card, one-line copy, quiet dismiss. */
---
<div id="cookie-banner" class="fixed bottom-4 left-4 z-[65] hidden w-[min(340px,88vw)] border border-ink bg-paper p-3.5 text-ink shadow-[5px_5px_0_var(--color-paper3)]" role="dialog" aria-label="Cookie consent">
  <div class="flex items-start justify-between gap-3">
    <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-green">Cookies</p>
    <button id="cookie-dismiss" class="-mr-1 -mt-1 p-1 font-mono text-[12px] leading-none text-mut hover:text-ink" aria-label="Dismiss">✕</button>
  </div>
  <p class="mt-1.5 text-[12.5px] leading-snug text-ink2">
    Essential cookies for sign-in; privacy-friendly analytics only if you agree. <a href="/privacy" class="text-green underline">Privacy policy</a>.
  </p>
  <div class="mt-2.5 flex gap-2">
    <button id="cookie-accept" class="btn btn-amber h-8 flex-1 text-[13px]">Accept all</button>
    <button id="cookie-essential" class="btn btn-ghost h-8 flex-1 text-[13px]">Essential only</button>
  </div>
</div>

<script>
  const KEY = 'sck-consent';
  const banner = document.getElementById('cookie-banner');
  const consent = localStorage.getItem(KEY);
  if (!consent && banner) banner.classList.remove('hidden');

  function choose(v: 'all' | 'essential') {
    localStorage.setItem(KEY, v);
    banner?.classList.add('hidden');
    document.dispatchEvent(new CustomEvent('sck:toast', { detail: { title: 'Preference saved', body: v === 'all' ? 'Analytics enabled.' : 'Essential cookies only.' } }));
    if (v === 'all') loadAnalytics();
  }
  document.getElementById('cookie-accept')?.addEventListener('click', () => choose('all'));
  document.getElementById('cookie-essential')?.addEventListener('click', () => choose('essential'));
  // dismiss without consenting, ask again next visit, never blocks the page
  document.getElementById('cookie-dismiss')?.addEventListener('click', () => banner?.classList.add('hidden'));

  function loadAnalytics() {
    const domain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN as string | undefined;
    if (!domain || document.querySelector('script[data-analytics]')) return;
    const s = document.createElement('script');
    s.defer = true;
    s.dataset.analytics = 'true';
    s.src = 'https://plausible.io/js/script.js';
    s.setAttribute('data-domain', domain);
    document.head.appendChild(s);
  }
  if (consent === 'all') loadAnalytics();
</script>
