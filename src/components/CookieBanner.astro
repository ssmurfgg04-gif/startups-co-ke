---
/** Cookie consent banner — "usual cookies" per spec; choice stored, analytics loads only after consent. */
---
<div id="cookie-banner" class="fixed bottom-4 left-4 z-[65] hidden w-[min(420px,92vw)] border border-ink bg-paper p-4 text-ink shadow-[6px_6px_0_var(--color-paper3)]" role="dialog" aria-label="Cookie consent">
  <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-green">Cookies &amp; data</p>
  <p class="mt-2 text-[13px] leading-snug text-ink2">
    We use essential cookies for sign-in sessions and your preferences, plus privacy-friendly analytics (only after you agree) to understand what the ecosystem reads.
    See our <a href="/privacy" class="text-green underline">privacy policy</a>.
  </p>
  <div class="mt-3 flex gap-2">
    <button id="cookie-accept" class="btn btn-amber h-9 flex-1">Accept all</button>
    <button id="cookie-essential" class="btn btn-ghost h-9 flex-1">Essential only</button>
  </div>
</div>

<script>
  const KEY = 'sck-consent';
  const banner = document.getElementById('cookie-banner');
  const consent = localStorage.getItem(KEY);
  if (!consent && banner) banner.classList.remove('hidden');

  function choose(v: 'all' | 'essential') {
    localStorage.setItem(KEY, v);
    banner?.classList.add('hidden');
    document.dispatchEvent(new CustomEvent('sck:toast', { detail: { title: 'Preference saved', body: v === 'all' ? 'Analytics enabled.' : 'Essential cookies only.' } }));
    if (v === 'all') loadAnalytics();
  }
  document.getElementById('cookie-accept')?.addEventListener('click', () => choose('all'));
  document.getElementById('cookie-essential')?.addEventListener('click', () => choose('essential'));

  function loadAnalytics() {
    const domain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN as string | undefined;
    if (!domain || document.querySelector('script[data-analytics]')) return;
    const s = document.createElement('script');
    s.defer = true;
    s.dataset.analytics = 'true';
    s.src = 'https://plausible.io/js/script.js';
    s.setAttribute('data-domain', domain);
    document.head.appendChild(s);
  }
  if (consent === 'all') loadAnalytics();
</script>
