---
/** WhatsApp-first share buttons (nice previews via OG tags in Seo.astro). */
interface Props { title: string; class?: string }
const { title, class: cls = '' } = Astro.props;
const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const text = encodeURIComponent(`${title}, startups.co.ke`);
const links = [
  { label: 'Share on WhatsApp', href: `https://wa.me/?text=${text}%20${encodeURIComponent(url)}`, icon: 'wa' },
  { label: 'Share on X', href: `https://twitter.com/intent/tweet?text=${text}&url=${encodeURIComponent(url)}`, icon: 'x' },
  { label: 'Share on LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`, icon: 'in' },
];
---
<div class={`flex flex-wrap items-center gap-2 ${cls}`} role="group" aria-label="Share this page">
  {links.map((l) => (
    <a
      class="btn btn-ghost h-9 px-3"
      href={l.href}
      target="_blank"
      rel="noopener"
      aria-label={l.label}
      title={l.label}
    >
      {l.icon === 'wa' && (
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1a13 13 0 0 1-5.7-5c-.4-.7-.8-1.6-.8-2.4 0-.9.5-1.4.7-1.6.2-.2.4-.3.6-.3h.5c.2 0 .4 0 .5.4l.7 1.7c.1.2 0 .4-.1.5l-.3.4c-.2.2-.3.4-.2.6.3.6.8 1.2 1.3 1.7.6.5 1.2.9 1.8 1.1.3.1.5 0 .6-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.3.1.4.3.4.4 0 .1 0 .4-.1.5Z"/></svg>
      )}
      {l.icon === 'x' && (
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.7 3H21l-7.1 8.2L22.2 21h-6.6l-5.1-6.7L4.6 21H1.3l7.6-8.7L2 3h6.7l4.6 6.1L17.7 3Zm-1.2 16h1.8L7.7 4.9H5.8L16.5 19Z"/></svg>
      )}
      {l.icon === 'in' && (
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.5c0-1.3 0-3-1.9-3s-2.2 1.4-2.2 2.9V21h-4V9Z"/></svg>
      )}
      <span class="hidden sm:inline">{l.icon === 'wa' ? 'WhatsApp' : l.icon === 'x' ? 'Post' : 'LinkedIn'}</span>
    </a>
  ))}
  <button class="btn btn-ghost h-9 px-3" data-copy-link={url} aria-label="Copy link">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1 0l2.8-2.8a5 5 0 0 0-7.1-7.1L11 5"></path><path d="M14 11a5 5 0 0 0-7.1 0L4.1 13.8a5 5 0 0 0 7.1 7.1L13 19"></path></svg>
    <span class="hidden sm:inline">Copy link</span>
  </button>
</div>

<script>
  document.querySelectorAll('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-copy-link');
      try {
        await navigator.clipboard.writeText(url ?? location.href);
        document.dispatchEvent(new CustomEvent('sck:toast', { detail: { title: 'Link copied', body: url } }));
      } catch {
        document.dispatchEvent(new CustomEvent('sck:toast', { detail: { title: 'Copy failed', body: 'Select the URL manually.' } }));
      }
    });
  });
</script>
