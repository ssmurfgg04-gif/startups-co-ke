---
/** Sticky masthead: logo, mono-caps nav with amber underline, global search (/), auth, mobile nav. */
import Logo from './Logo.astro';
import { SITE } from '@/config/site';
const nav = SITE.nav;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="sticky top-0 z-40 border-b border-ink bg-paper/95 backdrop-blur-sm">
  <div class="wrap flex h-14 items-center gap-4 md:h-16">
    <Logo />

    <nav class="ml-4 hidden items-center gap-5 lg:flex" aria-label="Primary">
      {nav.map((item) => (
        <div class="relative group">
          <a class={`link-underline flex items-center gap-1 ${isActive(item.href) ? 'text-amber' : ''}`} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} aria-haspopup={item.children ? 'true' : undefined}>
            {item.label}
            {item.children && (
              <svg class="h-3 w-3 text-mut transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
            )}
          </a>
          {item.children && (
            <div class="invisible absolute left-0 top-full z-50 w-56 translate-y-1 border border-ink bg-paper opacity-0 shadow-[6px_6px_0_var(--color-paper3)] transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
              {item.children.map((child) => (
                <a class="block border-b border-line px-4 py-2.5 font-mono text-[11px] uppercase tracking-[0.1em] last:border-0 hover:bg-paper2" href={child.href}>{child.label}</a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2.5">
      <div class="relative hidden md:block">
        <input id="global-search" class="input input-mono h-9 w-52 pl-8" type="search" placeholder="Search — press /" aria-label="Search companies, investors, jobs, news" autocomplete="off" />
        <svg class="absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-mut" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
        <div id="search-panel" class="absolute right-0 top-11 z-50 hidden w-[380px] border border-ink bg-paper shadow-xl" role="listbox" aria-label="Search results"></div>
      </div>

      <button id="auth-btn" class="btn btn-ghost h-9 px-3" data-modal="auth">Sign in</button>
      <button type="button" class="btn btn-amber hidden h-9 px-3 sm:inline-flex" data-modal="postjob">Post a job</button>

      <button id="mobile-nav-btn" class="btn btn-ghost h-9 px-3 lg:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-ink bg-paper lg:hidden" aria-label="Mobile">
    {nav.map((item) => (
      <div>
        <a class="block border-b border-line px-5 py-3.5 font-mono text-xs uppercase tracking-[0.14em]" href={item.href}>{item.label}</a>
        {item.children?.map((child) => (
          <a class="block border-b border-line py-2.5 pl-9 pr-5 font-mono text-[11px] uppercase tracking-[0.1em] text-ink2" href={child.href}>· {child.label}</a>
        ))}
      </div>
    ))}
    <a class="block border-b border-line px-5 py-3.5 font-mono text-xs uppercase tracking-[0.14em] text-amber" href="/about">About</a>
    <a class="block border-b border-line px-5 py-3.5 font-mono text-xs uppercase tracking-[0.14em] text-amber" href="/contact">Contact</a>
  </nav>
</header>

<script>
  // Mobile nav
  const navBtn = document.getElementById('mobile-nav-btn');
  const mobileNav = document.getElementById('mobile-nav');
  navBtn?.addEventListener('click', () => {
    const open = mobileNav?.classList.toggle('hidden') === false;
    navBtn.setAttribute('aria-expanded', String(open));
  });

  // "/" focuses search
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes((e.target as HTMLElement)?.tagName)) {
      e.preventDefault();
      (document.getElementById('global-search') as HTMLInputElement | null)?.focus();
    }
  });

  // Global search — index fetched once from build-time JSON endpoint
  type SearchItem = { t: string; k: 'Companies' | 'Investors' | 'Jobs' | 'News' | 'Hackathons' | 'Go-to'; u: string; s?: string };
  let INDEX: SearchItem[] | null = null;
  const panel = document.getElementById('search-panel');
  const input = document.getElementById('global-search') as HTMLInputElement | null;

  async function ensureIndex(): Promise<SearchItem[]> {
    if (!INDEX) {
      try {
        INDEX = await (await fetch('/search-index.json')).json();
      } catch {
        INDEX = [];
      }
    }
    return INDEX ?? [];
  }

  function renderResults(q: string, index: SearchItem[]) {
    if (!panel) return;
    if (!q) { panel.classList.add('hidden'); panel.innerHTML = ''; return; }
    const ql = q.toLowerCase();
    const hits = index.filter((i) => i.t.toLowerCase().includes(ql) || (i.s ?? '').toLowerCase().includes(ql)).slice(0, 12);
    if (!hits.length) {
      panel.innerHTML = '<p class="px-4 py-3 font-mono text-xs text-mut">No results — try “pesa”, “seed”, “Nairobi”.</p>';
      panel.classList.remove('hidden');
      return;
    }
    const groups = new Map<string, SearchItem[]>();
    for (const h of hits) {
      if (!groups.has(h.k)) groups.set(h.k, []);
      groups.get(h.k)!.push(h);
    }
    panel.innerHTML = [...groups.entries()]
      .map(
        ([group, rows]) => `
        <div class="border-b border-line last:border-0">
          <p class="mono-label px-4 pt-2.5 pb-1">${group}</p>
          ${rows
            .map(
              (r) =>
                `<a class="block px-4 py-2 text-sm hover:bg-paper2" href="${r.u}">${r.t}${r.s ? ` <span class="mono-label ml-1">${r.s}</span>` : ''}</a>`
            )
            .join('')}
        </div>`
      )
      .join('');
    panel.classList.remove('hidden');
  }

  input?.addEventListener('focus', ensureIndex);
  input?.addEventListener('input', async () => {
    renderResults(input.value.trim(), await ensureIndex());
  });
  input?.addEventListener('keydown', async (e) => {
    if (e.key === 'Enter') {
      const index = await ensureIndex();
      const ql = input.value.trim().toLowerCase();
      const first = index.find((i) => i.t.toLowerCase().includes(ql) || (i.s ?? '').toLowerCase().includes(ql));
      if (first) location.href = first.u;
    }
    if (e.key === 'Escape' && panel) {
      panel.classList.add('hidden');
      input.blur();
    }
  });
  document.addEventListener('click', (e) => {
    if (panel && !panel.closest('.relative')?.contains(e.target as Node)) panel.classList.add('hidden');
  });
</script>
