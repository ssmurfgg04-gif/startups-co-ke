---
import Monogram from './Monogram.astro';
import Chip from './Chip.astro';
import { sectorColor } from '@/config/sectors';
import type { Company } from '@/data/types';

interface Props { company: Company }
const { company: c } = Astro.props;
const raisedLabel =
  c.raisedDisplay ?? (c.raised != null ? `Raised $${c.raised.toFixed(1)}M` : 'Funding n/d');
const statusKind =
  c.status === 'In administration' ? 'administration'
  : c.status === 'In liquidation' ? 'liquidation'
  : c.status === 'Shut down' ? 'shutdown'
  : c.status === 'Restructuring' ? 'restructuring'
  : null;
---
<a href={`/startups/${c.id}`} class="group block border border-ink bg-paper p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_var(--color-paper3)]">
  <div class="flex items-start justify-between gap-3">
    <Monogram name={c.name} sector={c.sector} size="lg" logo={c.logo ?? undefined} domain={c.domain ?? undefined} />
    {c.verified ? <Chip kind="verified" /> : <Chip kind="unverified" />}
  </div>
  <h3 class="mt-4 font-display text-[19px] leading-tight">{c.name}</h3>
  <p class="mt-1.5 line-clamp-2 text-[13.5px] text-mut">{c.tagline}</p>
  <div class="mt-3.5 flex flex-wrap gap-1.5">
    <span class="chip"><span class="inline-block h-2 w-2" style={`background:${sectorColor(c.sector)}`} aria-hidden="true"></span>{c.sector}</span>
    <span class="chip chip-dashed">{c.stage}</span>
    {statusKind && <Chip kind={statusKind} />}
  </div>
  <div class="mt-4 flex items-center justify-between border-t border-line pt-3 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">
    <span>📍 {c.hq}</span>
    <span>{raisedLabel}</span>
    <span class="text-ink transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
  </div>
</a>
