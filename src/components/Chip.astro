---
/**
 * Honesty-system chips (D2): status + verification labels for real, sourced data.
 * verified = cross-checked against >=2 independent public sources as of 2026-10-15.
 */
interface Props {
  kind:
    | 'verified'
    | 'unverified'
    | 'confirmed'
    | 'reported'
    | 'estimated'
    | 'active'
    | 'administration'
    | 'liquidation'
    | 'shutdown'
    | 'restructuring'
    | 'band'
    | 'tba'
    | 'notTracked';
}
const LABELS: Record<string, string> = {
  verified: '\u2713 Verified',
  unverified: 'Unverified',
  confirmed: 'Confirmed',
  reported: 'Reported',
  estimated: 'Estimated',
  active: 'Active',
  administration: 'In administration',
  liquidation: 'In liquidation',
  shutdown: 'Shut down',
  restructuring: 'Restructuring',
  band: 'Market band, not an offer',
  tba: 'Dates TBA',
  notTracked: 'Not tracked',
};
const { kind } = Astro.props;
const label = LABELS[kind];
const solid = ['verified', 'confirmed', 'active'].includes(kind);
const dashed = ['unverified', 'reported', 'estimated', 'notTracked', 'tba', 'band'].includes(kind);
const alert = ['administration', 'liquidation', 'shutdown', 'restructuring'].includes(kind);
const cls = solid ? 'chip chip-solid' : alert ? 'chip chip-alert' : dashed ? 'chip chip-dashed' : 'chip';
---
<span class={cls} title={kind === 'verified' ? 'Cross-checked against at least 2 independent public sources (Oct 15, 2026)' : undefined}>{label}</span>
