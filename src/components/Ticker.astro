---
/** Top wire bar: Nairobi clock + infinite marquee of REAL, sourced wire items. */
import { WIRE } from '@/data/stats';
const items = WIRE;
---
<div class="marquee bg-green text-dpaper overflow-hidden border-b border-green2">
  <div class="wrap flex items-stretch gap-4 py-1.5">
    <div class="flex shrink-0 items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em]">
      <span class="anim-blink inline-block h-2 w-2 rounded-full bg-amber2" aria-hidden="true"></span>
      <span class="whitespace-nowrap">WIRE · <span id="wire-day">—</span> · <span id="wire-clock">--:--</span> EAT</span>
    </div>
    <div class="marquee min-w-0 flex-1 overflow-hidden">
      <div class="marquee-track font-mono text-[10px] uppercase tracking-[0.1em] text-dpaper/90" aria-hidden="true">
        {[0, 1].map(() => (
          <span class="inline-flex shrink-0 gap-10 pr-10">
            {items.map((item) => (
              <span class="whitespace-nowrap">
                <span class="text-amber2">◆</span> {item.body} <span class="text-dpaper/80">· {item.source}</span>
              </span>
            ))}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  function tickClock() {
    const now = new Date();
    const time = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Africa/Nairobi' }).format(now);
    const day = new Intl.DateTimeFormat('en-GB', { weekday: 'short', timeZone: 'Africa/Nairobi' }).format(now).toUpperCase();
    const c = document.getElementById('wire-clock');
    const d = document.getElementById('wire-day');
    if (c) c.textContent = time;
    if (d) d.textContent = day;
  }
  tickClock();
  setInterval(tickClock, 30_000);
</script>
