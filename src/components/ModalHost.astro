<script>
  // Turnstile loads on demand: no Cloudflare script or request on the 45 pages
  // that never open the publish dialog. Implicit render scans the DOM when the
  // script lands, so the widget appears inside the already-open dialog.
  let turnstileLoading = false;
  const loadTurnstile = () => {
    if (turnstileLoading || !document.querySelector('.cf-turnstile')) return;
    turnstileLoading = true;
    const s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  };

  // --- open/close plumbing ---
  // While any dialog is open we flag <body>, fixed chrome (cookie banner,
  // data chip) hides via CSS because iOS Safari paints fixed elements above
  // top-layer dialogs (buried the cookie banner over modals on real phones).
  const syncModalOpen = () => {
    const anyOpen = Array.from(document.querySelectorAll('dialog')).some((d) => d.open);
    document.body.classList.toggle('modal-open', anyOpen);
  };
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const opener = t.closest('[data-modal]') as HTMLElement | null;
    if (opener) {
      const dlg = document.getElementById(`modal-${opener.dataset.modal}`) as HTMLDialogElement | null;
      if (dlg) {
        if (!dlg.open) dlg.showModal();
        syncModalOpen();
        if (dlg.id === 'modal-submit') loadTurnstile();
        if (dlg.id === 'modal-auth') window.dispatchEvent(new Event('sck:auth-opened'));
        return;
      }
    }
    if (t.closest('[data-close]')) {
      const dlg = t.closest('dialog') as HTMLDialogElement | null;
      dlg?.close();
      syncModalOpen();
    }
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.dialog-card').forEach((dlg) => {
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close(); // backdrop click
    });
    dlg.addEventListener('close', syncModalOpen);
  });

  // --- dropzones: drag & drop or click-to-browse (custom, replaces native file input) ---
  document.querySelectorAll<HTMLElement>('[data-dropzone]').forEach((zone) => {
    const input = zone.querySelector<HTMLInputElement>('input[type="file"]');
    const label = zone.querySelector<HTMLElement>('[data-dropzone-label]');
    if (!input || !label) return;
    const defaultText = label.textContent;
    const show = (name?: string) => { label.textContent = name || defaultText; };
    input.addEventListener('change', () => show(input.files?.[0]?.name));
    ['dragover', 'dragenter'].forEach((ev) => zone.addEventListener(ev, (e) => { e.preventDefault(); (e.currentTarget as HTMLElement).classList.add('border-ink', 'text-ink'); }));
    ['dragleave', 'dragend'].forEach((ev) => zone.addEventListener(ev, () => zone.classList.remove('border-ink', 'text-ink')));
    zone.addEventListener('drop', (e) => {
      e.preventDefault();
      zone.classList.remove('border-ink', 'text-ink');
      const file = e.dataTransfer?.files?.[0];
      if (!file) return;
      const dt = new DataTransfer();
      dt.items.add(file);
      input.files = dt.files;
      show(file.name);
    });
  });

  // --- post-a-job conditional fields ---
  const paySel = document.getElementById('pj-pay') as HTMLSelectElement | null;
  const rangeWrap = document.getElementById('pj-range-wrap');
  paySel?.addEventListener('change', () => {
    if (!rangeWrap) return;
    rangeWrap.classList.toggle('hidden', paySel.value !== 'Range');
  });
  const applySel = document.getElementById('pj-apply') as HTMLSelectElement | null;
  const applyDetail = document.querySelector<HTMLInputElement>('[data-apply-detail]');
  const applyHint = document.querySelector<HTMLElement>('[data-apply-hint]');
  const APPLY_HINTS: Record<string, { ph: string; hint: string }> = {
    'Email CV': { ph: 'jobs@yourco.co.ke', hint: 'CVs go straight to this inbox, we never sit in between.' },
    WhatsApp: { ph: '+254 7XX XXX XXX', hint: 'Applicants open WhatsApp with your number pre-filled.' },
    'Portal link': { ph: 'https://careers.yourco.co.ke/role', hint: 'We link straight to your portal, no accounts here.' },
  };
  applySel?.addEventListener('change', () => {
    const cfg = APPLY_HINTS[applySel.value];
    if (!cfg || !applyDetail || !applyHint) return;
    applyDetail.placeholder = cfg.ph;
    applyHint.textContent = cfg.hint;
  });

  // --- form plumbing (Supabase with local fallback + email notify) ---
  const KIND_TITLES: Record<string, string> = {
    startup: 'Submission received',
    claim: 'Claim request received',
    job: 'Job posting received',
    event: 'Event submitted',
    intro: 'Introduction requested',
    register: 'Team registered',
    apply: 'Application sent',
    issue: 'Report received',
    trial: 'Trial started',
    buy: 'Request received',
    sponsor: 'Message sent',
    newsletter: 'Subscribed',
    auth: 'Magic link sent',
  };

  // --- submit-your-startup: instant publish (no approval) or review fallback ---
  const submitForm = document.querySelector<HTMLFormElement>('form[data-kind="startup"]');
  const toggleBtn = submitForm?.querySelector<HTMLButtonElement>('[data-toggle-mode]');
  toggleBtn?.addEventListener('click', () => {
    const instant = submitForm!.dataset.mode === 'instant';
    submitForm!.dataset.mode = instant ? 'review' : 'instant';
    toggleBtn.textContent = instant ? 'Publish instantly instead' : 'Submit for review instead';
    const go = submitForm!.querySelector<HTMLButtonElement>('[data-publish-actions] button[type="submit"]');
    if (go) go.textContent = instant ? 'Submit for review →' : 'Publish now, live immediately →';
  });

  /**
   * Idempotency ref: generated once per form session and REUSED on every
   * retry, so a flaky mobile network can never publish a startup twice, the
   * server dedupes on this ref and returns the original slug.
   */
  function clientRefFor(form: HTMLFormElement): string {
    if (!form.dataset.clientRef) form.dataset.clientRef = crypto.randomUUID();
    return form.dataset.clientRef;
  }

  function showPublishError(msg: string) {
    const box = submitForm?.querySelector('#publish-error');
    if (box) {
      box.querySelector('[data-publish-error-msg]')?.replaceChildren(document.createTextNode(msg));
      box.classList.remove('hidden');
      submitForm?.querySelector('#publish-success')?.classList.add('hidden');
    }
    window.sckToast({ title: 'Publish failed', body: msg, kind: 'warn' });
  }
  function hidePublishError() {
    submitForm?.querySelector('#publish-error')?.classList.add('hidden');
  }

  /**
   * POST the listing with one automatic retry on network-level failure
   * (TypeError from fetch = DNS/radio/timeout, not a server answer). The
   * clientRef makes the retry safe: worst case the server replies "already
   * published" with the same slug.
   */
  async function publishListing(body: Record<string, unknown>, token?: string): Promise<{ slug: string; url: string }> {
    const doFetch = () => fetch('/api/startup-create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', ...(token ? { Authorization: `Bearer ${token}` } : {}) },
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(25000),
    });
    let res: Response;
    try {
      res = await doFetch();
    } catch {
      // One honest retry for transient radio drops (Kenyan networks are real).
      await new Promise((r) => setTimeout(r, 1200));
      try {
        res = await doFetch();
      } catch {
        throw new Error('We could not reach the server twice in a row. Check your connection, then press Publish again, your entries are safe.');
      }
    }
    const out = (await res.json().catch(() => ({}))) as { ok?: boolean; slug?: string; url?: string; errors?: Record<string, string>; error?: string };
    if (!res.ok || !out.ok) {
      const errs = out.errors;
      const msg = errs && Object.keys(errs).length
        ? Object.entries(errs).map(([k, v]) => `${k}: ${v}`).join(' · ')
        : out.error || `Server answered ${res.status}`;
      throw new Error(msg);
    }
    return { slug: String(out.slug), url: String(out.url || `https://startups.co.ke/startups/community/${out.slug}`) };
  }

  function showPublishSuccess(slug: string) {
    const url = `https://startups.co.ke/startups/community/${slug}`;
    submitForm?.querySelector('[data-live-url]')?.replaceChildren(document.createTextNode(url));
    const open = submitForm?.querySelector<HTMLAnchorElement>('[data-open-live]');
    if (open) open.href = url;
    submitForm?.querySelector('#publish-success')?.classList.remove('hidden');
    submitForm?.querySelector('[data-publish-actions]')?.classList.add('hidden');
    submitForm?.querySelector('[data-toggle-mode]')?.closest('p')?.classList.add('hidden');
    // Blobs replicate across regions within seconds, poll the live page until
    // it answers 200, then arm the “Open my profile” button. Honest UX: the
    // button says “Going live…” until the page REALLY answers.
    const btn = submitForm?.querySelector<HTMLAnchorElement>('[data-open-live]');
    if (btn) {
      btn.textContent = 'Going live…';
      btn.setAttribute('aria-disabled', 'true');
      const started = Date.now();
      const poll = async (): Promise<void> => {
        try {
          const r = await fetch(url, { method: 'HEAD' });
          if (r.ok) {
            btn.textContent = 'Open my profile →';
            btn.removeAttribute('aria-disabled');
            return;
          }
        } catch { /* keep polling */ }
        if (Date.now() - started < 45000) setTimeout(poll, 2000);
        else btn.textContent = 'Open my profile (retry) →';
      };
      setTimeout(poll, 1500);
    }
  }
  submitForm?.querySelector('[data-copy-live]')?.addEventListener('click', async (ev) => {
    const btn = ev.currentTarget as HTMLButtonElement | null;
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(submitForm?.querySelector('[data-live-url]')?.textContent || '');
      btn.textContent = 'Copied ✓';
      setTimeout(() => { btn.textContent = 'Copy link'; }, 1600);
    } catch { /* clipboard blocked, the URL is selectable text anyway */ }
  });
  submitForm?.querySelector('[data-list-another]')?.addEventListener('click', () => {
    submitForm!.querySelector('#publish-success')?.classList.add('hidden');
    submitForm!.querySelector('[data-publish-actions]')?.classList.remove('hidden');
    submitForm!.querySelector('[data-toggle-mode]')?.closest('p')?.classList.remove('hidden');
    submitForm!.reset();
    submitForm!.querySelectorAll('input[type="file"]').forEach((fi) => fi.dispatchEvent(new Event('change')));
  });

  document.querySelectorAll<HTMLFormElement>('dialog form[data-kind]').forEach((form) => {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const kind = form.dataset.kind!;
      const data = Object.fromEntries(new FormData(form).entries());
      // Turnstile token for THIS form (several widgets can share the page).
      const tsToken = String((data as Record<string, unknown>)['cf-turnstile-response'] || '');
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) { btn.dataset.origLabel = btn.textContent ?? ''; btn.disabled = true; btn.textContent = 'Sending…'; }
      let logoPath: string | undefined;
      // Track whether this submit was an instant publish (needs its own
      // success + error UX: the dialog stays open and shows the live URL).
      const instantPublish = kind === 'startup' && form.dataset.mode === 'instant';
      if (instantPublish) hidePublishError();
      // Auth email-link success starts a 45s resend cooldown that owns the
      // button; `authKeepBtn` tells the finally block to leave it alone.
      let authKeepBtn = false;
      try {
        if (kind === 'auth') {
          const sbMod = await import('@/lib/supabase');
          const sb = sbMod.supabase();
          if (!sb) throw new Error('not-configured');
          const mode = form.dataset.authMode || 'pass';
          const msgEl = document.getElementById(mode === 'link' ? 'auth-link-msg' : mode === 'signup' ? 'auth-su-msg' : 'auth-pass-msg');
          const showMsg = (t: string) => { if (msgEl) { msgEl.textContent = t; msgEl.classList.remove('hidden'); } else throw new Error(t); };
          // Explicit per-mode validation: the form carries novalidate (hidden
          // required inputs used to cancel native submission silently), so the
          // handler owns the checks and surfaces them inline.
          const val = (id: string) => String((document.getElementById(id) as HTMLInputElement | null)?.value || '').trim();
          const okEmail = (v: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

          if (mode === 'pass') {
            // Password sign-in: failures surface inline (honest), success closes.
            const email = val('auth-pass-email');
            const pw = String((document.getElementById('auth-pass-pw') as HTMLInputElement | null)?.value || '');
            if (!okEmail(email)) { showMsg('Enter your email address above, then press Sign in.'); if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Sign in'; } return; }
            if (!pw) { showMsg('Enter your password. First time here? Create an account below, or use the Email link tab.'); if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Sign in'; } return; }
            const { data: pd, error } = await sb.auth.signInWithPassword({ email, password: pw });
            if (error) {
              const m = String((error as { message?: string }).message || error);
              const hint = /invalid login credentials/i.test(m)
                ? 'That email and password do not match. Never set a password? Use "Forgot password?" below, or the Email link tab once.'
                : /email not confirmed/i.test(m)
                  ? 'This address is not confirmed yet. Check your inbox for the verification email, or sign in with the Email link tab once.'
                  : /rate|too many/i.test(m)
                    ? 'Too many attempts right now, wait a couple of minutes and try again.'
                    : `Sign-in failed (${m}). Check the details and try again.`;
              showMsg(hint);
              if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Sign in'; }
              return;
            }
            if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Sign in'; }
            form.closest('dialog')?.close();
            form.reset();
            // Kill the signed-out marker + flip the masthead chip NOW — a
            // signed-in user whose header still says "Sign in" on every page
            // was the most-reported symptom of the broken sign-in.
            try {
              localStorage.removeItem('sck-auth-none');
              window.dispatchEvent(new CustomEvent('sck:auth-changed', { detail: { email: pd?.user?.email || email } }));
            } catch { /* storage blocked, idle check self-corrects later */ }
            window.sckToast({ title: 'Signed in', body: 'Welcome back. You are signed in with email and password.' });
            return;
          }

          if (mode === 'signup') {
            // Documented email+password signup. If the project requires email
            // verification there is no session yet — say so plainly.
            const email = val('auth-su-email');
            const pw = String((document.getElementById('auth-su-pw') as HTMLInputElement | null)?.value || '');
            if (!okEmail(email)) { showMsg('Enter a valid email address to create your account.'); if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Create account'; } return; }
            if (pw.length < 8) { showMsg('Choose a password of at least 8 characters.'); if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Create account'; } return; }
            const { data: sd, error } = await sb.auth.signUp({ email, password: pw, options: { emailRedirectTo: window.location.origin } });
            if (error) {
              const m = String((error as { message?: string }).message || error);
              showMsg(/already registered/i.test(m)
                ? 'An account with this email already exists — sign in instead (use "Forgot password?" if you have lost the password).'
                : /rate|too many/i.test(m)
                  ? 'Too many attempts right now, wait a couple of minutes and try again.'
                  : `Could not create the account (${m}).`);
              if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Create account'; }
              return;
            }
            if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Create account'; }
            if (sd?.session) {
              form.closest('dialog')?.close();
              form.reset();
              try {
                localStorage.removeItem('sck-auth-none');
                window.dispatchEvent(new CustomEvent('sck:auth-changed', { detail: { email: sd.user?.email || email } }));
              } catch { /* storage blocked */ }
              window.sckToast({ title: 'Account created', body: 'You are signed in. Welcome.' });
            } else {
              form.reset();
              showMsg('Account created. Check your email for the verification link, then sign in with your password. No email? Use the Email link tab once to get in.');
            }
            return;
          }

          // Email-link sign-in (labelled alternative, never a hidden fallback).
          const linkEmail = val('auth-email');
          if (!okEmail(linkEmail)) { showMsg('Enter your email address, then press Send link.'); if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Send link'; } return; }
          const { error } = await sb.auth.signInWithOtp({
            email: linkEmail,
            options: { emailRedirectTo: window.location.origin },
          });
          if (error) {
            // Honest, specific surfaces for the two failure modes people hit.
            const m = String((error as { message?: string }).message || error);
            if (/rate|too many|frequen/i.test(m)) throw new Error('Too many link requests right now, wait a couple of minutes and resend.');
            if (/invalid|email/i.test(m)) throw new Error(`That email address was rejected (${m}). Double-check it or try another mailbox.`);
            throw new Error(m);
          }
          // 45s resend cooldown, rapid re-sends hit Supabase's hourly cap
          // ("email ya pili ilikata kuingia").
          if (btn) {
            authKeepBtn = true;
            let left = 45;
            btn.disabled = true;
            const tick = () => {
              if (left <= 0) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Send link'; return; }
              btn.textContent = `Resend in ${left}s`;
              left -= 1;
              setTimeout(tick, 1000);
            };
            tick();
          }
        } else if (kind === 'newsletter') {
          const sbMod = await import('@/lib/supabase');
          const out = await sbMod.subscribeNewsletter(String(data.email), 'modal');
          form.closest('dialog')?.close();
          form.reset();
          window.sckToast(out.duplicate
            ? { title: 'Already on the list', body: 'This email is subscribed, no doubles, promise.' }
            : { title: 'Subscribed', body: 'You are on the list for The Ecosystem Brief. A confirmation note is on its way.' });
          return;
        } else if (instantPublish) {
          const sbMod = await import('@/lib/supabase');
          // 1) logo upload first (logos bucket is public-write), hard 15s
          //    cap so a stalled upload can never hang the whole publish.
          const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
          if (fileInput?.files?.[0] && sbMod.supabaseConfigured) {
            try {
              logoPath = await Promise.race([
                sbMod.uploadLogo(fileInput.files[0], String(data.name || 'logo'), tsToken),
                new Promise<never>((_, rej) => setTimeout(() => rej(new Error('logo-timeout')), 15000)),
              ]);
            } catch { /* non-fatal, listing works without a logo */ }
          }
          // 2) magic-link identity (optional, raises rate limit, marks signedin)
          let token: string | undefined;
          try {
            const sb = sbMod.supabase();
            const sess = sb ? await sb.auth.getSession() : null;
            token = sess?.data.session?.access_token;
          } catch { /* anon publish is supported */ }
          // 3) publish, live immediately (idempotent clientRef: retries safe)
          const out = await publishListing({
            ...data,
            clientRef: clientRefFor(form),
            turnstile: tsToken,
            logoUrl: logoPath ? sbMod.logoPublicUrl(logoPath) : undefined,
          }, token);
          showPublishSuccess(out.slug);
          window.sckToast({ title: 'Live now', body: 'Your startup page is published, grab the link below.' });
          return; // dialog stays open on the success panel
        } else {
          const sbMod = await import('@/lib/supabase');
          // logo upload if a file was picked
          const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
          if (fileInput?.files?.[0] && sbMod.supabaseConfigured) {
            try { logoPath = await sbMod.uploadLogo(fileInput.files[0], String(data.name || data.company || 'logo'), tsToken); }
            catch { /* non-fatal */ }
          }
          await sbMod.submitForm(kind as never, { ...data, logoPath }, (data.email as string) || undefined);
        }
        form.closest('dialog')?.close();
        form.reset();
        // reset dropzone labels (form.reset() doesn't fire change events)
        document.querySelectorAll<HTMLFormElement>('dialog form').forEach((f) =>
          f.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach((fi) => fi.dispatchEvent(new Event('change'))));
        const toast = window.sckToast;
        toast({
          title: KIND_TITLES[kind] ?? 'Done',
          body: kind === 'auth'
            ? 'Check your inbox (and spam/promotions) for the one-time link. It works once, within 60 minutes.'
            : logoPath
              ? 'In our review queue, logo uploaded. We read everything within a couple of days.'
              : 'In our review queue. We read everything within a couple of days.',
        });
      } catch (err) {
        const toast = window.sckToast;
        if (instantPublish) {
          // Keep the form open so the founder can fix and retry, never
          // pretend a failed publish succeeded. Inline banner + toast (iOS
          // Safari can paint toasts off-screen when the page overflows).
          const msg = String(err && (err as Error).message || err).replace(/^Error:\s*/, '') || 'Something went wrong, please try again.';
          showPublishError(msg);
        } else if (String(err).includes('offline-queued')) {
          form.closest('dialog')?.close();
          toast({ title: 'Saved on this device', body: 'You seem to be offline, your entry is stored on this phone and will send automatically next time the site loads.', kind: 'warn' });
        } else if (kind === 'auth') {
          toast({ title: 'Link not sent', body: String(err && (err as Error).message || err), kind: 'warn' });
        } else {
          toast({ title: 'Not sent', body: `${String(err && (err as Error).message || err)}, your entries are still in the form, please try again.`, kind: 'warn' });
        }
      } finally {
        // Reset for every kind on every path. Auth is exempt ONLY while the
        // email-link resend cooldown owns the button — previously any auth
        // error left the button stuck on "Sending…" until a full reload.
        if (btn && !(kind === 'auth' && authKeepBtn)) {
          btn.disabled = false;
          btn.textContent = btn.dataset.origLabel || (kind === 'auth' ? 'Sign in' : 'Send');
        }
      }
    });
  });

  // --- auth dialog: password-first, email link labelled alternative ---
  const authForm = document.getElementById('auth-form') as HTMLFormElement | null;
  const tabLink = document.getElementById('auth-tab-link');
  const tabPass = document.getElementById('auth-tab-pass');
  const panePass = document.getElementById('auth-pane-pass');
  const paneSignup = document.getElementById('auth-pane-signup');
  const paneLink = document.getElementById('auth-pane-link');
  const sendBtn = document.getElementById('auth-send-btn');

  const showAuthPane = (mode: 'pass' | 'signup' | 'link') => {
    // Hidden panes get their inputs DISABLED, not just hidden: hidden required
    // inputs pass constraint validation (the browser cannot focus them, so it
    // cancels the submit event outright — all three modes were dead). Disabled
    // inputs are skipped by validation AND excluded from FormData, which also
    // fixes the duplicate email field collision.
    const setPane = (el: HTMLElement | null, on: boolean) => {
      if (!el) return;
      el.classList.toggle('hidden', !on);
      el.querySelectorAll('input').forEach((i) => { (i as HTMLInputElement).disabled = !on; });
    };
    setPane(panePass, mode === 'pass');
    setPane(paneSignup, mode === 'signup');
    setPane(paneLink, mode === 'link');
    tabPass?.classList.toggle('bg-ink', mode === 'pass');
    tabPass?.classList.toggle('text-paper', mode === 'pass');
    tabLink?.classList.toggle('bg-ink', mode === 'link');
    tabLink?.classList.toggle('text-paper', mode === 'link');
    tabPass?.setAttribute('aria-pressed', String(mode === 'pass'));
    tabLink?.setAttribute('aria-pressed', String(mode === 'link'));
    if (authForm) authForm.dataset.authMode = mode;
    if (sendBtn) sendBtn.textContent = mode === 'link' ? 'Send link' : mode === 'signup' ? 'Create account' : 'Sign in';
  };
  showAuthPane('pass'); // arm the initial disabled state before any interaction
  tabPass?.addEventListener('click', () => showAuthPane('pass'));
  tabLink?.addEventListener('click', () => showAuthPane('link'));
  document.getElementById('auth-to-signup')?.addEventListener('click', () => showAuthPane('signup'));
  document.getElementById('auth-to-pass')?.addEventListener('click', () => showAuthPane('pass'));
  document.getElementById('auth-to-pass2')?.addEventListener('click', () => showAuthPane('pass'));

  // Show/hide password controls.
  const pwToggle = (btnId: string, inputId: string) => {
    const b = document.getElementById(btnId);
    const i = document.getElementById(inputId) as HTMLInputElement | null;
    b?.addEventListener('click', () => {
      if (!i) return;
      i.type = i.type === 'password' ? 'text' : 'password';
      b.textContent = i.type === 'password' ? 'Show' : 'Hide';
      b.setAttribute('aria-label', i.type === 'password' ? 'Show password' : 'Hide password');
      b.setAttribute('aria-pressed', String(i.type !== 'password'));
    });
  };
  pwToggle('auth-pw-toggle', 'auth-pass-pw');
  pwToggle('auth-su-pw-toggle', 'auth-su-pw');

  // Forgot password → documented recovery email, generic confirmation either
  // way (never reveals whether a particular address has an account).
  document.getElementById('auth-forgot')?.addEventListener('click', async () => {
    const emailEl = document.getElementById('auth-pass-email') as HTMLInputElement | null;
    const msg = document.getElementById('auth-pass-msg');
    const email = String(emailEl?.value || '').trim();
    if (!msg) return;
    if (!email) {
      msg.textContent = 'Type your email above first, then press "Forgot password?" again.';
      msg.classList.remove('hidden');
      emailEl?.focus();
      return;
    }
    try {
      const sbMod = await import('@/lib/supabase');
      const sb = sbMod.supabase();
      if (!sb) throw new Error('not configured');
      const { error } = await sb.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/auth/reset`,
      });
      msg.textContent = error
        ? `Could not send the reset email (${error.message}). Try again in a minute.`
        : 'If that address has an account, a password-reset link is on its way. It opens a page where you set the new password.';
      msg.classList.remove('hidden');
    } catch (err) {
      msg.textContent = `Could not send the reset email (${String((err as Error).message || err)}).`;
      msg.classList.remove('hidden');
    }
  });

  const authTabs = document.getElementById('auth-tabs');
  const signedPanel = document.getElementById('auth-signedin');
  const syncAuthPanel = async () => {
    try {
      const sbMod = await import('@/lib/supabase');
      const sb = sbMod.supabase();
      if (!sb) return;
      const { data } = await sb.auth.getSession();
      const email = data.session?.user?.email;
      if (email) {
        signedPanel?.classList.remove('hidden');
        authTabs?.classList.add('hidden');
        authForm?.classList.add('hidden');
        const who = document.getElementById('auth-who');
        if (who) who.textContent = email;
        void loadMyListings();
      } else {
        signedPanel?.classList.add('hidden');
        authTabs?.classList.remove('hidden');
        authForm?.classList.remove('hidden');
      }
    } catch { /* not configured: keep the form visible */ }
  };
  window.addEventListener('sck:auth-opened', syncAuthPanel);

  document.getElementById('auth-signout')?.addEventListener('click', async () => {
    try {
      const sbMod = await import('@/lib/supabase');
      const sb = sbMod.supabase();
      await sb?.auth.signOut();
    } catch { /* already out */ }
    // Flag the device signed out + flip the chip immediately (the idle check
    // that owns this state may never run again on this device).
    try {
      localStorage.setItem('sck-auth-none', '1');
      window.dispatchEvent(new CustomEvent('sck:auth-changed', { detail: { email: null } }));
    } catch { /* storage blocked */ }
    (document.getElementById('modal-auth') as HTMLDialogElement | null)?.close();
    window.sckToast({ title: 'Signed out', body: 'See you soon.' });
  });

  document.getElementById('auth-setpw')?.addEventListener('click', async () => {
    const p1 = (document.getElementById('auth-newpw') as HTMLInputElement | null)?.value || '';
    const p2 = (document.getElementById('auth-newpw2') as HTMLInputElement | null)?.value || '';
    const msg = document.getElementById('auth-setpw-msg');
    if (!msg) return;
    if (p1.length < 8) { msg.textContent = 'Use at least 8 characters.'; return; }
    if (p1 !== p2) { msg.textContent = 'The two passwords do not match.'; return; }
    msg.textContent = 'Saving…';
    try {
      const sbMod = await import('@/lib/supabase');
      const sb = sbMod.supabase();
      if (!sb) throw new Error('not configured');
      const { error } = await sb.auth.updateUser({ password: p1 });
      if (error) { msg.textContent = `Could not save (${error.message}). Try again.`; return; }
      msg.textContent = 'Password saved. Next time, use the Password tab to sign in.';
      const a = document.getElementById('auth-newpw') as HTMLInputElement | null;
      const b = document.getElementById('auth-newpw2') as HTMLInputElement | null;
      if (a) a.value = '';
      if (b) b.value = '';
    } catch (err) {
      msg.textContent = `Could not save (${String((err as Error).message || err)}). Try again.`;
    }
  });

  // --- Your listings: a signed-in founder edits their OWN listing ---
  // Replaces the old "email the desk to change anything" dead end. The Worker
  // only ever returns / accepts rows whose data->>userId is this session's id,
  // so there is nothing to guard client-side beyond sending the bearer token.
  type MyListing = {
    slug: string; name: string; tagline: string; website: string; sector: string; stage: string;
    county: string; description: string; founderName: string; email: string; logoUrl: string | null;
    status: string; createdAt: string | null; url: string;
  };
  let myListings: MyListing[] = [];
  const myListMsg = document.getElementById('my-listings-msg');
  const myListUl = document.getElementById('my-listings');

  async function sessionToken(): Promise<string | undefined> {
    try {
      const sbMod = await import('@/lib/supabase');
      const sb = sbMod.supabase();
      const sess = sb ? await sb.auth.getSession() : null;
      return sess?.data.session?.access_token;
    } catch { return undefined; }
  }

  async function loadMyListings() {
    if (!myListMsg || !myListUl) return;
    myListMsg.classList.remove('hidden');
    myListMsg.textContent = 'Loading your listings…';
    myListUl.replaceChildren();
    const token = await sessionToken();
    if (!token) { myListMsg.textContent = 'Sign in to manage your listings.'; return; }
    try {
      const res = await fetch('/api/my-listings', { headers: { Authorization: `Bearer ${token}` } });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.ok) throw new Error(out.error || `HTTP ${res.status}`);
      myListings = Array.isArray(out.listings) ? out.listings : [];
      renderMyListings();
    } catch (err) {
      myListMsg.textContent = `Could not load your listings (${String((err as Error).message || err)}).`;
    }
  }

  function renderMyListings() {
    if (!myListMsg || !myListUl) return;
    myListUl.replaceChildren();
    if (!myListings.length) {
      myListMsg.classList.remove('hidden');
      myListMsg.textContent = 'No listings under this account yet. Publish one and it appears here to edit.';
      return;
    }
    myListMsg.classList.add('hidden');
    for (const l of myListings) {
      const li = document.createElement('li');
      li.className = 'flex items-center justify-between gap-2 border border-line bg-paper2 px-3 py-2';
      const info = document.createElement('div');
      info.className = 'min-w-0';
      const name = document.createElement('p');
      name.className = 'truncate text-[13.5px] text-ink';
      name.textContent = l.name;
      const meta = document.createElement('p');
      meta.className = 'truncate font-mono text-[10.5px] uppercase tracking-[0.1em] text-mut';
      meta.textContent = `${l.status === 'published' ? 'Live' : 'Hidden'} · /${l.slug}`;
      info.append(name, meta);
      const actions = document.createElement('div');
      actions.className = 'flex shrink-0 items-center gap-2';
      const view = document.createElement('a');
      view.className = 'text-[12.5px] text-mut underline hover:text-ink';
      view.href = l.url; view.target = '_blank'; view.rel = 'noopener'; view.textContent = 'View';
      const edit = document.createElement('button');
      edit.type = 'button';
      edit.className = 'btn btn-amber h-8 px-3 text-[12.5px]';
      edit.textContent = 'Edit';
      edit.addEventListener('click', () => openEditListing(l));
      actions.append(view, edit);
      li.append(info, actions);
      myListUl.append(li);
    }
  }

  function openEditListing(l: MyListing) {
    const set = (id: string, v: string) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
      if (el) el.value = v;
    };
    set('el-slug', l.slug);
    set('el-name', l.name || '');
    set('el-email', l.email || '');
    set('el-website', l.website || '');
    set('el-county', l.county || 'Nairobi');
    set('el-sector', l.sector || 'Other');
    set('el-stage', l.stage || 'Pre-seed');
    set('el-tagline', l.tagline || '');
    set('el-description', l.description || '');
    set('el-founder', l.founderName || '');
    const logo = document.getElementById('el-logo') as HTMLInputElement | null;
    if (logo) logo.value = '';
    const msg = document.getElementById('edit-listing-msg');
    if (msg) { msg.classList.add('hidden'); msg.textContent = ''; }
    const toggle = document.getElementById('el-status-toggle');
    if (toggle) toggle.textContent = l.status === 'published' ? 'Hide from the index' : 'Republish this listing';
    (document.getElementById('modal-edit-listing') as HTMLDialogElement | null)?.showModal();
  }

  const editForm = document.getElementById('edit-listing-form') as HTMLFormElement | null;
  const editVal = (id: string) => String((document.getElementById(id) as HTMLInputElement | null)?.value || '').trim();

  async function postListingUpdate(payload: Record<string, unknown>, token: string) {
    const res = await fetch('/api/listing-update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify(payload),
      signal: AbortSignal.timeout(20000),
    });
    const out = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; errors?: Record<string, string> };
    if (!res.ok || !out.ok) {
      const errs = out.errors ? Object.entries(out.errors).map(([k, v]) => `${k}: ${v}`).join(' · ') : '';
      throw new Error(errs || out.error || `HTTP ${res.status}`);
    }
    return out;
  }

  editForm?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const msg = document.getElementById('edit-listing-msg');
    const btn = editForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const slug = editVal('el-slug');
    if (!msg || !slug) return;
    if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }
    const show = (t: string, cls: string) => { msg.className = `mt-3 text-[12.5px] leading-relaxed ${cls}`; msg.textContent = t; };
    try {
      const token = await sessionToken();
      if (!token) throw new Error('Your session expired, sign out and back in, then try again.');
      const sbMod = await import('@/lib/supabase');
      const body: Record<string, unknown> = {
        slug,
        name: editVal('el-name'),
        email: editVal('el-email'),
        website: editVal('el-website'),
        county: editVal('el-county'),
        sector: editVal('el-sector'),
        stage: editVal('el-stage'),
        tagline: editVal('el-tagline'),
        description: editVal('el-description'),
        founderName: editVal('el-founder'),
      };
      const fileInput = document.getElementById('el-logo') as HTMLInputElement | null;
      if (fileInput?.files?.[0] && sbMod.supabaseConfigured) {
        const path = await sbMod.uploadLogo(fileInput.files[0], String(body.name || 'logo'));
        body.logoUrl = sbMod.logoPublicUrl(path);
      }
      await postListingUpdate(body, token);
      show('Saved, your page is updated:', 'text-green');
      const link = document.createElement('a');
      link.href = `https://startups.co.ke/startups/community/${slug}`;
      link.target = '_blank'; link.rel = 'noopener';
      link.className = 'text-amber underline';
      link.textContent = `startups.co.ke/startups/community/${slug}`;
      msg.append(' ', link);
      window.sckToast({ title: 'Listing updated', body: 'Your changes are live.' });
      void loadMyListings();
    } catch (err) {
      show(String((err as Error).message || err), 'text-clay');
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = 'Save changes'; }
    }
  });

  document.getElementById('el-status-toggle')?.addEventListener('click', async () => {
    const msg = document.getElementById('edit-listing-msg');
    const slug = editVal('el-slug');
    const current = myListings.find((l) => l.slug === slug);
    if (!msg || !slug || !current) return;
    const action = current.status === 'published' ? 'unlist' : 'republish';
    msg.className = 'mt-3 text-[12.5px] leading-relaxed text-mut';
    msg.textContent = 'Updating…';
    try {
      const token = await sessionToken();
      if (!token) throw new Error('Your session expired, sign out and back in, then try again.');
      await postListingUpdate({ slug, action }, token);
      current.status = action === 'unlist' ? 'unlisted' : 'published';
      const toggle = document.getElementById('el-status-toggle');
      if (toggle) toggle.textContent = action === 'unlist' ? 'Republish this listing' : 'Hide from the index';
      msg.className = 'mt-3 text-[12.5px] leading-relaxed text-green';
      msg.textContent = action === 'unlist'
        ? 'Hidden from the public index. Its page now returns 404 until you republish.'
        : 'Republished, it is live again.';
      window.sckToast({ title: action === 'unlist' ? 'Listing hidden' : 'Listing republished', body: 'You can change this anytime.' });
      void loadMyListings();
    } catch (err) {
      msg.className = 'mt-3 text-[12.5px] leading-relaxed text-clay';
      msg.textContent = String((err as Error).message || err);
    }
  });
</script>
