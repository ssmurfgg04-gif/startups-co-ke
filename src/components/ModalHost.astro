---
/**
 * MODAL HOST — every modal in the spec as native <dialog> (accessible:
 * Esc + backdrop + close button). Forms post to Supabase `submissions`
 * (kind + payload), falling back to local storage + honest toasts.
 */
import { SITE } from '@/config/site';
import { supabaseConfigured } from '@/lib/supabase';
const email = SITE.contact.email;
---
<!-- ABOUT / THINGS TO TRY -->
<dialog id="modal-about" class="dialog-card" aria-labelledby="about-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="about-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">About this platform</p></div>
  <div class="max-h-[70vh] overflow-y-auto px-5 py-4 text-[14px] leading-relaxed">
    <p>startups.co.ke is an ecosystem and business-intelligence platform for Kenya's startup economy. <strong>Data is real and compiled from public sources</strong> — every figure carries a status (Confirmed / Reported / Estimated) and a named source; Verified means cross-checked against at least two independent public sources.</p>
    <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.12em] text-mut">Things to try</p>
    <ul class="mt-2 space-y-1.5">
      <li>· Press <kbd class="border border-line px-1 font-mono text-[11px]">/</kbd> and search “pesa”</li>
      <li>· Click the map hubs to filter the directory</li>
      <li>· Filter the company index (sector, stage, verified)</li>
      <li>· Expand job rows and bookmark a role</li>
      <li>· Switch the funding chart between sectors</li>
      <li>· Watch the featured hackathon countdown tick</li>
      <li>· Submit your startup (stored in Supabase{supabaseConfigured ? '' : ' once connected'})</li>
    </ul>
    <p class="mt-3 text-mut">Contact: <a class="text-amber underline" href={`mailto:${email}`}>{email}</a> · {SITE.contact.phoneDisplay}</p>
  </div>
  <div class="flex justify-end border-t border-ink px-5 py-3"><button class="btn btn-ghost h-9" data-close>Close</button></div>
</dialog>

<!-- METHODOLOGY -->
<dialog id="modal-methodology" class="dialog-card" aria-labelledby="meth-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="meth-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Methodology &amp; statuses</p></div>
  <div class="max-h-[70vh] overflow-y-auto space-y-3 px-5 py-4 text-[14px] leading-relaxed">
    <p><strong>Verified company</strong> — cross-checked against ≥2 independent public sources as of Oct 15, 2026 (press, registries, investor announcements).</p>
    <p><strong>Unverified</strong> — self-reported profile pending checks. Shown with a dashed chip.</p>
    <p><strong>Confirmed</strong> — round confirmed by a company statement or lead-investor memo.</p>
    <p><strong>Reported</strong> — credible secondary source; awaiting confirmation.</p>
    <p><strong>Estimated</strong> — modelled from registry filings or comparable data.</p>
    <p class="text-mut">Failure states are tracked like funding states — administration, liquidation, shutdown and restructuring are visible on profiles, not hidden. Spotted an error? Use “Report data issue” on any profile.</p>
  </div>
  <div class="flex justify-end border-t border-ink px-5 py-3"><button class="btn btn-ghost h-9" data-close>Close</button></div>
</dialog>

<!-- AUTH (magic link) -->
<dialog id="modal-auth" class="dialog-card" aria-labelledby="auth-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="auth-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Sign in — magic link</p></div>
  <form id="auth-form" class="px-5 py-4" data-kind="auth">
    <p class="text-[14px] text-mut">We email you a one-time sign-in link. Powered by Supabase Auth{supabaseConfigured ? '' : ' — not connected in this preview'}.</p>
    <label class="mono-label mt-4 block" for="auth-email">Email</label>
    <input id="auth-email" name="email" type="email" required class="input mt-1.5" placeholder="you@startup.co.ke" />
    <p class="mono-label mt-3">Your data: submissions table, RLS-protected. See <a class="text-amber underline" href="/privacy">privacy policy</a>.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Send link</button>
    </div>
  </form>
</dialog>

<!-- SUBMIT / CLAIM STARTUP (shared form) -->
<dialog id="modal-submit" class="dialog-card" aria-labelledby="submit-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="submit-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Submit your startup</p></div>
  <form class="max-h-[70vh] overflow-y-auto px-5 py-4" data-kind="startup">
    <div class="grid gap-3 sm:grid-cols-2">
      <div><label class="mono-label block" for="su-name">Company name *</label><input id="su-name" name="name" required class="input mt-1" /></div>
      <div><label class="mono-label block" for="su-email">Contact email *</label><input id="su-email" name="email" type="email" required class="input mt-1" /></div>
      <div><label class="mono-label block" for="su-sector">Sector</label>
        <select id="su-sector" name="sector" class="input mt-1"><option>Fintech</option><option>Commerce</option><option>Logistics</option><option>Agritech</option><option>Energy</option><option>Health</option><option>Edtech</option><option>Proptech</option><option>SaaS</option><option>HR &amp; Future of Work</option><option>Media</option></select>
      </div>
      <div><label class="mono-label block" for="su-stage">Stage</label>
        <select id="su-stage" name="stage" class="input mt-1"><option>Pre-seed</option><option>Seed</option><option>Series A</option><option>Series B</option></select>
      </div>
      <div class="sm:col-span-2"><label class="mono-label block" for="su-tag">One-liner *</label><input id="su-tag" name="tagline" required class="input mt-1" placeholder="What you do, in one line" /></div>
      <div class="sm:col-span-2"><label class="mono-label block" for="su-logo">Logo (optional — we keep it on your profile)</label><input id="su-logo" name="logo" type="file" accept="image/*" class="input-mono input mt-1 pt-2" /></div>
    </div>
    <p class="mono-label mt-3">Submissions land in our review queue — nothing is published automatically. Logos are kept on your profile once approved.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Submit for review</button>
    </div>
  </form>
</dialog>

<!-- CLAIM PROFILE -->
<dialog id="modal-claim" class="dialog-card" aria-labelledby="claim-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="claim-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Claim this profile</p></div>
  <form class="px-5 py-4" data-kind="claim">
    <label class="mono-label block" for="cl-name">Your name *</label><input id="cl-name" name="name" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="cl-email">Work email *</label><input id="cl-email" name="email" type="email" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="cl-logo">Company logo (optional)</label><input id="cl-logo" name="logo" type="file" accept="image/*" class="input-mono input mt-1 pt-2" />
    <p class="mono-label mt-3">Verification: registry extract + team confirmation call. Your logo uploads to our secure storage and appears once the claim is approved.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Request claim</button>
    </div>
  </form>
</dialog>

<!-- POST A JOB -->
<dialog id="modal-postjob" class="dialog-card" aria-labelledby="postjob-heading">
  <div class="border-b border-ink px-5 py-3.5"><p id="postjob-heading" class="font-mono text-[11px] uppercase tracking-[0.14em]">Post a job</p></div>
  <form class="px-5 py-4" data-kind="job">
    <div class="grid gap-3 sm:grid-cols-2">
      <div><label class="mono-label block" for="pj-co">Company *</label><input id="pj-co" name="company" required class="input mt-1" /></div>
      <div><label class="mono-label block" for="pj-title">Role title *</label><input id="pj-title" name="title" required class="input mt-1" /></div>
      <div><label class="mono-label block" for="pj-email">Email *</label><input id="pj-email" name="email" type="email" required class="input mt-1" /></div>
      <div><label class="mono-label block" for="pj-tier">Package</label>
        <select id="pj-tier" name="tier" class="input-mono input mt-1">
          {SITE.jobPostPricing.map((p) => <option value={p.tier}>{p.tier} — {p.price}</option>)}
        </select>
      </div>
    </div>
    <p class="mono-label mt-3">Launch pricing — Featured KSh 25,000 · Standard KSh 12,000 · Internship KSh 6,000</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Post it</button>
    </div>
  </form>
</dialog>

<!-- LIST EVENT -->
<dialog id="modal-listevent" class="dialog-card" aria-labelledby="le-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="le-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">List a hackathon — free</p></div>
  <form class="px-5 py-4" data-kind="event">
    <label class="mono-label block" for="le-name">Event name *</label><input id="le-name" name="name" required class="input mt-1" />
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <div><label class="mono-label block" for="le-city">City</label><input id="le-city" name="city" class="input mt-1" placeholder="Nairobi" /></div>
      <div><label class="mono-label block" for="le-date">Date</label><input id="le-date" name="date" type="date" class="input-mono input mt-1" /></div>
    </div>
    <label class="mono-label mt-3 block" for="le-email">Email *</label><input id="le-email" name="email" type="email" required class="input mt-1" />
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Submit event</button>
    </div>
  </form>
</dialog>

<!-- REQUEST INTRODUCTION -->
<dialog id="modal-intro" class="dialog-card" aria-labelledby="intro-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="intro-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Request introduction — vetted service</p></div>
  <form class="px-5 py-4" data-kind="intro">
    <p class="text-[14px] text-mut">Intros are a paid, vetted service (Professional plan includes 2/month). We confirm fit before any intro is made.</p>
    <label class="mono-label mt-3 block" for="in-email">Work email *</label><input id="in-email" name="email" type="email" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="in-note">Why this fund/company *</label><textarea id="in-note" name="note" required rows="3" class="input mt-1"></textarea>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Request intro</button>
    </div>
  </form>
</dialog>

<!-- HACKATHON REGISTRATION -->
<dialog id="modal-register" class="dialog-card" aria-labelledby="reg-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="reg-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Register your team</p></div>
  <form class="px-5 py-4" data-kind="register">
    <label class="mono-label block" for="rg-team">Team name *</label><input id="rg-team" name="team" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="rg-email">Email *</label><input id="rg-email" name="email" type="email" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="rg-size">Team size (2–5)</label><input id="rg-size" name="size" type="number" min="2" max="5" class="input-mono input mt-1" />
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Register</button>
    </div>
  </form>
</dialog>

<!-- JOB APPLICATION -->
<dialog id="modal-apply" class="dialog-card" aria-labelledby="ap-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="ap-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Apply now</p></div>
  <form class="px-5 py-4" data-kind="apply">
    <label class="mono-label block" for="ap-name">Full name *</label><input id="ap-name" name="name" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="ap-email">Email *</label><input id="ap-email" name="email" type="email" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="ap-link">LinkedIn / portfolio</label><input id="ap-link" name="link" class="input mt-1" placeholder="https://" />
    <p class="mono-label mt-3">Your application goes to the employer via the listing’s board.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Send application</button>
    </div>
  </form>
</dialog>

<!-- REPORT DATA ISSUE -->
<dialog id="modal-report" class="dialog-card" aria-labelledby="rp-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="rp-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Report a data issue</p></div>
  <form class="px-5 py-4" data-kind="issue">
    <label class="mono-label block" for="rp-note">What's wrong? *</label><textarea id="rp-note" name="note" required rows="3" class="input mt-1"></textarea>
    <label class="mono-label mt-3 block" for="rp-email">Email (optional)</label><input id="rp-email" name="email" type="email" class="input mt-1" />
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Send report</button>
    </div>
  </form>
</dialog>

<!-- TRIAL / BUY / SPONSOR (email-capture style) -->
<dialog id="modal-trial" class="dialog-card" aria-labelledby="tr-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="tr-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Start 14-day trial — Professional</p></div>
  <form class="px-5 py-4" data-kind="trial">
    <label class="mono-label block" for="tr-email">Work email *</label><input id="tr-email" name="email" type="email" required class="input mt-1" />
    <p class="mono-label mt-3">KSh 2,900/mo after trial · invoice or M-PESA · cancel anytime.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Start trial</button>
    </div>
  </form>
</dialog>

<dialog id="modal-buy" class="dialog-card" aria-labelledby="buy-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="buy-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Unlock report</p></div>
  <form class="px-5 py-4" data-kind="buy">
    <label class="mono-label block" for="buy-email">Email *</label><input id="buy-email" name="email" type="email" required class="input mt-1" />
    <p class="mono-label mt-3">We send payment details, then the PDF + data appendix.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Continue</button>
    </div>
  </form>
</dialog>

<dialog id="modal-sponsor" class="dialog-card" aria-labelledby="sp-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="sp-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Become a sponsor / talk to us</p></div>
  <form class="px-5 py-4" data-kind="sponsor">
    <label class="mono-label block" for="sp-name">Name / company *</label><input id="sp-name" name="name" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="sp-email">Email *</label><input id="sp-email" name="email" type="email" required class="input mt-1" />
    <p class="mono-label mt-3">Or reach us directly at <a class="text-amber underline" href={`mailto:${email}`}>{email}</a> · {SITE.contact.phoneDisplay}</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Send</button>
    </div>
  </form>
</dialog>

<!-- NEWSLETTER -->
<dialog id="modal-newsletter" class="dialog-card" aria-labelledby="nl-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="nl-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">The Ecosystem Brief</p></div>
  <form class="px-5 py-4" data-kind="newsletter">
    <p class="text-[14px] text-mut">Every Monday, 06:30 EAT. What moved, what funded, what shipped.</p>
    <label class="mono-label mt-3 block" for="nl-email">Email *</label><input id="nl-email" name="email" type="email" required class="input mt-1" />
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Subscribe</button>
    </div>
  </form>
</dialog>

<script>
  // --- open/close plumbing ---
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const opener = t.closest('[data-modal]') as HTMLElement | null;
    if (opener) {
      const dlg = document.getElementById(`modal-${opener.dataset.modal}`) as HTMLDialogElement | null;
      if (dlg) {
        if (!dlg.open) dlg.showModal();
        return;
      }
    }
    if (t.closest('[data-close]')) {
      const dlg = t.closest('dialog');
      dlg?.close();
    }
  });
  document.querySelectorAll('dialog.dialog-card').forEach((dlg) => {
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close(); // backdrop click
    });
  });

  // --- form plumbing (Supabase with local fallback) ---
  const KIND_TITLES: Record<string, string> = {
    startup: 'Submission received',
    claim: 'Claim request received',
    job: 'Job posting received',
    event: 'Event submitted',
    intro: 'Introduction requested',
    register: 'Team registered',
    apply: 'Application sent',
    issue: 'Report received',
    trial: 'Trial started',
    buy: 'Unlock request received',
    sponsor: 'Message sent',
    newsletter: 'Subscribed',
    auth: 'Magic link sent',
  };

  document.querySelectorAll<HTMLFormElement>('dialog form[data-kind]').forEach((form) => {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const kind = form.dataset.kind!;
      const data = Object.fromEntries(new FormData(form).entries());
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      let logoPath: string | undefined;
      try {
        if (kind === 'auth') {
          const sbMod = await import('@/lib/supabase');
          const sb = sbMod.supabase();
          if (!sb) throw new Error('not-configured');
          const { error } = await sb.auth.signInWithOtp({
            email: String(data.email),
            options: { emailRedirectTo: window.location.origin },
          });
          if (error) throw error;
        } else if (kind === 'newsletter') {
          const sbMod = await import('@/lib/supabase');
          await sbMod.subscribeNewsletter(String(data.email), 'modal');
        } else {
          const sbMod = await import('@/lib/supabase');
          // logo upload if a file was picked
          const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
          if (fileInput?.files?.[0] && sbMod.supabaseConfigured) {
            try { logoPath = await sbMod.uploadLogo(fileInput.files[0], String(data.name || data.company || 'logo')); }
            catch { /* non-fatal */ }
          }
          await sbMod.submitForm(kind as never, { ...data, logoPath }, (data.email as string) || undefined);
        }
        form.closest('dialog')?.close();
        form.reset();
        const toast = (window as unknown as { sckToast: (t: { title: string; body?: string }) => void }).sckToast;
        toast({
          title: KIND_TITLES[kind] ?? 'Done',
          body: kind === 'auth'
            ? 'Check your inbox for the one-time link.'
            : logoPath
              ? 'Recorded in our review queue — logo uploaded.'
              : 'Recorded in our review queue.',
        });
      } catch (err) {
        const toast = (window as unknown as { sckToast: (t: { title: string; body?: string }) => void }).sckToast;
        if (String(err).includes('not-configured') || kind !== 'auth') {
          form.closest('dialog')?.close();
          toast({ title: 'Saved locally', body: 'Supabase is not connected in this environment — your entry is queued on this device.', kind: 'warn' });
        } else {
          toast({ title: 'Something went wrong', body: 'Please try again or email us.', kind: 'warn' });
        }
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = kind === 'auth' ? 'Send link' : 'Send'; }
      }
    });
  });
</script>
