---
/**
 * MODAL HOST — every modal in the spec as native <dialog> (accessible:
 * Esc + backdrop + close button). Forms post to Supabase `submissions`
 * (kind + payload), falling back to local storage + honest toasts.
 */
import { SITE } from '@/config/site';
import { supabaseConfigured } from '@/lib/supabase';
import { COUNTIES } from '@/data/counties';
const countyNames = ['Nairobi', ...COUNTIES.map((c) => c.name).filter((n) => n !== 'Nairobi').sort()];
---
<!-- AUTH (magic link) -->
<dialog id="modal-auth" class="dialog-card" aria-labelledby="auth-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="auth-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Sign in — magic link</p></div>
  <form id="auth-form" class="px-5 py-4" data-kind="auth">
    <p class="text-[14px] text-mut">We email you a one-time sign-in link. Powered by Supabase Auth{supabaseConfigured ? '' : ' — not connected in this preview'}.</p>
    <label class="mono-label mt-4 block" for="auth-email">Email</label>
    <input id="auth-email" name="email" type="email" required class="input mt-1.5" placeholder="you@startup.co.ke" />
    <p class="mono-label mt-3">Your data: submissions table, RLS-protected. See <a class="text-amber underline" href="/privacy">privacy policy</a>.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Send link</button>
    </div>
  </form>
</dialog>

<!-- SUBMIT / CLAIM STARTUP (shared form) -->
<dialog id="modal-submit" class="dialog-card" aria-labelledby="submit-title">
  <div class="flex items-center justify-between border-b border-ink px-5 py-3.5">
    <p id="submit-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">List your startup — live instantly</p>
    <button class="btn btn-ghost h-8 w-8 border border-ink !px-0" data-close aria-label="Close">✕</button>
  </div>
  <form class="max-h-[70vh] overflow-y-auto px-5 py-4" data-kind="startup" data-mode="instant" novalidate>
    <div class="grid gap-3 sm:grid-cols-2">
      <div><label class="mono-label block" for="su-name">Company name *</label><input id="su-name" name="name" required class="input mt-1" placeholder="Acme Robotics" /></div>
      <div><label class="mono-label block" for="su-email">Contact email *</label><input id="su-email" name="email" type="email" required class="input mt-1" placeholder="founder@acme.co.ke" /></div>
      <div><label class="mono-label block" for="su-web">Website or app link *</label><input id="su-web" name="website" type="url" required class="input mt-1" placeholder="https://" /></div>
      <div><label class="mono-label block" for="su-county">County</label>
        <select id="su-county" name="county" class="input input-mono mt-1">
          {countyNames.map((n) => <option value={n} selected={n === 'Nairobi'}>{n}</option>)}
        </select>
      </div>
      <div><label class="mono-label block" for="su-sector">Sector</label>
        <select id="su-sector" name="sector" class="input input-mono mt-1"><option>Fintech</option><option>Commerce</option><option>Logistics</option><option>Agritech</option><option>Energy</option><option>Health</option><option>Edtech</option><option>Proptech</option><option>SaaS</option><option>HR &amp; Future of Work</option><option>Media</option><option>Climate &amp; Energy</option><option>Other</option></select>
      </div>
      <div><label class="mono-label block" for="su-stage">Stage</label>
        <select id="su-stage" name="stage" class="input input-mono mt-1"><option>Pre-seed</option><option>Seed</option><option>Series A</option><option>Series B</option><option>Growth</option></select>
      </div>
      <div class="sm:col-span-2"><label class="mono-label block" for="su-tag">One-liner *</label><input id="su-tag" name="tagline" required class="input mt-1" placeholder="What you do, in one crisp sentence" /></div>
      <div class="sm:col-span-2"><label class="mono-label block" for="su-desc">About (optional)</label><textarea id="su-desc" name="description" rows="3" class="input mt-1" placeholder="What you're building, who it's for, traction you can name — your page reads exactly what you write here"></textarea></div>
      <div class="sm:col-span-2"><label class="mono-label block" for="su-founder">Founder / contact name (optional)</label><input id="su-founder" name="founderName" class="input mt-1" placeholder="Shown as “Founder: …” on your page" /></div>
      <div class="sm:col-span-2">
        <label class="mono-label block" for="su-logo">Company logo — optional</label>
        <div class="mt-1" data-dropzone>
          <input id="su-logo" name="logo" type="file" accept="image/png, image/jpeg, image/svg+xml" class="sr-only" />
          <label for="su-logo" class="flex cursor-pointer items-center justify-center gap-2 border-2 border-dashed border-line2 bg-paper2 px-4 py-5 text-center text-[13px] text-mut transition-colors hover:border-ink hover:text-ink">
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 16V4m0 0 4 4m-4-4L8 8"></path><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path></svg>
            <span data-dropzone-label>Drag &amp; drop your logo here, or browse — PNG, JPG or SVG</span>
          </label>
        </div>
      </div>
    </div>
    <!-- Honeypot: hidden from humans ( bots autofill it ) -->
    <div class="hidden" aria-hidden="true">
      <label for="su-company-url">Company URL</label>
      <input id="su-company-url" name="company_url" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <p class="mt-3 flex items-start gap-1.5 text-[12.5px] leading-relaxed text-mut">
      <svg class="mt-0.5 h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01M12 11v5"></path></svg>
      <span><strong class="text-ink">No waiting, no approval.</strong> Your profile goes live the moment you publish — your own page at startups.co.ke/startups/community/your-name, linked to your site. Listings carry a “Founder-submitted” tag until we verify them against public sources.</span>
    </p>
    <div id="publish-success" class="mt-4 hidden border border-green bg-green/5 px-4 py-4">
      <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-green">✓ Your startup is live</p>
      <p class="mt-1.5 text-[14px] text-ink2">It's published — here's your page:</p>
      <p class="mt-1.5 break-all font-mono text-[12.5px] text-ink" data-live-url></p>
      <div class="mt-3 flex flex-wrap gap-2">
        <a class="btn btn-amber h-9 px-4" data-open-live href="/startups/community" target="_blank" rel="noopener">Open my profile →</a>
        <button type="button" class="btn btn-ghost h-9 px-4" data-copy-live>Copy link</button>
        <button type="button" class="btn btn-ghost h-9 px-4" data-list-another>List another</button>
      </div>
    </div>
    <div data-publish-actions class="mt-4 flex items-center justify-end gap-5">
      <button type="button" class="text-[13px] text-mut underline hover:text-ink" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-10 px-5">Publish now — live immediately →</button>
    </div>
    <p class="mt-2 text-right text-[12px] text-mut">
      Prefer a human check first?
      <button type="button" class="underline hover:text-ink" data-toggle-mode data-alt="Publish instantly instead">Submit for review instead</button>
    </p>
  </form>
</dialog>

<!-- CLAIM PROFILE -->
<dialog id="modal-claim" class="dialog-card" aria-labelledby="claim-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="claim-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Claim this profile</p></div>
  <form class="px-5 py-4" data-kind="claim">
    <label class="mono-label block" for="cl-name">Your name *</label><input id="cl-name" name="name" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="cl-email">Work email *</label><input id="cl-email" name="email" type="email" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="cl-logo">Company logo (optional)</label><input id="cl-logo" name="logo" type="file" accept="image/*" class="input-mono input mt-1 pt-2" />
    <p class="mono-label mt-3">Verification: registry extract + team confirmation call. Your logo uploads to our secure storage and appears once the claim is approved.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Request claim</button>
    </div>
  </form>
</dialog>

<!-- POST A JOB -->
<dialog id="modal-postjob" class="dialog-card" aria-labelledby="postjob-heading">
  <div class="flex items-center justify-between border-b border-ink px-5 py-3.5">
    <p id="postjob-heading" class="font-mono text-[11px] uppercase tracking-[0.14em]">Post a job</p>
    <button class="btn btn-ghost h-8 w-8 border border-ink !px-0" data-close aria-label="Close">✕</button>
  </div>
  <form class="max-h-[70vh] overflow-y-auto px-5 py-4" data-kind="job">
    <div class="grid gap-3 sm:grid-cols-2">
      <div><label class="mono-label block" for="pj-co">Company *</label><input id="pj-co" name="company" required class="input mt-1" placeholder="Acme Robotics" /></div>
      <div><label class="mono-label block" for="pj-title">Role title *</label><input id="pj-title" name="title" required class="input mt-1" placeholder="e.g. Backend Engineer" /></div>
      <div><label class="mono-label block" for="pj-loc">Location</label><input id="pj-loc" name="location" class="input mt-1" placeholder="Nairobi" /></div>
      <div><label class="mono-label block" for="pj-type">Employment type</label>
        <select id="pj-type" name="type" class="input input-mono mt-1">
          <option>Full-time</option><option>Part-time</option><option>Contract</option><option>Internship</option><option>Freelance</option>
        </select>
      </div>
      <div><label class="mono-label block" for="pj-email">Your email *</label><input id="pj-email" name="email" type="email" required class="input mt-1" placeholder="jobs@yourco.co.ke" /></div>
      <div><label class="mono-label block" for="pj-tier">Package</label>
        <select id="pj-tier" name="tier" class="input input-mono mt-1">
          {SITE.jobPostPricing.map((p) => <option value={p.tier}>{p.tier} — {p.price}</option>)}
        </select>
      </div>
    </div>

    <fieldset class="mt-4 border border-line p-3">
      <legend class="mono-label px-1">Pay — optional, but it doubles replies</legend>
      <div class="grid gap-3 sm:grid-cols-3">
        <div><label class="mono-label block" for="pj-pay">Disclosure</label>
          <select id="pj-pay" name="pay" class="input input-mono mt-1">
            <option value="Not disclosed">Not disclosed</option>
            <option value="Negotiable">Negotiable</option>
            <option value="Range">Range — KES / month</option>
          </select>
        </div>
        <div id="pj-range-wrap" class="hidden items-end gap-2 sm:flex">
          <div class="flex-1"><label class="mono-label block" for="pj-min">Min (KSh)</label><input id="pj-min" name="payMin" type="number" min="0" step="1000" class="input input-mono mt-1" placeholder="80,000" /></div>
          <div class="flex-1"><label class="mono-label block" for="pj-max">Max (KSh)</label><input id="pj-max" name="payMax" type="number" min="0" step="1000" class="input input-mono mt-1" placeholder="120,000" /></div>
        </div>
      </div>
    </fieldset>

    <div class="mt-4 grid gap-3">
      <div><label class="mono-label block" for="pj-duties">Duties &amp; responsibilities</label><textarea id="pj-duties" name="duties" rows="3" class="input mt-1" placeholder="What the person will actually do — one line per duty"></textarea></div>
      <div><label class="mono-label block" for="pj-quals">Qualifications</label><textarea id="pj-quals" name="quals" rows="3" class="input mt-1" placeholder="Experience, skills, papers — one line each"></textarea></div>
    </div>

    <fieldset class="mt-4 border border-line p-3">
      <legend class="mono-label px-1">How should people apply?</legend>
      <div class="grid gap-3 sm:grid-cols-2">
        <div><label class="mono-label block" for="pj-apply">Method</label>
          <select id="pj-apply" name="apply" class="input input-mono mt-1">
            <option value="Email CV">Email a CV</option>
            <option value="WhatsApp">WhatsApp</option>
            <option value="Portal link">Portal link</option>
          </select>
        </div>
        <div><label class="mono-label block" for="pj-apply-detail">Where — email, number or link *</label><input id="pj-apply-detail" name="applyDetail" required class="input mt-1" placeholder="jobs@yourco.co.ke" data-apply-detail />
          <p class="mt-1.5 text-[11.5px] text-mut" data-apply-hint>CVs go straight to this inbox — we never sit in between.</p>
        </div>
        <div><label class="mono-label block" for="pj-deadline">Deadline</label><input id="pj-deadline" name="deadline" type="date" class="input input-mono mt-1" /></div>
        <div><label class="mono-label block" for="pj-start">Starts (optional)</label><input id="pj-start" name="starts" class="input mt-1" placeholder=" ASAP / Jan 2027" /></div>
      </div>
    </fieldset>

    <p class="mt-3 text-[12.5px] leading-relaxed text-mut">Applicants never pay to apply — ever. Every listing is reviewed by a person before it goes live, so no “M-PESA registration fee” scams on this board.</p>
    <p class="mt-1.5 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">Free listing KSh 0 · Standard KSh 2,900 · Featured KSh 6,500 — hiring more? 3 posts for KSh 7,500.</p>
    <div class="mt-4 flex items-center justify-end gap-5">
      <button type="button" class="text-[13px] text-mut underline hover:text-ink" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-10 px-5">Send it for review →</button>
    </div>
  </form>
</dialog>

<!-- LIST EVENT -->
<dialog id="modal-listevent" class="dialog-card" aria-labelledby="le-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="le-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">List a hackathon — free</p></div>
  <form class="px-5 py-4" data-kind="event">
    <label class="mono-label block" for="le-name">Event name *</label><input id="le-name" name="name" required class="input mt-1" />
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <div><label class="mono-label block" for="le-city">City</label><input id="le-city" name="city" class="input mt-1" placeholder="Nairobi" /></div>
      <div><label class="mono-label block" for="le-date">Date</label><input id="le-date" name="date" type="date" class="input-mono input mt-1" /></div>
    </div>
    <label class="mono-label mt-3 block" for="le-email">Email *</label><input id="le-email" name="email" type="email" required class="input mt-1" />
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Submit event</button>
    </div>
  </form>
</dialog>

<!-- REQUEST INTRODUCTION -->
<dialog id="modal-intro" class="dialog-card" aria-labelledby="intro-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="intro-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Request introduction — vetted service</p></div>
  <form class="px-5 py-4" data-kind="intro">
    <p class="text-[14px] text-mut">Intros are a paid, vetted service (Professional plan includes 2/month). We confirm fit before any intro is made.</p>
    <label class="mono-label mt-3 block" for="in-email">Work email *</label><input id="in-email" name="email" type="email" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="in-note">Why this fund/company *</label><textarea id="in-note" name="note" required rows="3" class="input mt-1"></textarea>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Request intro</button>
    </div>
  </form>
</dialog>

<!-- HACKATHON REGISTRATION -->
<dialog id="modal-register" class="dialog-card" aria-labelledby="reg-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="reg-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Register your team</p></div>
  <form class="px-5 py-4" data-kind="register">
    <label class="mono-label block" for="rg-team">Team name *</label><input id="rg-team" name="team" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="rg-email">Email *</label><input id="rg-email" name="email" type="email" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="rg-size">Team size (2–5)</label><input id="rg-size" name="size" type="number" min="2" max="5" class="input-mono input mt-1" />
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Register</button>
    </div>
  </form>
</dialog>

<!-- JOB APPLICATION -->
<dialog id="modal-apply" class="dialog-card" aria-labelledby="ap-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="ap-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Apply now</p></div>
  <form class="px-5 py-4" data-kind="apply">
    <label class="mono-label block" for="ap-name">Full name *</label><input id="ap-name" name="name" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="ap-email">Email *</label><input id="ap-email" name="email" type="email" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="ap-link">LinkedIn / portfolio</label><input id="ap-link" name="link" class="input mt-1" placeholder="https://" />
    <p class="mono-label mt-3">Your application goes to the employer via the listing’s board.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Send application</button>
    </div>
  </form>
</dialog>

<!-- REPORT DATA ISSUE -->
<dialog id="modal-report" class="dialog-card" aria-labelledby="rp-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="rp-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Report a data issue</p></div>
  <form class="px-5 py-4" data-kind="issue">
    <label class="mono-label block" for="rp-note">What's wrong? *</label><textarea id="rp-note" name="note" required rows="3" class="input mt-1"></textarea>
    <label class="mono-label mt-3 block" for="rp-email">Email (optional)</label><input id="rp-email" name="email" type="email" class="input mt-1" />
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Send report</button>
    </div>
  </form>
</dialog>

<!-- TRIAL / BUY / SPONSOR (email-capture style) -->
<dialog id="modal-trial" class="dialog-card" aria-labelledby="tr-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="tr-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Start 14-day trial — Professional</p></div>
  <form class="px-5 py-4" data-kind="trial">
    <label class="mono-label block" for="tr-email">Work email *</label><input id="tr-email" name="email" type="email" required class="input mt-1" />
    <p class="mono-label mt-3">KSh 2,900/mo after trial · invoice or M-PESA · cancel anytime.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Start trial</button>
    </div>
  </form>
</dialog>

<dialog id="modal-buy" class="dialog-card" aria-labelledby="buy-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="buy-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Unlock report</p></div>
  <form class="px-5 py-4" data-kind="buy">
    <label class="mono-label block" for="buy-email">Email *</label><input id="buy-email" name="email" type="email" required class="input mt-1" />
    <p class="mono-label mt-3">We send payment details, then the PDF + data appendix.</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Continue</button>
    </div>
  </form>
</dialog>

<dialog id="modal-sponsor" class="dialog-card" aria-labelledby="sp-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="sp-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">Become a sponsor / talk to us</p></div>
  <form class="px-5 py-4" data-kind="sponsor">
    <label class="mono-label block" for="sp-name">Name / company *</label><input id="sp-name" name="name" required class="input mt-1" />
    <label class="mono-label mt-3 block" for="sp-email">Email *</label><input id="sp-email" name="email" type="email" required class="input mt-1" />
    <p class="mono-label mt-3">Or reach us directly at <a class="text-amber underline" data-email={SITE.contact.emailB64} href="/contact">{SITE.contact.emailLabel}</a> · {SITE.contact.phoneDisplay}</p>
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Send</button>
    </div>
  </form>
</dialog>

<!-- NEWSLETTER -->
<dialog id="modal-newsletter" class="dialog-card" aria-labelledby="nl-title">
  <div class="border-b border-ink px-5 py-3.5"><p id="nl-title" class="font-mono text-[11px] uppercase tracking-[0.14em]">The Ecosystem Brief</p></div>
  <form class="px-5 py-4" data-kind="newsletter">
    <p class="text-[14px] text-mut">Every Monday, 06:30 EAT. What moved, what funded, what shipped.</p>
    <label class="mono-label mt-3 block" for="nl-email">Email *</label><input id="nl-email" name="email" type="email" required class="input mt-1" />
    <div class="mt-5 flex justify-end gap-2">
      <button type="button" class="btn btn-ghost h-9" data-close>Cancel</button>
      <button type="submit" class="btn btn-amber h-9">Subscribe</button>
    </div>
  </form>
</dialog>

<script>
  // --- open/close plumbing ---
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const opener = t.closest('[data-modal]') as HTMLElement | null;
    if (opener) {
      const dlg = document.getElementById(`modal-${opener.dataset.modal}`) as HTMLDialogElement | null;
      if (dlg) {
        if (!dlg.open) dlg.showModal();
        return;
      }
    }
    if (t.closest('[data-close]')) {
      const dlg = t.closest('dialog') as HTMLDialogElement | null;
      dlg?.close();
    }
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.dialog-card').forEach((dlg) => {
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close(); // backdrop click
    });
  });

  // --- dropzones: drag & drop or click-to-browse (custom, replaces native file input) ---
  document.querySelectorAll<HTMLElement>('[data-dropzone]').forEach((zone) => {
    const input = zone.querySelector<HTMLInputElement>('input[type="file"]');
    const label = zone.querySelector<HTMLElement>('[data-dropzone-label]');
    if (!input || !label) return;
    const defaultText = label.textContent;
    const show = (name?: string) => { label.textContent = name || defaultText; };
    input.addEventListener('change', () => show(input.files?.[0]?.name));
    ['dragover', 'dragenter'].forEach((ev) => zone.addEventListener(ev, (e) => { e.preventDefault(); (e.currentTarget as HTMLElement).classList.add('border-ink', 'text-ink'); }));
    ['dragleave', 'dragend'].forEach((ev) => zone.addEventListener(ev, () => zone.classList.remove('border-ink', 'text-ink')));
    zone.addEventListener('drop', (e) => {
      e.preventDefault();
      zone.classList.remove('border-ink', 'text-ink');
      const file = e.dataTransfer?.files?.[0];
      if (!file) return;
      const dt = new DataTransfer();
      dt.items.add(file);
      input.files = dt.files;
      show(file.name);
    });
  });

  // --- post-a-job conditional fields ---
  const paySel = document.getElementById('pj-pay') as HTMLSelectElement | null;
  const rangeWrap = document.getElementById('pj-range-wrap');
  paySel?.addEventListener('change', () => {
    if (!rangeWrap) return;
    rangeWrap.classList.toggle('hidden', paySel.value !== 'Range');
  });
  const applySel = document.getElementById('pj-apply') as HTMLSelectElement | null;
  const applyDetail = document.querySelector<HTMLInputElement>('[data-apply-detail]');
  const applyHint = document.querySelector<HTMLElement>('[data-apply-hint]');
  const APPLY_HINTS: Record<string, { ph: string; hint: string }> = {
    'Email CV': { ph: 'jobs@yourco.co.ke', hint: 'CVs go straight to this inbox — we never sit in between.' },
    WhatsApp: { ph: '+254 7XX XXX XXX', hint: 'Applicants open WhatsApp with your number pre-filled.' },
    'Portal link': { ph: 'https://careers.yourco.co.ke/role', hint: 'We link straight to your portal — no accounts here.' },
  };
  applySel?.addEventListener('change', () => {
    const cfg = APPLY_HINTS[applySel.value];
    if (!cfg || !applyDetail || !applyHint) return;
    applyDetail.placeholder = cfg.ph;
    applyHint.textContent = cfg.hint;
  });

  // --- form plumbing (Supabase with local fallback + email notify) ---
  const KIND_TITLES: Record<string, string> = {
    startup: 'Submission received',
    claim: 'Claim request received',
    job: 'Job posting received',
    event: 'Event submitted',
    intro: 'Introduction requested',
    register: 'Team registered',
    apply: 'Application sent',
    issue: 'Report received',
    trial: 'Trial started',
    buy: 'Unlock request received',
    sponsor: 'Message sent',
    newsletter: 'Subscribed',
    auth: 'Magic link sent',
  };

  /** Fire-and-forget email ping — the Netlify function emails the desk via
   *  Resend. Silent no-op when the function isn't deployed (local/preview). */
  function notifyDesk(kind: string, payload: Record<string, unknown>, email?: string) {
    try {
      fetch('/.netlify/functions/notify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ kind, payload, email }),
      }).catch(() => {});
    } catch { /* non-fatal by design */ }
  }

  // --- submit-your-startup: instant publish (no approval) or review fallback ---
  const submitForm = document.querySelector<HTMLFormElement>('form[data-kind="startup"]');
  const toggleBtn = submitForm?.querySelector<HTMLButtonElement>('[data-toggle-mode]');
  toggleBtn?.addEventListener('click', () => {
    const instant = submitForm!.dataset.mode === 'instant';
    submitForm!.dataset.mode = instant ? 'review' : 'instant';
    toggleBtn.textContent = instant ? 'Publish instantly instead' : 'Submit for review instead';
    const go = submitForm!.querySelector<HTMLButtonElement>('[data-publish-actions] button[type="submit"]');
    if (go) go.textContent = instant ? 'Submit for review →' : 'Publish now — live immediately →';
  });

  function showPublishSuccess(slug: string) {
    const url = `https://startups.co.ke/startups/community/${slug}`;
    submitForm?.querySelector('[data-live-url]')?.replaceChildren(document.createTextNode(url));
    const open = submitForm?.querySelector<HTMLAnchorElement>('[data-open-live]');
    if (open) open.href = url;
    submitForm?.querySelector('#publish-success')?.classList.remove('hidden');
    submitForm?.querySelector('[data-publish-actions]')?.classList.add('hidden');
    submitForm?.querySelector('[data-toggle-mode]')?.closest('p')?.classList.add('hidden');
    // Blobs replicate across regions within seconds — poll the live page until
    // it answers 200, then arm the “Open my profile” button. Honest UX: the
    // button says “Going live…” until the page REALLY answers.
    const btn = submitForm?.querySelector<HTMLAnchorElement>('[data-open-live]');
    if (btn) {
      btn.textContent = 'Going live…';
      btn.setAttribute('aria-disabled', 'true');
      const started = Date.now();
      const poll = async (): Promise<void> => {
        try {
          const r = await fetch(url, { method: 'HEAD' });
          if (r.ok) {
            btn.textContent = 'Open my profile →';
            btn.removeAttribute('aria-disabled');
            return;
          }
        } catch { /* keep polling */ }
        if (Date.now() - started < 45000) setTimeout(poll, 2000);
        else btn.textContent = 'Open my profile (retry) →';
      };
      setTimeout(poll, 1500);
    }
  }
  submitForm?.querySelector('[data-copy-live]')?.addEventListener('click', async (ev) => {
    const btn = ev.currentTarget as HTMLButtonElement | null;
    if (!btn) return;
    try {
      await navigator.clipboard.writeText(submitForm?.querySelector('[data-live-url]')?.textContent || '');
      btn.textContent = 'Copied ✓';
      setTimeout(() => { btn.textContent = 'Copy link'; }, 1600);
    } catch { /* clipboard blocked — the URL is selectable text anyway */ }
  });
  submitForm?.querySelector('[data-list-another]')?.addEventListener('click', () => {
    submitForm!.querySelector('#publish-success')?.classList.add('hidden');
    submitForm!.querySelector('[data-publish-actions]')?.classList.remove('hidden');
    submitForm!.querySelector('[data-toggle-mode]')?.closest('p')?.classList.remove('hidden');
    submitForm!.reset();
    submitForm!.querySelectorAll('input[type="file"]').forEach((fi) => fi.dispatchEvent(new Event('change')));
  });

  document.querySelectorAll<HTMLFormElement>('dialog form[data-kind]').forEach((form) => {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const kind = form.dataset.kind!;
      const data = Object.fromEntries(new FormData(form).entries());
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) { btn.dataset.origLabel = btn.textContent ?? ''; btn.disabled = true; btn.textContent = 'Sending…'; }
      let logoPath: string | undefined;
      // Track whether this submit was an instant publish (needs its own
      // success + error UX: the dialog stays open and shows the live URL).
      const instantPublish = kind === 'startup' && form.dataset.mode === 'instant';
      try {
        if (kind === 'auth') {
          const sbMod = await import('@/lib/supabase');
          const sb = sbMod.supabase();
          if (!sb) throw new Error('not-configured');
          const { error } = await sb.auth.signInWithOtp({
            email: String(data.email),
            options: { emailRedirectTo: window.location.origin },
          });
          if (error) throw error;
        } else if (kind === 'newsletter') {
          const sbMod = await import('@/lib/supabase');
          await sbMod.subscribeNewsletter(String(data.email), 'modal');
        } else if (instantPublish) {
          const sbMod = await import('@/lib/supabase');
          // 1) logo upload first (logos bucket is public-write)
          const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
          if (fileInput?.files?.[0] && sbMod.supabaseConfigured) {
            try { logoPath = await sbMod.uploadLogo(fileInput.files[0], String(data.name || 'logo')); }
            catch { /* non-fatal — listing works without a logo */ }
          }
          // 2) magic-link identity (optional — raises rate limit, marks signedin)
          let token: string | undefined;
          try {
            const sb = sbMod.supabase();
            const sess = sb ? await sb.auth.getSession() : null;
            token = sess?.data.session?.access_token;
          } catch { /* anon publish is supported */ }
          // 3) publish — live immediately
          const res = await fetch('/.netlify/functions/startup-create', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              ...(token ? { Authorization: `Bearer ${token}` } : {}),
            },
            body: JSON.stringify({
              ...data,
              logoUrl: logoPath ? sbMod.logoPublicUrl(logoPath) : undefined,
            }),
          });
          const out = await res.json().catch(() => ({}) as Record<string, unknown>);
          if (!res.ok || !out.ok) {
            const errs = (out as { errors?: Record<string, string> }).errors;
            const msg = errs ? Object.values(errs).join(' · ') : String((out as { error?: string }).error || `HTTP ${res.status}`);
            throw new Error(`publish-failed: ${msg}`);
          }
          notifyDesk('startup', { ...data, logoPath, published: 'instant', slug: out.slug }, (data.email as string) || undefined);
          showPublishSuccess(String(out.slug));
          window.sckToast({ title: 'Live now', body: 'Your startup page is published — grab the link below.' });
          return; // dialog stays open on the success panel
        } else {
          const sbMod = await import('@/lib/supabase');
          // logo upload if a file was picked
          const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
          if (fileInput?.files?.[0] && sbMod.supabaseConfigured) {
            try { logoPath = await sbMod.uploadLogo(fileInput.files[0], String(data.name || data.company || 'logo')); }
            catch { /* non-fatal */ }
          }
          await sbMod.submitForm(kind as never, { ...data, logoPath }, (data.email as string) || undefined);
          notifyDesk(kind, { ...data, logoPath }, (data.email as string) || undefined);
        }
        form.closest('dialog')?.close();
        form.reset();
        // reset dropzone labels (form.reset() doesn't fire change events)
        document.querySelectorAll<HTMLFormElement>('dialog form').forEach((f) =>
          f.querySelectorAll<HTMLInputElement>('input[type="file"]').forEach((fi) => fi.dispatchEvent(new Event('change'))));
        const toast = window.sckToast;
        toast({
          title: KIND_TITLES[kind] ?? 'Done',
          body: kind === 'auth'
            ? 'Check your inbox for the one-time link.'
            : logoPath
              ? 'Recorded in our review queue — logo uploaded.'
              : 'Recorded in our review queue.',
        });
      } catch (err) {
        const toast = window.sckToast;
        if (instantPublish) {
          // Keep the form open so the founder can fix and retry — never
          // pretend a failed publish succeeded.
          const msg = String(err).startsWith('publish-failed:')
            ? String(err).slice('publish-failed: '.length)
            : 'Network hiccup — try again.';
          toast({ title: 'Publish failed', body: msg, kind: 'warn' });
        } else if (String(err).includes('not-configured') || kind !== 'auth') {
          form.closest('dialog')?.close();
          toast({ title: 'Saved locally', body: 'Supabase is not connected in this environment — your entry is queued on this device.', kind: 'warn' });
        } else {
          toast({ title: 'Something went wrong', body: 'Please try again or email us.', kind: 'warn' });
        }
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = btn.dataset.origLabel || 'Send'; }
      }
    });
  });
</script>
