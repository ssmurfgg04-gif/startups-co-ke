---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import { COMPANIES } from '@/data/companies';
import { SITE } from '@/config/site';

const verifiedDate = new Date().toLocaleDateString('en-KE', { day: 'numeric', month: 'short', year: 'numeric' });
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How do I list my startup in Kenya on startups.co.ke?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Open the listing form, describe your company in a sentence or two, add your website and county, and press Publish. Your page goes live immediately, no approval step, no fee.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is listing free?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes, everything on startups.co.ke is free while we build momentum, including founder listings, the funding database and job posts.',
        },
      },
      {
        '@type': 'Question',
        name: 'How long does it take to go live?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Seconds. Your profile is a real page at startups.co.ke/startups/community/your-name the moment you publish, carrying a Founder-submitted tag until we verify it against public sources.',
        },
      },
      {
        '@type': 'Question',
        name: 'What does the Founder-submitted tag mean?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'It means you published the listing yourself. Our team verifies it against public sources (registry, team pages, press) after which the profile is treated like every other verified record.',
        },
      },
    ],
  },
];
---
<Base title="List your startup in Kenya, free, instant" description="Put your Kenyan startup on the record: a free profile page at startups.co.ke, live the moment you publish. Founders in Nairobi and all 47 counties." jsonld={jsonld}>
  <section class="wrap py-10">
    <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-mut"><a href="/" class="hover:text-ink">Home</a> / List your startup</p>
    <h1 class="mt-2 max-w-3xl text-[clamp(34px,4vw,56px)]">List your startup in Kenya. Free. Live in seconds.</h1>
    <p class="mt-3 max-w-2xl text-[15.5px] leading-relaxed text-ink2">
      Your own page on the record investors actually search (<strong>startups.co.ke/startups/community/your-name</strong>) with your tagline, sector, stage, county and website. No approval queue, no fee, no card. Drop the link in your deck, bio and email signature today.
    </p>
    <div class="mt-6 flex flex-wrap gap-2">
      <button class="btn btn-amber h-11 px-6" data-modal="submit">Publish your startup now →</button>
      <a class="btn btn-ghost h-11 px-5" href="/startups/community">See founder listings</a>
    </div>
    <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">{COMPANIES.length} tracked companies already on the index · every profile carries a named source · verified {verifiedDate}</p>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <div class="border border-ink bg-paper p-5">
        <p class="mono-label">01 · Instant</p>
        <h2 class="mt-2 font-display text-[19px]">Live the moment you publish</h2>
        <p class="mt-2 text-[13.5px] leading-relaxed text-mut">Your page is a real URL on startups.co.ke, server-rendered, readable by Google and by AI assistants the same minute. Retry-safe publishing: a flaky network can never create a double.</p>
      </div>
      <div class="border border-ink bg-paper p-5">
        <p class="mono-label">02 · Honest</p>
        <h2 class="mt-2 font-display text-[19px]">Founder-submitted until verified</h2>
        <p class="mt-2 text-[13.5px] leading-relaxed text-mut">Your listing carries a clear tag until we cross-check it against public sources, the same treatment every company on the index gets. No fake numbers, ever.</p>
      </div>
      <div class="border border-ink bg-paper p-5">
        <p class="mono-label">03 · Free</p>
        <h2 class="mt-2 font-display text-[19px]">Everything is free right now</h2>
        <p class="mt-2 text-[13.5px] leading-relaxed text-mut">No tiers, no trials, no card. If that ever changes, the methodology page says so first, and early listings keep everything they have.</p>
      </div>
    </div>

    <div class="mt-12">
      <SectionHead title="Questions founders ask." />
      <div class="prose-sck mt-4 max-w-3xl">
        <p><strong>Who is this for?</strong> Kenyan startups at any stage, pre-seed in Kisumu or Series B in Nairobi. If you're building here, you belong on the record.</p>
        <p><strong>Do investors really look?</strong> The index is built to be searched: sector, stage, county and capital filters, investor directory and a funding database, the way local analysts and funds actually source deal flow.</p>
        <p><strong>Can I edit or remove my listing later?</strong> Yes, email <a class="text-amber underline" data-email={SITE.contact.emailB64} href="/contact">{SITE.contact.emailLabel}</a> or use the report-issue action on any profile. You control your company's story.</p>
      </div>
    </div>
  </section>
</Base>
