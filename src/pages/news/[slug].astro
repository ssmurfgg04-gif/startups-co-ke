---
import Base from '@/layouts/Base.astro';
import Chip from '@/components/Chip.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '@/config/site';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const relDate = (iso: string) => {
  const days = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 86400000));
  return days === 0 ? 'Today' : days === 1 ? 'Yesterday' : `${days} days ago`;
};
const related = (await getCollection('news')).filter((p) => p.id !== entry.id).slice(0, 3);
---
<Base
  title={d.title}
  description={d.dek}
  ogType="article"
  publishedTime={d.date}
  author={d.author}
  jsonld={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.dek,
    datePublished: d.date,
    author: { '@type': 'Person', name: d.author },
    publisher: { '@type': 'Organization', name: 'startups.co.ke', logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` } },
    image: `https://picsum.photos/seed/${d.imageSeed}/1200/630.jpg`,
    mainEntityOfPage: `${SITE.url}/news/${entry.id}`,
  }}
>
  <article class="wrap max-w-3xl py-10">
    <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-mut"><a href="/" class="hover:text-ink">Home</a> / <a href="/news" class="hover:text-ink">The Wire</a> / <span class="text-ink">{d.category}</span></p>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="chip chip-solid">{d.category}</span>
      <span class="chip chip-dashed">Sourced analysis</span>
    </div>
    <h1 class="mt-3 text-[clamp(30px,3.6vw,46px)] leading-[1.05]">{d.title}</h1>
    <p class="mt-3 text-[17px] leading-relaxed text-ink2">{d.dek}</p>
    <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.12em] text-mut">By {d.author} · {relDate(d.date)} · {d.mins} min read · {SITE.contact.city}</p>

    <div class="my-6 flex flex-wrap items-center justify-between gap-3 border-y border-ink py-3">
      <ShareButtons title={d.title} />
      <button class="btn btn-ghost h-9" data-modal="trial">Save for later</button>
    </div>

    <img src={`https://picsum.photos/seed/${d.imageSeed}/900/480.jpg`} alt={`Illustration for ${d.title}`} width="900" height="480" loading="eager" decoding="async" class="photo-warm aspect-video w-full border border-ink object-cover" />

    <div class="prose-sck mt-8 max-w-none">
      <Content />
    </div>

    {d.sources.length > 0 && (
      <div class="railbox mt-8">
        <div class="railbox-head"><span>Sources</span><span class="mono-label">named · public</span></div>
        <ul class="px-4 py-3">
          {d.sources.map((src) => (
            <li class="border-b border-line py-2 text-[13.5px] last:border-0">
              <a class="text-green hover:underline" href={src.url} target="_blank" rel="noopener noreferrer">{src.label} ↗</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="mt-10 border-t border-ink pt-6">
      <p class="mono-label mb-3">More from the desk</p>
      {related.map((r) => (
        <a href={`/news/${r.id}`} class="rowline flex items-center justify-between px-1 py-3 hover:bg-paper2">
          <span class="text-[14.5px]">{r.data.title}</span>
          <span class="mono-label">{r.data.category}</span>
        </a>
      ))}
    </div>
  </article>
</Base>

<style>
  .prose-sck p {
    margin-bottom: 1.15rem;
    line-height: 1.75;
    font-size: 16.5px;
    color: var(--color-ink2);
  }
  .prose-sck p:first-child {
    font-size: 18px;
    color: var(--color-ink);
  }
  .prose-sck p:last-child {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-mut);
    border-top: 1px dashed var(--color-line2);
    padding-top: 0.9rem;
  }
</style>
