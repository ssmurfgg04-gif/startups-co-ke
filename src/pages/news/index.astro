---
import Base from '@/layouts/Base.astro';
import Chip from '@/components/Chip.astro';
import DataPlate from '@/components/DataPlate.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@/config/site';

const all = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const [lead, ...rest] = all;
const cats = [...new Set(all.map((a) => a.data.category))];
const relDate = (iso: string) => {
  const d = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 86400000));
  return d === 0 ? 'Today' : d === 1 ? 'Yesterday' : `${d} days ago`;
};
---
<Base
  title="The Wire, Kenya startup & ecosystem news"
  description="Analysis, not aggregation: funding quarterly reviews, venture mechanics, talent and climate capital, written for Kenya's ecosystem."
  jsonld={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'The Wire, ecosystem news',
    url: `${SITE.url}/news`,
  }}
>
  <section class="wrap py-10">
    <h1 class="text-[clamp(34px,4vw,56px)]">The Wire.</h1>
    <p class="mt-2 max-w-2xl text-[15px] text-mut">Ecosystem analysis from our desk, real events, named sources, and the numbers behind the noise.</p>
    <div class="mt-5 flex flex-wrap gap-2">
      {cats.map((c, i) => <button class={`news-cat chip ${i === 0 ? 'chip-solid' : ''}`} data-cat={c}>{c}</button>)}
      <button class="news-cat chip chip-solid" data-cat="All">All</button>
    </div>

    <div class="mt-8 grid gap-10 lg:grid-cols-12">
      <a href={`/news/${lead.id}`} class="group block border border-ink bg-paper lg:col-span-7">
        <div class="overflow-hidden border-b border-ink">
          <DataPlate seed={lead.data.imageSeed} label={`startups.co.ke · ${lead.data.category}`} class="h-64 w-full" />
        </div>
        <div class="p-5">
          <div class="flex items-center gap-2"><span class="chip chip-solid">{lead.data.category}</span><span class="chip chip-dashed">Sourced</span></div>
          <h2 class="mt-3 font-display text-[26px] leading-tight">{lead.data.title}</h2>
          <p class="mt-2 text-[14px] text-mut">{lead.data.dek}</p>
          <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.12em] text-mut">By {lead.data.author} · {relDate(lead.data.date)} · {lead.data.mins} min read</p>
        </div>
      </a>

      <div class="border border-ink bg-paper lg:col-span-5">
        {rest.map((a, i) => (
          <a href={`/news/${a.id}`} class="news-item rowline group flex gap-4 px-4 py-4 hover:bg-paper2" data-cat={a.data.category}>
            <span class="statnum shrink-0 text-[13px] text-amber">{String(i + 2).padStart(2, '0')}</span>
            <span class="flex-1">
              <span class="block text-[15px] leading-snug">{a.data.title}</span>
              <span class="mono-label mt-1 block">{a.data.category} · {relDate(a.data.date)} · {a.data.mins} min</span>
            </span>
            <span class="self-center text-ink opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll('.news-cat').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.news-cat').forEach((x) => x.classList.remove('chip-solid'));
      b.classList.add('chip-solid');
      const cat = (b as HTMLElement).dataset.cat!;
      document.querySelectorAll('.news-item').forEach((item) => {
        item.classList.toggle('hidden', cat !== 'All' && (item as HTMLElement).dataset.cat !== cat);
      });
    })
  );
</script>
