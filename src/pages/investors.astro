---
import Base from '@/layouts/Base.astro';
import Monogram from '@/components/Monogram.astro';
import Chip from '@/components/Chip.astro';
import Sparkline from '@/components/Sparkline.astro';
import { INVESTORS } from '@/data/investors';
import { companyById } from '@/data/companies';
import { SECTORS } from '@/config/sectors';
import { SITE } from '@/config/site';
const investors = INVESTORS;
---
<Base
  title="Investor directory — venture capital in Kenya"
  description="Which funds are writing cheques in Kenya: focus sectors, stages, cheque sizes, theses and notable portfolio companies. Verified and sample-labelled."
  jsonld={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Investor directory — Kenya',
    url: `${SITE.url}/investors`,
  }}
>
  <section class="wrap py-10">
    <h1 class="text-[clamp(34px,4vw,56px)]">Who is writing cheques.</h1>
    <p class="mt-2 max-w-2xl text-[15px] text-mut">
      Funds, angel networks and micro-funds active across the Kenyan index. Theses and cheque ranges are self-reported and sample-labelled.
    </p>

    <div class="mt-8 grid gap-8 lg:grid-cols-12">
      <!-- Filters -->
      <aside class="lg:col-span-3">
        <div class="railbox sticky top-20 p-4" aria-label="Investor filters">
          <p class="mono-label mb-1.5">Focus sectors</p>
          <div id="inv-sectors" class="space-y-1.5 max-h-44 overflow-y-auto pr-1">
            {SECTORS.map((s) => (
              <label class="flex cursor-pointer items-center gap-2 text-[13px]">
                <input type="checkbox" value={s} class="accent-[#0E4630]" />
                <span>{s}</span>
              </label>
            ))}
          </div>
          <label class="mono-label mt-4 block" for="inv-stage">Stage</label>
          <select id="inv-stage" class="input input-mono mt-1">
            <option value="">Any stage</option>
            {['Pre-seed', 'Seed', 'Series A', 'Series B'].map((s) => <option value={s}>{s}</option>)}
          </select>
          <label class="mt-4 flex cursor-pointer items-center justify-between text-[13px]">
            <span>Verified only</span>
            <input id="inv-verified" type="checkbox" class="h-4 w-4 accent-[#0E4630]" />
          </label>
          <p id="inv-count" class="mt-4 font-mono text-[11px] uppercase tracking-[0.1em] text-mut">Showing {investors.length} funds · sample</p>
        </div>
      </aside>

      <!-- Fund rows -->
      <div class="lg:col-span-6">
        <div id="inv-rows">
          {investors.map((inv) => (
            <div class="inv-row rowline border border-ink border-t-0 first:border-t bg-paper" data-sectors={inv.focusSectors.join('|')} data-stages={inv.stages.join('|')} data-verified={inv.verified}>
              <button class="flex w-full items-center gap-3 px-4 py-4 text-left hover:bg-paper2" data-expand aria-expanded="false">
                <Monogram name={inv.name} size="md" />
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-2 text-[15.5px] font-medium">
                    {inv.name} {inv.verified ? <Chip kind="verified" /> : <Chip kind="unverified" />}
                  </span>
                  <span class="mono-label mt-0.5 block">{inv.type} · {inv.hq}</span>
                  <span class="mt-1.5 flex flex-wrap gap-1.5">
                    <span class="chip chip-dashed">{inv.stages[0]}–{inv.stages[inv.stages.length - 1]}</span>
                    <span class="chip">{inv.cheque}</span>
                  </span>
                </span>
                <span class="inv-caret shrink-0 text-ink transition-transform duration-200" aria-hidden="true">▾</span>
              </button>
              <div class="inv-detail grid transition-[grid-template-rows] duration-300" style="grid-template-rows:0fr">
                <div class="overflow-hidden">
                  <div class="border-t border-line px-4 py-4">
                    <p class="text-[14px] leading-relaxed text-ink2">{inv.thesis}</p>
                    <div class="mt-2.5 flex flex-wrap gap-1.5">{inv.thesisPills.map((p) => <span class="chip chip-dashed">{p}</span>)}</div>
                    <p class="mono-label mt-3.5 mb-1.5">Notable investments (sample)</p>
                    <div class="flex flex-wrap gap-1.5">
                      {inv.portfolio.map((pid) => {
                        const co = companyById(pid);
                        return co ? <a class="chip hover:bg-paper2" href={`/startups/${co.id}`}>{co.name}</a> : null;
                      })}
                    </div>
                    <p class="mt-3 text-[12.5px] text-mut">{inv.note} · {inv.deals} deals tracked (sample)</p>
                    <div class="mt-4 flex gap-2">
                      <button class="btn h-9" data-modal="intro">Request introduction</button>
                      <button class="btn btn-ghost h-9" data-modal="trial">Follow fund</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right rail -->
      <aside class="space-y-6 lg:col-span-3">
        <div class="railbox">
          <div class="railbox-head"><span>Deal flow requests</span><Chip kind="sample" /></div>
          {[
            ['Wanjiku N.', 'Sokoni Systems', 'Series A · $9M round'],
            ['Kevin M.', 'BodaMetrics', 'Seed · $2.1M round'],
            ['Salim B.', 'DukaCredit', 'Pre-seed · $850K round'],
          ].map(([f, co, ask]) => (
            <div class="border-b border-line px-4 py-3 last:border-0">
              <p class="text-[13.5px]"><span class="font-medium">{f}</span> — {co}</p>
              <p class="mono-label mt-0.5">{ask}</p>
              <span class="chip chip-amber mt-2">Qualified intro ★</span>
            </div>
          ))}
          <p class="px-4 py-3 text-[11.5px] text-mut">Intros are a paid, vetted service. Founders apply; we qualify fit first. (Sample queue)</p>
        </div>
        <div class="railbox">
          <div class="railbox-head"><span>Investor activity</span><Chip kind="illustrative" /></div>
          <div class="flex items-center justify-between px-4 py-3">
            <p class="mono-label">Deals / quarter</p>
            <Sparkline id="investor-activity" w={120} h={36} />
          </div>
        </div>
        <div class="border border-amber bg-paper p-4">
          <p class="text-[14.5px] font-medium">List your fund</p>
          <p class="mt-1 text-[13px] text-mut">Get in front of founders raising now.</p>
          <button class="btn btn-amber mt-3 w-full" data-modal="sponsor">List your fund</button>
        </div>
      </aside>
    </div>

    <!-- subscription band -->
    <div class="mt-12 border border-ink bg-green p-6 text-dpaper md:p-8">
      <div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center">
        <div>
          <h2 class="text-[22px]">Investor membership</h2>
          <ul class="mt-2 grid gap-1 text-[13.5px] text-dpaper/90 md:grid-cols-2">
            <li>✓ Deal-flow request queue</li><li>✓ Verified company data export</li>
            <li>✓ Sector &amp; stage alerts</li><li>✓ Intros without the cold email</li>
          </ul>
        </div>
        <div class="text-left md:text-right">
          <p class="statnum text-[26px]">{SITE.investorSub.price}</p>
          <p class="mono-label mt-1 text-dmut">after {SITE.investorSub.trial} · sample pricing</p>
          <button class="btn btn-amber mt-3" data-modal="trial">Start trial</button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Expandable fund rows
  document.querySelectorAll('.inv-row').forEach((row) => {
    const btn = row.querySelector<HTMLButtonElement>('[data-expand]')!;
    const detail = row.querySelector<HTMLElement>('.inv-detail')!;
    btn.addEventListener('click', () => {
      const open = detail.style.gridTemplateRows === '1fr';
      detail.style.gridTemplateRows = open ? '0fr' : '1fr';
      btn.setAttribute('aria-expanded', String(!open));
      row.querySelector('.inv-caret')?.classList.toggle('rotate-180', !open);
    });
  });

  // Filters
  const state = { sectors: new Set<string>(), stage: '', verified: false };
  const rows = document.querySelectorAll<HTMLElement>('.inv-row');
  function apply() {
    let n = 0;
    rows.forEach((row) => {
      const sectors = row.dataset.sectors!.split('|');
      const stages = row.dataset.stages!.split('|');
      const ok =
        (!state.sectors.size || sectors.some((s) => state.sectors.has(s))) &&
        (!state.stage || stages.includes(state.stage)) &&
        (!state.verified || row.dataset.verified === '1');
      row.classList.toggle('hidden', !ok);
      if (ok) n++;
    });
    const el = document.getElementById('inv-count');
    if (el) el.textContent = `Showing ${n} funds · sample`;
  }
  document.querySelectorAll('#inv-sectors input').forEach((cb) =>
    cb.addEventListener('change', () => {
      const s = (cb as HTMLInputElement).value;
      (cb as HTMLInputElement).checked ? state.sectors.add(s) : state.sectors.delete(s);
      apply();
    })
  );
  document.getElementById('inv-stage')?.addEventListener('change', (e) => { state.stage = (e.target as HTMLSelectElement).value; apply(); });
  document.getElementById('inv-verified')?.addEventListener('change', (e) => { state.verified = (e.target as HTMLInputElement).checked; apply(); });
  apply();
</script>
