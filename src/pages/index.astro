---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import KenyaMap from '@/components/KenyaMap.astro';
import FundingChart from '@/components/FundingChart.astro';
import CompanyCard from '@/components/CompanyCard.astro';
import Sparkline from '@/components/Sparkline.astro';
import Chip from '@/components/Chip.astro';
import StatusDot from '@/components/StatusDot.astro';
import DataPlate from '@/components/DataPlate.astro';
import Countdown from '@/components/Countdown.astro';
import { COMPANIES, FEATURED_IDS } from '@/data/companies';
import { ROUNDS, REPORTS } from '@/data/ecosystem';
import { INVESTORS, investorRounds } from '@/data/investors';
import { STATS, REGIONS } from '@/data/stats';
import { ANCHORED_COUNTIES } from '@/data/counties';
import { HACKATHONS } from '@/data/hackathons';
import { prng, fmtAmount, relDate } from '@/lib/utils';
import { SITE } from '@/config/site';

const featured = FEATURED_IDS.map((id) => COMPANIES.find((c) => c.id === id)!).filter(Boolean);
const featuredHack = HACKATHONS.find((h) => h.featured)!;
const daysTo = featuredHack.startISO
  ? Math.max(0, Math.round((Date.parse(featuredHack.startISO) - Date.now()) / 86400000))
  : Math.round((featuredHack.startOffsetMs ?? 0) / 86400000);
const nextUp = HACKATHONS.filter((h) => h.status === 'upcoming' && !h.featured && h.startISO)
  .sort((a, b) => Date.parse(a.startISO!) - Date.parse(b.startISO!))
  .slice(0, 3);
const leadArticle = { slug: 'sh93bn-lesson', title: 'The Sh93bn lesson: why verified data beats loud data', dek: 'Thirteen collapses, Sh93bn in investor losses, and two databases that disagree by 13,000 companies. The case for status-tagged funding data.', mins: 6, cat: 'Analysis' };
const wireList: [string, string, string][] = [
  ["Kenya's H1 2026 slowdown, in five numbers", 'Funding', 'h1-2026-slowdown'],
  ['The fallen: what Twiga, Copia and Sendy teach', 'Analysis', 'the-fallen'],
  ["Microsoft's ADC exit and the talent pipeline", 'Talent', 'microsoft-adc-exit'],
  ['Salary snapshot 2026: what roles actually pay', 'Talent', 'salary-snapshot-2026'],
  ["Stablecoin rails: HoneyCoin's $4.9M", 'Fintech', 'stablecoin-rails'],
  ["Angel syndicates are filling Kenya's seed gap", 'Funding', 'angel-syndicates-seed-gap'],
];
const flagship = REPORTS.find((r) => r.flagship)!;
const regionRows = REGIONS.filter((r) => r.count > 0);
const hubCounties = ANCHORED_COUNTIES.filter((c) => c.id !== 'nairobi');
const sectorCompanies = (sector: string) => COMPANIES.filter((c) => c.sector === sector);
// Derived, never typed: sector counts come straight from the company index
// (a static list drifted 19 vs 21, see worklog Task 4).
const SECTOR_ROWS = [...new Set(COMPANIES.map((c) => c.sector))]
  .map((sector) => ({ sector, count: sectorCompanies(sector).length }))
  .sort((a, b) => b.count - a.count);
const totalSector = SECTOR_ROWS.reduce((s, r) => s + r.count, 0);
const sectorMax = Math.max(...SECTOR_ROWS.map((r) => r.count));
// Derived investor activity, rounds each fund appears in (led or noted),
// straight from the rounds feed. Replaces the duplicated rounds rail.
const ACTIVE_INVESTORS = INVESTORS.map((inv) => ({
  id: inv.id,
  name: inv.name,
  type: inv.type,
  rounds: investorRounds(inv.id).led.length + investorRounds(inv.id).context.length,
}))
  .filter((i) => i.rounds > 0)
  .sort((a, b) => b.rounds - a.rounds)
  .slice(0, 8);
const activeMax = Math.max(...ACTIVE_INVESTORS.map((i) => i.rounds));
// Build-time date: the index is re-verified on every deploy (jobs refresh daily,
// data rows carry their own named sources), so this line is always true.
const verifiedDate = new Date().toLocaleDateString('en-KE', { day: 'numeric', month: 'short', year: 'numeric' });
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'startups.co.ke',
    url: SITE.url,
    logo: `${SITE.url}/favicon.svg`,
    address: { '@type': 'PostalAddress', addressLocality: 'Nairobi', addressCountry: 'KE', streetAddress: SITE.contact.address },
    contactPoint: [{ '@type': 'ContactPoint', email: SITE.contact.email, telephone: SITE.contact.phone, contactType: 'customer support' }],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    potentialAction: { '@type': 'SearchAction', target: `${SITE.url}/startups?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Featured verified startups',
    itemListElement: featured.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: `${SITE.url}/startups/${c.id}` })),
  },
];
---
<Base title={SITE.title} description={SITE.description} jsonld={jsonld}>
  <!-- 1) HERO -->
  <section class="wrap grid items-start gap-10 py-12 md:py-16 lg:grid-cols-12">
    <!-- No .rv reveal above the fold: the hero IS the LCP, it renders instantly,
         fonts swap in, nothing waits on JS. Below-fold sections keep the reveal. -->
    <div class="lg:col-span-7">
      <p class="kicker">Est. Nairobi · Kenya's startup record, kept in the open</p>
      <h1 class="mt-4 text-[clamp(40px,5.2vw,72px)] leading-[0.98]">
        Kenya's startup economy, <em class="font-display italic text-green">mapped</em> &amp; measured.
      </h1>
      <p class="mt-5 max-w-xl text-[16.5px] text-ink2">
        {COMPANIES.length} Kenyan startups with verified profiles: what they raised, from whom, and who failed. The investors actually writing cheques here. Climate and energy coverage goes deepest. Every number names its source.
      </p>

      <form class="mt-7 flex max-w-xl border-2 border-ink bg-paper" action="/startups" method="get" role="search" aria-label="Company search">
        <input class="input-mono min-h-12 flex-1 bg-transparent px-4 text-[15px] outline-none placeholder:text-mut" name="q" placeholder={`Search ${COMPANIES.length} tracked companies. Try “M-KOPA”, “solar”, “fintech”…`} aria-label="Search companies" />
        <button class="btn border-0 border-l-2 border-ink px-5" type="submit">Search</button>
      </form>

      <form class="brief-form mt-3 flex max-w-xl items-stretch border-2 border-ink bg-ink text-paper" data-kind="newsletter" aria-label="Subscribe to The Ecosystem Brief">
        <span class="hidden items-center pl-4 pr-1 font-mono text-[10px] uppercase tracking-[0.12em] text-dmut sm:flex">The Ecosystem Brief · Mon 06:30 EAT</span>
        <input class="min-h-11 flex-1 bg-transparent px-4 text-[15px] text-paper placeholder:text-dmut" type="email" name="email" required placeholder="Email for the Monday brief" aria-label="Email for The Ecosystem Brief" />
        <button class="btn btn-amber border-0 border-l-2 border-ink px-5" type="submit">Get the brief</button>
      </form>

      <div class="mt-3.5 flex flex-wrap gap-2">
        <a class="chip hover:bg-paper2" href="/climate-tech">Climate &amp; Energy</a>
        <a class="chip hover:bg-paper2" href="/startups?sector=Fintech">Fintech</a>
        <a class="chip hover:bg-paper2" href="/startups?sector=Health">Healthtech</a>
        <a class="chip hover:bg-paper2" href="/startups?stage=Seed">Seed</a>
        <a class="chip hover:bg-paper2" href="/jobs">Tech jobs</a>
      </div>
      <p class="mt-4 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">Index verified {verifiedDate} · {COMPANIES.length}/{COMPANIES.length} profiles carry a named source · <a class="link-underline hover:text-ink" href="/methodology">how we verify</a></p>
    </div>

    <!-- Ecosystem snapshot widget -->
    <aside class="offset-shadow border-2 border-ink bg-paper lg:col-span-5" aria-label="Ecosystem snapshot">
      <div class="flex items-center justify-between border-b border-ink px-4 py-3">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em]">Ecosystem snapshot</p>
        <Chip kind="confirmed" />
      </div>
      <div class="grid grid-cols-2 gap-px bg-line">
        {[
          { v: STATS.companiesTracked, s: '+', l: 'Startups tracked' },
          { v: STATS.activeInvestors, l: 'Active investors' },
          { v: STATS.openTechJobs, l: 'Open tech jobs' },
          { v: STATS.hackathonsIndexed, l: 'Hackathons indexed' },
        ].map((cell) => (
          <div class="bg-paper p-4">
            <!-- Static final value, no count-up animation. Numbers are the
                 product: they render correct on first paint, no flash. -->
            <p class="statnum text-[28px] leading-none">{cell.v}{cell.s && <span class="text-amber">+</span>}</p>
            <p class="mono-label mt-1.5">{cell.l}</p>
          </div>
        ))}
      </div>
      <div class="border-t border-ink px-4 py-3.5">
        <p class="mono-label mb-2.5">Tracked profiles by sector</p>
        <div class="flex h-20 items-end gap-1.5" aria-hidden="true">
          {SECTOR_ROWS.map((s, i) => (
            <div class="flex-1 bg-green" style={`height:${Math.max(8, Math.round((s.count / sectorMax) * 100))}%; ${i === 1 ? 'background:var(--color-amber2)' : ''}`} title={`${s.sector}: ${s.count}`}></div>
          ))}
        </div>
        <a class="link-underline mt-3 inline-block" href="/funding">Funding database →</a>
      </div>
    </aside>
  </section>

  <!-- 1b) FOUNDER STRIP, the 3-second answer: visibility -->
  <section class="border-y-2 border-ink bg-paper2" aria-label="For founders">
    <div class="wrap flex flex-col items-start gap-4 py-9 lg:flex-row lg:items-center lg:gap-8">
      <p class="kicker shrink-0">Founder?</p>
      <p class="max-w-2xl text-[15px] leading-relaxed text-ink2">
        Claim a free profile and get seen: your own page at <a class="link-underline text-green" href="/startups">startups.co.ke/startups/your-name</a>. Drop the link in your deck, bio and email signature. Investors search this index for deal flow; your open roles ride along.
      </p>
      <div class="flex flex-wrap gap-2 lg:ml-auto lg:shrink-0">
        <button class="btn btn-amber" data-modal="submit">Claim your free profile</button>
        <a class="btn btn-ghost" href="/startups/m-kopa">See a real profile</a>
      </div>
    </div>
  </section>

  <!-- 1c) THE WIRE, timely intelligence, high on the page -->
  <section class="border-b border-ink bg-paper2 py-14" aria-labelledby="news-h">
    <div class="wrap">
      <SectionHead no="01" title="The Wire: what moved this week." link={{ label: 'All coverage →', href: '/news' }} />
      <div class="grid gap-8 lg:grid-cols-12">
        <a class="rv group block border border-ink bg-paper lg:col-span-7" href={`/news/${leadArticle.slug}`}>
          <div class="overflow-hidden border-b border-ink">
            <DataPlate seed="sh93billion" label="startups.co.ke · analysis" class="h-64 w-full" />
          </div>
          <div class="p-5">
            <span class="chip chip-solid">{leadArticle.cat}</span>
            <h3 class="mt-3 font-display text-[24px] leading-tight">{leadArticle.title}</h3>
            <p class="mt-2 text-[14px] text-mut">{leadArticle.dek}</p>
            <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.12em] text-mut">startups.co.ke desk · Oct 15, 2026 · {leadArticle.mins} min read</p>
          </div>
        </a>
        <div class="rv border border-ink bg-paper lg:col-span-5" style="--d:120ms">
          {wireList.map(([t, k, slug], i) => (
            <a href={`/news/${slug}`} class="rowline group flex items-baseline gap-3 px-4 py-3.5 hover:bg-paper">
              <span class="statnum text-[12px] text-amber">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex-1 text-[14px] leading-snug">{t}</span>
              <span class="mono-label">{k}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2) MAP BAND -->
  <section class="wrap grid gap-8 pb-14 lg:grid-cols-2" aria-labelledby="regions-h">
    <div class="rv min-w-0"><KenyaMap /></div>
    <div class="rv min-w-0" style="--d:100ms">
      <h2 id="regions-h" class="text-[clamp(26px,3.2vw,40px)]">Explore by region.</h2>
      <p class="mt-2 max-w-md text-[14.5px] text-mut">All 47 counties on the map. Small dots = county seats; green rings = verified anchors: a named hub, checked against a public source. Most tracked startups are still Nairobi-based; we say so, and the anchors show where the next ones come from. Click a hub row for county detail.</p>
      <div class="railbox mt-5">
        {regionRows.map((r) => (
          <a href={`/startups?city=${encodeURIComponent(r.city)}`} class="rowline group flex items-center gap-4 px-4 py-3.5 hover:bg-paper2">
            <span class="w-24 shrink-0 font-mono text-xs uppercase tracking-[0.1em]">{r.city}</span>
            <span class="relative h-2.5 flex-1 bg-paper2">
              <span class="absolute inset-y-0 left-0 bg-green" style="width:100%"></span>
            </span>
            <span class="statnum w-10 text-right text-sm">{r.count}</span>
            {r.capital && <span class="chip chip-solid shrink-0">Capital</span>}
            <span class="text-ink opacity-0 transition-all duration-200 group-hover:translate-x-0.5 group-hover:opacity-100" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="railbox mt-5">
        <div class="railbox-head"><span>County anchors, verified</span><span class="mono-label">{ANCHORED_COUNTIES.length}/47 incl. Nairobi</span></div>
        {hubCounties.map((c) => (
          <div class="rowline flex items-center gap-3 px-4 py-3">
            <span class="w-28 shrink-0 font-mono text-xs uppercase tracking-[0.1em]">{c.name}</span>
            <span class="min-w-0 flex-1 text-[13.5px] leading-tight">{c.hub!.name}</span>
            <span class="chip chip-dashed shrink-0">{c.hub!.kind}</span>
          </div>
        ))}
        <p class="border-t border-line px-4 py-2.5 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">Sources: qz.com · AfriLabs · UNDP County Profiles · UNESCO DigiKen (Feb 2025) · hub listing</p>
      </div>
      <p class="mt-2.5 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">* Tracked profile counts · {regionRows.length} regions live · anchors = Nairobi + {hubCounties.length} regional hubs.</p>
    </div>
  </section>

  <!-- 3) STAT BAND, deduped: only figures the hero snapshot doesn't show -->
  <section class="border-y border-ink bg-paper2" aria-label="Ecosystem stats">
    <div class="wrap grid grid-cols-2 gap-px bg-line py-0 md:grid-cols-5">
      {[
        { v: ROUNDS.length, d: 'each with a named source', l: 'Rounds tracked' },
        { v: STATS.capitalYTD, p: '$', d: 'H1 2026 · Business Daily', l: 'Capital H1 (M)' },
        { v: STATS.capital2025, p: '$', d: '2025 · Africa #1', l: 'Capital 2025 (M)' },
        { v: STATS.investorLossesKsh, p: 'Sh', d: '13 failures · Business Daily', l: 'Investor losses (bn)' },
        { v: STATS.medianSeed / 1000, p: '$', d: 'derived from tracked rounds', l: 'Median seed (M)' },
      ].map((s) => (
        <div class="bg-paper2 px-4 py-6 text-center">
          <p class="statnum text-[30px] leading-none">{s.p ?? ''}<span data-count={s.v}>{s.v}</span></p>
          <p class="mono-label mt-1.5">{s.l}</p>
          <p class="mt-1 font-mono text-[9px] uppercase tracking-[0.1em] text-amber">{s.d}</p>
        </div>
      ))}
    </div>
    <p class="wrap pb-3 text-right font-mono text-[9px] uppercase tracking-[0.12em] text-mut">* Compiled from public sources · Oct 15, 2026</p>
  </section>

  <!-- 4) FUNDING INTELLIGENCE (dark) -->
  <section class="bg-dark py-14" aria-labelledby="funding-h">
    <div class="wrap">
      <SectionHead dark no="02" title="Funding data, with named sources." link={{ label: 'Full database →', href: '/funding' }} />
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="rv lg:col-span-7"><FundingChart dark /></div>
        <div class="rv lg:col-span-5" style="--d:120ms">
          <div class="border border-darkline bg-dark2">
            <div class="flex items-center justify-between border-b border-darkline px-4 py-3">
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-dpaper">Latest tracked rounds</p>
              <span class="chip border-dpaper/40 font-mono text-[10px] uppercase tracking-[0.08em] text-dmut">Sourced</span>
            </div>
            {ROUNDS.slice(0, 6).map((r) => {
              const c = COMPANIES.find((x) => x.id === r.companyId)!;
              return (
                <a href={`/startups/${c.id}`} class="block border-b border-darkline px-4 py-3 transition-colors last:border-0 hover:bg-dark">
                  <div class="flex items-center justify-between gap-3">
                    <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-dmut">{relDate(r.date)}</p>
                    <StatusDot status={r.status} />
                  </div>
                  <p class="mt-1 text-[14.5px] text-dpaper">
                    {c.name} · <span class="text-dmut">{r.round}</span>
                  </p>
                  <p class="mt-0.5 font-mono text-[12px] text-amber2"><span class="statnum">{fmtAmount(r.amount)}</span> <span class="text-dmut">· lead {r.lead}</span></p>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5) FEATURED VERIFIED STARTUPS -->
  <section class="wrap py-14" aria-labelledby="featured-h">
    <SectionHead no="03" title="Featured verified startups." link={{ label: 'Company index →', href: '/startups' }} />
    <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {featured.map((c, i) => (
        <div class="rv" style={`--d:${i * 80}ms`}><CompanyCard company={c} /></div>
      ))}
    </div>
  </section>

  <!-- 6) ECOSYSTEM INSIGHTS (tinted) -->
  <section class="bg-paper2 py-14" aria-labelledby="insights-h">
    <div class="wrap">
      <SectionHead no="04" title="Ecosystem insights." link={{ label: 'Investors →', href: '/investors' }} />
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="rv railbox min-w-0">
          <div class="railbox-head"><span>Startups tracked by sector</span><a class="link-underline" href="/startups">Full index</a></div>
          <div>
            {SECTOR_ROWS.map((s) => (
              <a href={`/startups?sector=${encodeURIComponent(s.sector)}`} class="group block border-b border-line px-4 py-2.5 transition-colors last:border-0 hover:bg-paper2">
                <span class="flex items-baseline gap-2">
                  <span class="font-mono text-[11px] font-medium uppercase tracking-[0.06em] text-ink">{s.sector}</span>
                  <span class="relative mx-1 h-1 flex-1 self-center bg-paper3"><span class="absolute inset-y-0 left-0 bg-green transition-all duration-500 group-hover:bg-amber" style={`width:${Math.round((s.count / sectorMax) * 100)}%`}></span></span>
                  <span class="statnum text-[12px]">{s.count}</span>
                  <span class="w-9 text-right font-mono text-[10px] text-mut">{Math.round((s.count / totalSector) * 100)}%</span>
                </span>
                <span class="mt-1 block truncate text-[12.5px] text-ink2 transition-colors group-hover:text-ink">
                  {sectorCompanies(s.sector).map((c) => c.name).join(' · ')}
                </span>
              </a>
            ))}
          </div>
          <p class="border-t border-line px-4 py-2.5 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">{totalSector} tracked · every profile status-tagged · counts derived from the index</p>
        </div>
        <div class="rv railbox min-w-0" style="--d:120ms">
          <div class="railbox-head"><span>Most active investors, derived</span><a class="link-underline" href="/investors">Directory ({INVESTORS.length}) →</a></div>
          {ACTIVE_INVESTORS.map((inv) => (
            <a href="/investors" class="rowline flex items-center gap-3 px-4 py-3 hover:bg-paper">
              <span class="w-40 min-w-0 shrink-0 truncate text-[13.5px]">{inv.name}</span>
              <span class="relative h-1.5 flex-1 bg-paper3" aria-hidden="true">
                <span class="absolute inset-y-0 left-0 bg-green" style={`width:${Math.max(8, Math.round((inv.rounds / activeMax) * 100))}%`}></span>
              </span>
              <span class="statnum w-16 shrink-0 text-right text-[12px]">{inv.rounds} round{inv.rounds === 1 ? '' : 's'}</span>
            </a>
          ))}
          <p class="border-t border-line px-4 py-2.5 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">Rounds each fund appears in (led or noted), projected from the rounds feed, nothing typed twice</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7) HACKATHONS (green) -->
  <section class="bg-green py-14 text-dpaper" aria-labelledby="hack-h">
    <div class="wrap grid items-center gap-10 lg:grid-cols-2">
      <div class="rv">
        <p class="kicker text-dmut">Hackathon index · East Africa builds in sprints</p>
        <h2 id="hack-h" class="mt-3 text-[clamp(30px,3.6vw,48px)] leading-[1.02]">Every build sprint, prize pool and winning team. Tracked.</h2>
        <p class="mt-4 max-w-md text-[15px] text-dpaper/85">
          From Nairobi Build Week to Kisumu's lake hackathons: {STATS.hackathonsIndexed} events indexed with prize pools, tracks, organizers and what happened to the winners.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-amber" href="/hackathons">Browse the hackathon index</a>
          <button class="btn btn-ondark" data-modal="listevent">List an event, free</button>
        </div>
      </div>
      <div class="rv" style="--d:120ms">
        <div class="border border-dpaper/30 bg-green2 p-5">
          <div class="flex items-center justify-between">
            <p class="font-mono text-[11px] uppercase tracking-[0.14em]">Next: {featuredHack.title}</p>
            {featuredHack.verifiedOrganizer && <span class="chip border-dpaper/40 font-mono text-[10px] uppercase tracking-[0.08em] text-dpaper/90">Organizer verified</span>}
          </div>
          <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.1em] text-dmut">{featuredHack.focus} · starts Nov 13, 2026 · 08:00 EAT</p>
          <div class="mt-4">
            <Countdown id="home-countdown" targetISO={featuredHack.startISO} dark />
          </div>
          <div class="mt-4 flex flex-wrap gap-1.5">
            {nextUp.map((h) => (
              <a class="chip border-dpaper/40 text-dpaper/90 hover:bg-dpaper/10" href="/hackathons">{h.title} · +{Math.max(0, Math.round((Date.parse(h.startISO!) - Date.now()) / 86400000))}d</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 9) RESEARCH -->
  <section class="wrap py-14" aria-labelledby="research-h">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="rv offset-shadow border-2 border-ink bg-green p-8 text-dpaper">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-dmut">STARTUPS.CO.KE · RESEARCH</p>
