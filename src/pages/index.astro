<script>
  // Newsletter forms (hero + bottom band share the handler via .brief-form)
  document.querySelectorAll<HTMLFormElement>('.brief-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (new FormData(form).get('email') as string) ?? '';
      const { subscribeNewsletter } = await import('@/lib/supabase');
      try {
        await subscribeNewsletter(email, 'home');
        const toast = window.sckToast;
        toast({ title: 'Subscribed', body: 'First brief lands Monday 06:30 EAT.' });
        form.reset();
      } catch {
        const toast = window.sckToast;
        toast({ title: 'Not sent', body: 'Network hiccup, please try again, your email is still in the field.', kind: 'warn' });
      }
    });
  });
</script>
