---
/**
 * CLIMATE & ENERGY HUB — /climate-tech
 *
 * The vertical page for Kenya's most capital-active sector: aggregates every
 * tracked profile with a climate lens (core business = climate-relevant),
 * their tagged funding rounds, and the honest ecosystem context. Targets
 * long-tail entity + directory searches while the broad terms mature.
 *
 * Honesty rules apply: every figure keeps its status + named source, tracked
 * counts are labelled as OUR index (not an ecosystem census), and the one
 * external stat (StartupBlink 659) is attributed inline.
 */
import Base from '@/layouts/Base.astro';
import CompanyCard from '@/components/CompanyCard.astro';
import { COMPANIES } from '@/data/companies';
import { INVESTORS } from '@/data/investors';
import { SITE } from '@/config/site';

/** Curated climate lens — core business is climate/energy relevant. Each keeps its own data + statuses. */
const CLIMATE_IDS = ['basigo', 'roam', 'sunculture', 'm-kopa', 'apollo', 'pula', 'iprocure'] as const;
const LENS: Record<string, string> = {
  basigo: 'Electric buses designed and assembled in Nairobi — decarbonising matatu routes',
  roam: 'Electric motorcycles and energy systems built in Nairobi',
  sunculture: 'Solar-powered irrigation replacing diesel pumps for smallholders',
  'm-kopa': 'Pay-as-you-go solar + connected assets on daily micro-payments',
  apollo: 'Climate-resilient inputs, credit and insurance for smallholders',
  pula: 'Agricultural and climate-risk insurance at scale across Africa',
  iprocure: 'Data-driven agri-supply chain linking rural retailers to manufacturers',
};

const climate = CLIMATE_IDS.map((id) => COMPANIES.find((c) => c.id === id)!).filter(Boolean);
const totalRaisedM = climate.reduce((s, c) => s + (c.raised ?? 0), 0);
const climateIds = new Set(CLIMATE_IDS as readonly string[]);
const rounds = climate
  .flatMap((c) => c.rounds.map((r) => ({ ...r, company: c.name, companyId: c.id })))
  .filter((r) => r.date)
  .sort((a, b) => String(b.date).localeCompare(String(a.date)));
const roundCount = rounds.length;
const backerCount = INVESTORS.filter((i) => i.portfolio.some((p) => climateIds.has(p))).length;
const topByCapital = [...climate].filter((c) => c.raised != null).sort((a, b) => (b.raised ?? 0) - (a.raised ?? 0)).slice(0, 3);
const fmtM = (v: number) => (v >= 1000 ? `$${(v / 1000).toFixed(2)}B` : `$${Math.round(v)}M`);

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Kenya climate tech — tracked startups, funding and investors',
    url: `${SITE.url}/climate-tech`,
    description:
      'Tracked Kenyan climate and energy startups with sourced funding histories — electric mobility, solar irrigation, agri-insurance and PAYG solar. Founder listings publish instantly.',
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Climate & Energy hub', item: `${SITE.url}/climate-tech` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Kenyan climate tech startups tracked on startups.co.ke',
    itemListElement: climate.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}/startups/${c.id}`,
      name: c.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How many climate tech startups are there in Kenya?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'startups.co.ke tracks 7 Kenyan startups whose core business is climate or energy related (electric mobility, solar, agri-fintech and climate insurance) as of October 2026 — each with a sourced funding history. This is a curated verified index, not an ecosystem census; third-party rankers list hundreds more Kenyan startups across all sectors.',
        },
      },
      {
        '@type': 'Question',
        name: 'Which Kenyan climate tech startups have raised the most?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Among tracked climate-lens profiles, the largest disclosed totals are ${topByCapital
            .map((c) => `${c.name} (${c.raisedDisplay ?? `$${c.raised}M`})`)
            .join(', ')}. Every figure carries a status — Confirmed, Reported or Estimated — and a named source on the profile.`,
        },
      },
      {
        '@type': 'Question',
        name: 'How much funding has Kenyan climate tech raised?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: `The ${climate.length} climate-lens startups tracked here have disclosed roughly ${fmtM(totalRaisedM)} combined across ${roundCount} dated rounds. That is the sum of our tracked profiles only — Kenya's climate sector is larger than this index. Kenya raised $984M in equity across all sectors in 2025 (Tech In Africa) and $126M in H1 2026 (Business Daily).`,
        },
      },
      {
        '@type': 'Question',
        name: 'How do I list my Kenyan climate startup?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Founders publish instantly and free via the founder-listing form — no approval queue. Your page goes live at startups.co.ke/startups/community/your-name with a Founder-submitted tag, and is upgraded to Verified once cross-checked against public sources.',
        },
      },
    ],
  },
];
---
<Base
  title="Kenya climate tech startups — tracked funding, verified profiles"
  description="Tracked Kenyan climate & energy startups — electric mobility, solar irrigation, agri-insurance, PAYG solar. Sourced funding rounds, active investors, and founder listings that publish instantly."
  jsonld={jsonld}
>
  <section class="wrap py-10">
    <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-mut">
      <a href="/" class="hover:text-ink">Home</a> / <a href="/startups" class="hover:text-ink">Startups</a> / <span class="text-ink">Climate & Energy</span>
    </p>

    <!-- Hero -->
    <div class="mt-4 border-b border-ink pb-8">
      <p class="kicker">Climate & Energy · Kenya · the capital lens</p>
      <h1 class="mt-2 max-w-3xl text-[clamp(30px,3.6vw,48px)] leading-[1.05]">Kenya's climate tech, <em class="italic">tracked</em>.</h1>
      <p class="mt-3 max-w-2xl text-[15px] text-ink2">
        The sector where Kenya's capital actually flows — electric mobility, solar irrigation,
        PAYG energy, agri-insurance. Every profile here has a sourced funding history; every
        figure keeps its status. Building in this space? Your listing goes live in minutes, not days.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <button class="btn btn-amber" data-modal="submit">List your climate startup — free, instant →</button>
        <a class="btn btn-ghost" href="/funding">Funding database</a>
      </div>
    </div>

    <!-- Stat band -->
    <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
      <div class="border border-ink p-4">
        <p class="statnum text-[30px] leading-none">{climate.length}</p>
        <p class="mono-label mt-2">Climate-lens profiles tracked</p>
        <p class="mt-1 text-[11.5px] text-mut">our index — not an ecosystem census</p>
      </div>
      <div class="border border-ink p-4">
        <p class="statnum text-[30px] leading-none">{fmtM(totalRaisedM)}</p>
        <p class="mono-label mt-2">Disclosed capital on tracked profiles</p>
        <p class="mt-1 text-[11.5px] text-mut">sum of tracked totals · per-figure sources on profiles</p>
      </div>
      <div class="border border-ink p-4">
        <p class="statnum text-[30px] leading-none">{roundCount}</p>
        <p class="mono-label mt-2">Dated rounds tracked</p>
        <p class="mt-1 text-[11.5px] text-mut">Confirmed / Reported / Estimated</p>
      </div>
      <div class="border border-ink p-4">
        <p class="statnum text-[30px] leading-none">{backerCount}</p>
        <p class="mono-label mt-2">Investors backing them</p>
        <p class="mt-1 text-[11.5px] text-mut"><a href="/investors" class="underline hover:text-ink">directory →</a></p>
      </div>
    </div>

    <!-- Profiles -->
    <div class="mt-12">
      <div class="flex items-end justify-between gap-4 border-b border-ink pb-3">
        <h2 class="font-display text-[26px]">The climate index.</h2>
        <a class="font-mono text-[10px] uppercase tracking-[0.12em] text-amber underline" href="/startups">Full company index →</a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {climate.map((c) => (
          <div class="rv" style={`--d:${(climate.indexOf(c)) * 70}ms`}>
            <CompanyCard company={c} />
            <p class="mt-2 text-[12px] leading-snug text-mut">
              <span class="font-mono text-[10px] uppercase tracking-[0.1em] text-amber">Lens</span> — {LENS[c.id]}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Capital context (all figures already sourced site-wide) -->
    <div class="mt-12 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="border-b border-ink pb-3">
          <h2 class="font-display text-[26px]">Why this page exists.</h2>
        </div>
        <div class="mt-5 space-y-4 text-[15px] leading-relaxed text-ink2">
          <p>
            Climate is where Kenya's venture capital concentrates. The ecosystem raised
            <strong class="text-ink">$984M in equity in 2025 — Africa #1 for the second year running</strong>
            (Tech In Africa), and even in the slower H1 2026 the country pulled $126M
            (Business Daily). Within that, the clearest repeatable story is energy and mobility:
            PAYG solar created the playbook, and electric mobility is running it back.
          </p>
          <p>
            Mainstream media covers the announcements; almost nobody maintains the browseable record.
            This hub is that record for Kenya's climate economy — tracked companies with dated,
            status-tagged rounds, the investors actually writing cheques, and an instant on-ramp for
            founders the record doesn't cover yet. Investors searching Kenya climate deal flow
            should be able to land here and leave with a shortlist.
          </p>
          <p>
            The honest caveat, kept in the open: {climate.length} profiles is our verified index,
            not the sector's full census. New climate startups appear weekly — founders can list
            themselves instantly below, and the desk upgrades listings to Verified once public
            sources confirm them. The index grows because the ecosystem pushes it.
          </p>
        </div>
      </div>
      <aside class="lg:col-span-5">
        <div class="railbox">
          <div class="railbox-head"><span>Largest tracked totals</span><span class="text-mut">disclosed</span></div>
          <ul class="divide-y divide-line">
            {topByCapital.map((c) => (
              <li class="flex items-center justify-between gap-3 px-4 py-3">
                <a href={`/startups/${c.id}`} class="text-[14px] font-medium underline decoration-line hover:decoration-ink">{c.name}</a>
                <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-ink2">{c.raisedDisplay ?? `$${c.raised}M`}</span>
              </li>
            ))}
          </ul>
          <p class="border-t border-line px-4 py-2.5 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">Totals as displayed on profiles · statuses attached per figure</p>
        </div>
        <div class="railbox mt-4">
          <div class="railbox-head"><span>Latest climate rounds</span><a class="text-amber underline" href="/funding">all →</a></div>
          <ul class="divide-y divide-line">
            {rounds.slice(0, 5).map((r) => (
              <li class="px-4 py-3">
                <p class="text-[13.5px] text-ink2">
                  <a class="font-medium underline decoration-line hover:decoration-ink" href={`/startups/${r.companyId}`}>{r.company}</a>
                  · {r.round} · {r.amount != null ? `$${r.amount}M` : 'amount n/d'}
                  <span class={`ml-1.5 font-mono text-[9.5px] uppercase tracking-[0.1em] ${r.status === 'Confirmed' ? 'text-green' : 'text-clay'}`}>{r.status}</span>
                </p>
                <p class="mt-0.5 font-mono text-[10px] uppercase tracking-[0.08em] text-mut">{r.date} · {r.source}</p>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    <!-- FAQ (visible + JSON-LD above) -->
    <div class="mt-12 border-t border-ink pt-6">
      <h2 class="font-display text-[26px]">Straight answers.</h2>
      <div class="mt-5 grid gap-6 md:grid-cols-2">
        <div>
          <h3 class="font-display text-[17px]">How many climate tech startups are in Kenya?</h3>
          <p class="mt-1.5 text-[14px] text-ink2">
            This index tracks {climate.length} with a climate lens as of Oct 2026, each with a sourced funding history.
            It's a curated verified record, not a census — ecosystem-wide lists run to hundreds across all sectors.
          </p>
        </div>
        <div>
          <h3 class="font-display text-[17px]">Which climate startups have raised the most?</h3>
          <p class="mt-1.5 text-[14px] text-ink2">
            {topByCapital.map((c) => `${c.name} (${c.raisedDisplay ?? `$${c.raised}M`})`).join(', ')}. Every total keeps its
            status — Confirmed, Reported or Estimated — with the source named on the profile.
          </p>
        </div>
        <div>
          <h3 class="font-display text-[17px]">How do I list my climate startup?</h3>
          <p class="mt-1.5 text-[14px] text-ink2">
            Use the founder form — your page publishes instantly at
            <span class="font-mono text-[12.5px]">/startups/community/your-name</span>, tagged Founder-submitted until we verify it. Free, no approval queue.
          </p>
        </div>
        <div>
          <h3 class="font-display text-[17px]">Where does the funding data come from?</h3>
          <p class="mt-1.5 text-[14px] text-ink2">
            Public disclosures — press, filings and databases — compiled by the desk with a named source on every figure.
            The full method is on the <a class="text-amber underline" href="/methodology">methodology page</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
