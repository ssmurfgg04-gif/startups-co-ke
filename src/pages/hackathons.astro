---
import Base from '@/layouts/Base.astro';
import Chip from '@/components/Chip.astro';
import Countdown from '@/components/Countdown.astro';
import SectionHead from '@/components/SectionHead.astro';
import { HACKATHONS } from '@/data/hackathons';
import { SITE } from '@/config/site';

const featured = HACKATHONS.find((h) => h.featured)!;
const ongoing = HACKATHONS.filter((h) => h.status === 'ongoing');
const upcoming = HACKATHONS.filter((h) => h.status === 'upcoming' && !h.featured);
const past = HACKATHONS.filter((h) => h.status === 'past');
const colors = ['bg-green', 'bg-amber', 'bg-ink'];
const fmtDay = (iso: string) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'Africa/Nairobi' }).format(new Date(iso)).toUpperCase();
const daysTo = (iso: string) => Math.max(0, Math.round((Date.parse(iso) - Date.now()) / 86400000));
---
<Base
  title="Hackathons Kenya — build sprints, conferences & competitions"
  description="Every Kenyan hackathon and builder event: dates, tracks, cities, live countdowns and organizers. Compiled from organiser pages — list your event free."
  jsonld={{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: "Kenya hackathon index",
    itemListElement: HACKATHONS.filter((h) => h.startISO).map((h, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Event',
        name: h.title,
        startDate: h.startISO,
        endDate: h.endISO,
        eventAttendanceMode: h.mode === 'Online' ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
        location: { '@type': 'Place', name: h.city, address: { '@type': 'PostalAddress', addressLocality: h.city, addressCountry: 'KE' } },
        organizer: { '@type': 'Organization', name: h.organizers ?? 'startups.co.ke' },
        description: h.focus,
        url: h.url ?? `${SITE.url}/hackathons`,
      },
    })),
  }}
>
  <!-- Hero -->
  <section class="bg-dark py-14 text-dpaper">
    <div class="wrap">
      <p class="kicker text-dmut">BUILD · COMPETE · LAUNCH</p>
      <h1 class="mt-3 max-w-2xl text-[clamp(36px,4.4vw,60px)] leading-[1.0]">Kenya's hackathon &amp; builder events calendar.</h1>
      <p class="mt-4 max-w-xl text-[15px] text-dmut">
        Real dates from organiser pages — conferences, hackathons and competitions, indexed with tracks and live countdowns. {HACKATHONS.length} listings right now.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <button class="btn btn-amber" data-modal="listevent">Submit an event</button>
        <a class="btn btn-ondark" href="#calendar">Browse calendar</a>
      </div>
    </div>
  </section>

  <section class="wrap py-10">
    <!-- Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink pb-3">
      <div class="flex flex-wrap gap-1" role="tablist" aria-label="Event status">
        {['Upcoming', 'Ongoing', 'Past'].map((t, i) => (
          <button class={`ev-tab border px-3.5 py-2 font-mono text-[11px] uppercase tracking-[0.12em] ${i === 0 ? 'border-ink bg-ink text-paper' : 'border-line text-mut hover:text-ink'}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={t.toLowerCase()}>
            {t}
          </button>
        ))}
      </div>
      <div class="flex flex-wrap gap-2">
        <select class="input input-mono h-9 w-36" aria-label="City"><option value="">All cities</option>{['Nairobi', 'Mombasa', 'Nakuru', 'Kisumu', 'Kilifi', 'Eldoret', 'Malindi', 'Online'].map((c) => <option>{c}</option>)}</select>
        <input class="input input-mono h-9 w-44" type="search" placeholder="Search events" aria-label="Search events" />
      </div>
    </div>

    <!-- UPCOMING -->
    <div id="ev-upcoming">
      <!-- Featured -->
      <div class="mt-8 grid border border-ink lg:grid-cols-12">
        <div class="relative min-h-[240px] overflow-hidden bg-green lg:col-span-5" aria-hidden="true">
          <svg viewBox="0 0 400 300" class="absolute inset-0 h-full w-full">
            <polygon points="0,0 180,0 60,300 0,300" fill="#0A321F"></polygon>
            <polygon points="400,0 400,200 220,300 300,0" fill="#134F38"></polygon>
            <polygon points="60,300 200,140 260,300" fill="#0E4630"></polygon>
            <polygon points="150,60 185,20 220,60 185,100" fill="#B87503"></polygon>
            <polygon points="320,40 345,70 295,70" fill="#E3A21A"></polygon>
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center text-dpaper">
            <p class="statnum text-[44px] leading-none">NOV 13–14</p>
            <p class="mono-label mt-2 text-dmut">Nairobi · 08:00 EAT open</p>
          </div>
        </div>
        <div class="p-6 lg:col-span-7">
          <div class="flex flex-wrap items-center gap-2">
            <span class="chip chip-solid">Featured</span>
            {featured.verifiedOrganizer && <span class="chip border-green text-green">Organizer verified</span>}
          </div>
          <h2 class="mt-3 text-[clamp(24px,2.6vw,34px)]">{featured.title}</h2>
          <p class="mt-2 text-[14.5px] text-ink2">{featured.theme}</p>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            <div><p class="mono-label">Kind</p><p class="mt-1 text-[14px]">{featured.kind}</p></div>
            <div><p class="mono-label">City</p><p class="mt-1 text-[14px]">{featured.city}</p></div>
            <div><p class="mono-label">Dates</p><p class="mt-1 text-[14px]">Nov 13–14, 2026</p></div>
          </div>
          <div class="mt-3 flex flex-wrap gap-1.5">{featured.tracks!.map((t) => <span class="chip chip-dashed">{t}</span>)}</div>
          <p class="mono-label mt-3">Organizers: {featured.organizers}</p>
          <div class="mt-5">
            <Countdown id="featured-countdown" targetISO={featured.startISO} />
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {featured.url && <a class="btn btn-amber" href={featured.url} target="_blank" rel="noopener noreferrer">Event details ↗</a>}
            <button class="btn btn-ghost" data-modal="register">Get reminders</button>
          </div>
        </div>
      </div>

      <!-- Grid -->
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {upcoming.map((h, i) => (
          <div class="rv flex flex-col border border-ink bg-paper" style={`--d:${i * 60}ms`}>
            <div class={`flex h-16 items-center justify-center ${colors[i % 3]} text-dpaper`}>
              <span class="statnum text-[16px]">{h.startISO ? `+${daysTo(h.startISO)} DAYS` : h.dateLabel ?? 'DATES TBA'}</span>
            </div>
            <div class="flex flex-1 flex-col p-4">
              <h3 class="font-display text-[18px] leading-tight">{h.title}</h3>
              <p class="mono-label mt-1">{h.focus}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                <span class="chip">📍 {h.city}</span>
                <span class="chip chip-dashed">{h.mode}</span>
                {h.startISO && <span class="chip">{fmtDay(h.startISO)}</span>}
                {!h.startISO && <Chip kind="tba" />}
              </div>
              <div class="mt-auto flex items-center justify-between pt-4">
                {h.verifiedOrganizer ? <Chip kind="verified" /> : <span class="mono-label">{h.kind}</span>}
                {h.url
                  ? <a class="btn btn-ghost h-9" href={h.url} target="_blank" rel="noopener noreferrer">Details ↗</a>
                  : <button class="btn btn-ghost h-9" data-modal="register">Remind me</button>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ONGOING -->
    <div id="ev-ongoing" class="mt-8 hidden">
      {ongoing.map((h, i) => (
        <div class={i ? 'mt-4' : ''}>
          <div class="border border-clay bg-paper p-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="relative inline-flex h-3 w-3"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-clay opacity-75"></span><span class="relative inline-flex h-3 w-3 rounded-full bg-clay"></span></span>
                <span class="font-mono text-[12px] font-semibold uppercase tracking-[0.14em] text-clay">LIVE NOW</span>
              </div>
              <span class="mono-label">ends {h.endISO ? fmtDay(h.endISO) : '—'}</span>
            </div>
            <h2 class="mt-3 text-[clamp(24px,2.6vw,34px)]">{h.title}</h2>
            <p class="mt-1 text-[14.5px] text-ink2">{h.focus} · {h.city} · {h.mode}</p>
            {h.endISO && <div class="mt-4 max-w-md"><Countdown id={`ongoing-countdown-${h.id}`} targetISO={h.endISO} mode="hms" dark={false} /></div>}
            <div class="mt-4 flex gap-2">
              {h.url && <a class="btn" href={h.url} target="_blank" rel="noopener noreferrer">Join ↗</a>}
              <button class="btn btn-ghost" data-modal="register">Get reminders</button>
            </div>
          </div>
        </div>
      ))}
      {!ongoing.length && <p class="text-[14px] text-mut">Nothing live right now — check the upcoming tab.</p>}
    </div>

    <!-- PAST -->
    <div id="ev-past" class="mt-8 hidden">
      <div class="overflow-x-auto border border-ink bg-paper">
        <table class="w-full min-w-[640px] border-collapse text-[13.5px]">
          <thead class="bg-paper2">
            <tr><th scope="col" class="th-mono">Event</th><th scope="col" class="th-mono">Dates</th><th scope="col" class="th-mono">City</th><th scope="col" class="th-mono">Notes</th></tr>
          </thead>
          <tbody>
            {past.map((h) => (
              <tr class="rowline">
                <td class="px-3 py-3 font-medium">{h.title}</td>
                <td class="px-3 py-3 font-mono text-[12px] text-mut">{h.startISO ? `${fmtDay(h.startISO)} – ${h.endISO ? fmtDay(h.endISO) : ''}` : h.dateLabel}</td>
                <td class="px-3 py-3">{h.city}</td>
                <td class="px-3 py-3 text-mut">{h.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Calendar -->
    <div id="calendar" class="mt-14">
      <SectionHead title="Ecosystem calendar." sub="Amber dot = indexed event with a real date. Month grid runs Monday-first." />
      <div class="railbox mx-auto max-w-2xl">
        <div class="flex items-center justify-between border-b border-ink px-4 py-3">
          <button id="cal-prev" class="btn btn-ghost h-8 px-2.5" aria-label="Previous month">←</button>
          <p id="cal-title" class="font-mono text-[12px] uppercase tracking-[0.14em]">—</p>
          <button id="cal-next" class="btn btn-ghost h-8 px-2.5" aria-label="Next month">→</button>
        </div>
        <div id="cal-grid" class="grid grid-cols-7 gap-px bg-line"></div>
        <div class="flex items-center gap-4 border-t border-ink px-4 py-2.5 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">
          <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full bg-amber"></span>Indexed event</span>
          <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full bg-clay"></span>Featured</span>
          <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full bg-ink ring-1 ring-ink"></span>Today</span>
        </div>
      </div>
    </div>

    <!-- organizer band -->
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <div class="railbox p-6">
        <h3 class="font-display text-[22px]">Organizing an event?</h3>
        <p class="mt-2 text-[14px] text-mut">List it free — get builders, sponsors and coverage in one place.</p>
        <button class="btn mt-4" data-modal="listevent">List an event — free</button>
      </div>
      <div class="railbox bg-ink p-6 text-paper">
        <h3 class="font-display text-[22px]">Sponsor a hackathon</h3>
        <p class="mt-2 text-[14px] text-dmut">Put your brand on the pipeline that produces the ecosystem's next hires and exits.</p>
        <button class="btn btn-amber mt-4" data-modal="sponsor">Become a sponsor</button>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ HACKATHONS: HACKATHONS.filter((h) => h.startISO).map((h) => ({ start: h.startISO, end: h.endISO, title: h.title, featured: !!h.featured })) }}>
  // Tabs
  document.querySelectorAll('.ev-tab').forEach(function (tab) {
    tab.addEventListener('click', function () {
      document.querySelectorAll('.ev-tab').forEach(function (t) {
        t.classList.remove('border-ink', 'bg-ink', 'text-paper');
        t.classList.add('border-line', 'text-mut');
      });
      tab.classList.add('border-ink', 'bg-ink', 'text-paper');
      tab.classList.remove('border-line', 'text-mut');
      ['upcoming', 'ongoing', 'past'].forEach(function (n) {
        var el = document.getElementById('ev-' + n);
        if (el) el.classList.toggle('hidden', n !== tab.dataset.tab);
      });
    });
  });

  // Calendar — REAL dated events
  var DAY = 86400000;
  var events = HACKATHONS.map(function (h) {
    var out = [];
    var s = new Date(h.start);
    var e = h.end ? new Date(h.end) : s;
    for (var d = new Date(s); d <= e; d = new Date(d.getTime() + DAY)) out.push({ date: d.toISOString().slice(0, 10), title: h.title, featured: h.featured });
    return out;
  }).flat();
  var monthOffset = 0;
  var grid = document.getElementById('cal-grid');
  var titleEl = document.getElementById('cal-title');
  var DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
  function render() {
    var base = new Date();
    var view = new Date(base.getFullYear(), base.getMonth() + monthOffset, 1);
    titleEl.textContent = view.toLocaleDateString('en-KE', { month: 'long', year: 'numeric' });
    var firstDow = (view.getDay() + 6) % 7;
    var days = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
    var today = new Date();
    var html = DOW.map(function (d) { return '<div class="mono-label bg-paper2 px-1 py-2 text-center">' + d + '</div>'; }).join('');
    for (var i = 0; i < firstDow; i++) html += '<div class="bg-paper"></div>';
    for (var d = 1; d <= days; d++) {
      var thisDate = new Date(view.getFullYear(), view.getMonth(), d);
      var iso = view.getFullYear() + '-' + String(view.getMonth() + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
      var isToday = thisDate.toDateString() === today.toDateString();
      var ev = events.find(function (e) { return e.date === iso; });
      html += '<div class="relative min-h-[64px] bg-paper p-1.5 text-right ' + (isToday ? 'ring-2 ring-ink' : '') + '">'
        + '<span class="font-mono text-[11px] ' + (isToday ? 'font-semibold' : 'text-mut') + '">' + d + '</span>'
        + (ev ? '<span title="' + ev.title + '" class="absolute bottom-1.5 left-1.5 inline-block h-2 w-2 rounded-full ' + (ev.featured ? 'bg-clay' : 'bg-amber') + '"></span>' : '')
        + '</div>';
    }
    grid.innerHTML = html;
  }
  document.getElementById('cal-prev').addEventListener('click', function () { monthOffset--; render(); });
  document.getElementById('cal-next').addEventListener('click', function () { monthOffset++; render(); });
  render();
</script>
