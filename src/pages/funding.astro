---
import Base from '@/layouts/Base.astro';
import FundingChart from '@/components/FundingChart.astro';
import StatusDot from '@/components/StatusDot.astro';
import Chip from '@/components/Chip.astro';
import Monogram from '@/components/Monogram.astro';
import { ROUNDS, CAPITAL_MIX, QUARTERS, SERIES } from '@/data/ecosystem';
import { companyById } from '@/data/companies';
import { fmtAmount } from '@/lib/utils';
import { SITE } from '@/config/site';
const ytd = SERIES['All sectors'].slice(-2).reduce((s, v) => s + v, 0); // H1 2026 = $126M (Business Daily)
const sortedRounds = [...ROUNDS].sort((a, b) => {
  if (a.date && b.date) return b.date.localeCompare(a.date);
  if (a.date) return -1;
  if (b.date) return 1;
  return 0;
});
---
<Base
  title="Funding database, Kenya startup funding rounds"
  description="Track Kenyan startup funding by quarter and sector: every round with amount, lead investor, source and a Confirmed / Reported / Estimated status."
  jsonld={{
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'Kenya Startup Funding Database',
    description: 'Quarterly tracked funding across the Kenyan startup ecosystem with source statuses. Compiled from public sources; last index refresh 19 Oct 2026.',
    url: `${SITE.url}/funding`,
    license: `${SITE.url}/privacy`,
    creator: { '@type': 'Organization', name: 'startups.co.ke', url: SITE.url },
  }}
>
  <section class="wrap py-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-[clamp(34px,4vw,56px)]">The funding database.</h1>
        <p class="mt-2 max-w-2xl text-[15px] text-mut">
          $126M tracked H1 2026 (−44.5% YoY, Business Daily), every figure carries a source and a status. Export for research below.
        </p>
      </div>
      <button class="btn" id="export-btn">Export quarterly dataset</button>
    </div>

    <div class="mt-8"><FundingChart dark /></div>

    <h2 class="mt-12 text-[clamp(24px,2.8vw,34px)]">Notable rounds, newest first.</h2>
    <div class="mt-2 mb-3 flex flex-wrap gap-4 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">
      <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full bg-green"></span>Confirmed</span>
      <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full bg-amber"></span>Reported</span>
      <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full bg-mut"></span>Estimated</span>
    </div>
    <div class="overflow-x-auto border border-ink bg-paper">
      <table class="w-full min-w-[760px] border-collapse text-[13.5px]">
        <thead class="bg-paper2">
          <tr>
            <th scope="col" class="th-mono">Date</th><th scope="col" class="th-mono">Company</th><th scope="col" class="th-mono">Round</th>
            <th scope="col" class="th-mono">Amount</th><th scope="col" class="th-mono">Lead investor</th><th scope="col" class="th-mono">Source</th><th scope="col" class="th-mono">Status</th>
          </tr>
        </thead>
        <tbody>
          {sortedRounds.map((r) => {
            const c = companyById(r.companyId)!;
            return (
              <tr class="rowline hover:bg-paper2">
                <td class="px-3 py-3 font-mono text-[12px] text-mut">{r.date || '—'}</td>
                <td class="px-3 py-3"><a class="font-medium hover:text-green" href={`/startups/${c.id}`}>{c.name}</a></td>
                <td class="px-3 py-3">{r.round}</td>
                <td class="px-3 py-3 statnum">{fmtAmount(r.amount)}</td>
                <td class="px-3 py-3">{r.lead}</td>
                <td class="px-3 py-3 font-mono text-[11px] text-mut">{r.source}</td>
                <td class="px-3 py-3"><StatusDot status={r.status} /></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <div class="railbox">
        <div class="railbox-head"><span>Where the capital went · tracked rounds</span><Chip kind="confirmed" /></div>
        <div class="px-4 py-4">
          {CAPITAL_MIX.map((m) => (
            <div class="mb-3 flex items-center gap-3 last:mb-0">
              <span class="w-44 shrink-0 truncate font-mono text-[11px] uppercase tracking-[0.06em] text-ink2">{m.label}</span>
              <span class="relative h-4 flex-1 bg-paper3"><span class="absolute inset-y-0 left-0 bg-green" style={`width:${m.pct * 3}%`}></span></span>
              <span class="statnum w-9 text-right text-[12px]">{m.pct}%</span>
            </div>
          ))}
        </div>
      </div>
      <div class="border-2 border-ink bg-paper p-5">
        <p class="font-mono text-[11px] uppercase tracking-[0.14em]">Methodology</p>
        <div class="mt-3 space-y-2.5 font-mono text-[11.5px] leading-relaxed text-ink2">
          <p><span class="font-semibold text-green">CONFIRMED</span>, round verified by company statement or lead-investor memo.</p>
          <p><span class="font-semibold text-amber">REPORTED</span>, credible secondary source (founder interview, syndicate note); confirmation pending.</p>
          <p><span class="font-semibold text-mut">ESTIMATED</span>, modelled from registry filings or comparable-round data.</p>
          <p class="border-t border-line pt-2.5 text-mut">Compiled from public sources; last index refresh 19 Oct 2026. Amounts in USD millions; rounds keyed by announcement where known. Every row carries its source.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.getElementById('export-btn')?.addEventListener('click', () => {
    const csv = (window as unknown as { __SCK_CSV__: string }).__SCK_CSV__;
    const blob = new Blob([csv], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'startups-co-ke-funding-database.csv';
    a.click();
    URL.revokeObjectURL(a.href);
    const toast = window.sckToast;
    toast({ title: 'Export ready', body: 'startups-co-ke-funding-database.csv downloaded.' });
  });
</script>
<script define:vars={{ QUARTERS, SERIES }}>
  // build the CSV at runtime from the same build-time constants
  // (SERIES keys are display names, 'All sectors', Fintech, Climate, Commerce)
  const col = (name) => (SERIES[name] ?? []).map((v) => (v ?? ''));
  window.__SCK_CSV__ = ['quarter,all,fintech,climate,commerce']
    .concat(
      QUARTERS.map((q, i) => [
        q,
        col('All sectors')[i] ?? '',
        col('Fintech')[i] ?? '',
        col('Climate')[i] ?? '',
        col('Commerce')[i] ?? '',
      ].join(','))
    )
    .join('\n');
</script>
