---
import Base from '@/layouts/Base.astro';
import Monogram from '@/components/Monogram.astro';
import Chip from '@/components/Chip.astro';
import { allJobs, isLive, employerById, LIVE, JOB_CATEGORIES } from '@/data/jobs';
import { SALARY_BANDS } from '@/data/ecosystem';
import { relDays } from '@/lib/utils';
import { SITE } from '@/config/site';

const jobs = allJobs();
const liveRows = jobs.filter((j) => isLive(j));
const payRows = jobs.filter((j) => !isLive(j)).length; // curated rows carry market bands; live ATS rows never invent pay
const liveSources = LIVE.sources.filter((s) => s.ok);
const liveCompanies = [...new Set(liveRows.map((j) => j.companyId))];
const salaryMax = 500;
const bands = SALARY_BANDS;

/** Compact relative date for the mobile pay strip ('3d', '2w', '1mo'), full form lives on desktop. */
function shortDays(pd: number): string {
  if (pd <= 0) return 'today';
  if (pd < 14) return `${pd}d`;
  if (pd < 60) return `${Math.round(pd / 7)}w`;
  return `${Math.round(pd / 30)}mo`;
}
---
<Base
  title="Tech jobs Nairobi, startup jobs in Kenya"
  description={`${jobs.length} open tech roles at Kenya's most ambitious startups, ${liveRows.length} pulled live from employer ATS boards. Engineering, data, product and design, with salary context and verified employers.`}
  jsonld={{
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Tech jobs at Kenyan startups',
    itemListElement: jobs.map((j, i) => {
      const c = employerById(j.companyId)!;
      const live = isLive(j);
      return {
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'JobPosting',
          title: j.title,
          hiringOrganization: { '@type': 'Organization', name: c.name },
          jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: j.location, addressCountry: 'KE' } },
          ...(j.mode === 'Remote' ? { jobLocationType: 'TELECOMMUTE' } : {}),
          datePosted: live
            ? (j.postedDays ? new Date(Date.now() - j.postedDays * 86400000).toISOString().slice(0, 10) : LIVE.fetchedAt)
            : new Date(Date.now() - j.postedDays * 86400000).toISOString().slice(0, 10),
          ...(!live && j.salaryMin != null && j.salaryMax != null ? { baseSalary: { '@type': 'MonetaryAmount', currency: 'KES', value: { '@type': 'QuantitativeValue', minValue: j.salaryMin * 1000, maxValue: j.salaryMax * 1000, unitText: 'MONTH' } } } : {}),
          description: live ? `${j.title}, ${j.location} · ${j.mode} (live from ${c.name}'s ${j.board} board)` : j.description + (j.source ? ` (Source: ${j.source})` : ''),
          url: live ? j.applyUrl : `${SITE.url}/jobs`,
        },
      };
    }),
  }}
>
  <!-- Dark hero -->
  <section class="bg-dark py-12 text-dpaper">
    <div class="wrap">
      <p class="kicker text-dmut">{jobs.length} open roles · {liveRows.length} pulled live from {liveCompanies.length} employer ATS boards · fetched {LIVE.fetchedAt}</p>
      <h1 class="mt-3 max-w-2xl text-[clamp(34px,4.2vw,56px)] leading-[1.02]">Tech jobs at Kenya's most ambitious startups.</h1>
      <p class="mt-4 max-w-2xl text-[14px] leading-relaxed text-dmut">
        <span class="text-dpaper">LIVE</span> rows come straight from employers' own hiring systems (Lever, Greenhouse, Workable, BambooHR and Ashby) every time this site rebuilds. You apply on the employer's own portal, never through us.
      </p>
      <p class="mt-3 max-w-2xl border-l-2 border-amber2 pl-3 text-[13.5px] leading-relaxed text-dpaper/85">
        Only {payRows} of {jobs.length} roles here publish pay. That's Kenya, most employers don't (Fuzu calls this market “zero salary transparency”). So where an ad hides the money, we attach a market band from published salary surveys. Bands, not offers.
      </p>
      <form class="mt-6 flex max-w-2xl flex-wrap gap-2" role="search" aria-label="Search jobs">
        <input class="input min-h-11 flex-1 border-dpaper/40 bg-dark2 text-dpaper placeholder:text-dmut" name="q" placeholder="Role, skill or company…" aria-label="Search jobs" />
        <select class="input input-mono w-40 border-dpaper/40 bg-dark2 text-dpaper" aria-label="Location" id="job-loc">
          <option value="">All Kenya</option><option value="nairobi">Nairobi</option><option value="mombasa">Mombasa</option><option value="kisumu">Kisumu</option><option value="remote">Remote</option>
        </select>
        <button class="btn btn-amber" type="button" id="job-search-btn">Search</button>
      </form>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {['Python', 'Fintech', 'Remote', 'Product', 'Data'].map((s) => <span class="chip border-dpaper/40 text-dpaper/90">{s}</span>)}
      </div>
    </div>
  </section>

  <section class="wrap py-10">
    <div class="grid gap-8 lg:grid-cols-12">
      <!-- Left: filters + rows -->
      <div class="lg:col-span-8">
        <div class="mb-4 flex flex-wrap items-center gap-2" role="tablist" aria-label="Job category">
          {JOB_CATEGORIES.map((cat, i) => (
            <button class={`job-cat border px-3 py-1.5 font-mono text-[10.5px] uppercase tracking-[0.1em] ${i === 0 ? 'border-ink bg-ink text-paper' : 'border-line text-mut hover:text-ink'}`} data-cat={cat} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{cat}</button>
          ))}
          <span id="job-count" class="mono-label ml-1 self-center">{jobs.length} roles</span>
          <label class="ml-auto flex cursor-pointer items-center gap-2 font-mono text-[11px] uppercase tracking-[0.1em] text-mut" title="Show only roles that publish a salary or band">
            Pay disclosed <input id="pay-only" type="checkbox" class="h-4 w-4 accent-[#0E4630]" />
          </label>
          <label class="flex cursor-pointer items-center gap-2 font-mono text-[11px] uppercase tracking-[0.1em] text-mut">
            Remote only <input id="remote-only" type="checkbox" class="h-4 w-4 accent-[#0E4630]" />
          </label>
          <label class="flex cursor-pointer items-center gap-2 font-mono text-[11px] uppercase tracking-[0.1em] text-mut" title="Only employers cross-checked against 2+ public sources">
            Verified only <input id="verified-only" type="checkbox" class="h-4 w-4 accent-[#0E4630]" />
          </label>
        </div>

        <div id="job-rows">
          {jobs.map((j) => {
            const c = employerById(j.companyId)!;
            const live = isLive(j);
            const when = live ? (j.postedDays !== null ? relDays(j.postedDays) : `via ${j.board}`) : relDays(j.postedDays);
            // Compact strip date for 375px, full form stays on the desktop column (and in title=).
            const shortWhen = live && j.postedDays === null ? `via ${j.board}` : shortDays(live ? j.postedDays ?? 0 : j.postedDays);
            // Standardized pay line (ovrion-style): every row states money in the same format, same slot.
            const payBand = live ? null : j.salaryMin != null && j.salaryMax != null ? `KSh ${j.salaryMin}–${j.salaryMax}K` : j.salary;
            return (
              <div class="job-row rowline border border-ink border-t-0 first:border-t bg-paper" data-cat={j.category} data-mode={j.mode} data-pay={live ? '0' : '1'} data-v={c.verified ? '1' : '0'} data-loc={`${j.location}`.toLowerCase()} data-title={`${j.title} ${c.name} ${j.tags.join(' ')}`.toLowerCase()}>
                <div class="grid w-full cursor-pointer grid-cols-[2.75rem_minmax(0,1fr)_auto] items-start gap-x-3 px-4 pb-3 pt-4 text-left hover:bg-paper2 md:grid-cols-[2.75rem_minmax(0,1fr)_9.5rem_5.5rem_auto_auto] md:items-center md:gap-y-0 md:pb-4" data-expand role="button" tabindex="0" aria-expanded="false">
                  <Monogram name={c.name} sector={c.sector} size="md" logo={c.logo ?? undefined} domain={c.domain ?? undefined} />
                  <span class="min-w-0">
                    <span class="flex flex-wrap items-center gap-2">
                      <span class="text-[15px] font-medium">{j.title}</span>
                      {live && <span class="chip chip-green font-semibold">● Live</span>}
                      {!live && j.featured && <span class="chip chip-amber">Featured</span>}
                      {c.status && <span class="chip chip-dashed">{c.status}</span>}
                    </span>
                    <span class="mono-label mt-0.5 block">
                      {!c.boardOnly && <a class="text-green hover:underline" href={`/startups/${c.id}`}>{c.name}</a>}
                      {c.boardOnly && <span class="text-ink2">{c.name} <span class="text-mut">· {c.submitted ? 'employer-submitted, desk reviewed' : 'board-only employer'}</span></span>}
                      {' '}· {j.location}
                      {j.mode && j.mode !== '—' && ` · ${j.mode}`}
                      {c.verified ? <span class="ml-1.5 font-semibold text-green">✓ Verified employer</span> : ''}
                    </span>
                  </span>
                  <span class="hidden text-right md:block">
                    {live ? (
                      <span class="block whitespace-nowrap font-mono text-[12px] italic text-mut" title="Pay not disclosed, see market bands in the rail">pay: n/d</span>
                    ) : (
                      <span class="statnum block whitespace-nowrap text-[13px]">{payBand}</span>
                    )}
                    <span class="mono-label block whitespace-nowrap">{live ? 'not disclosed' : j.salaryMin != null ? 'market band · mo' : 'employer stated'}</span>
                  </span>
                  <span class="hidden text-right md:block"><span class="mono-label">{when}</span></span>
                  <button class="bookmark-btn btn btn-ghost hidden h-9 w-9 !min-h-0 !px-0 md:inline-flex" data-bm={j.id} aria-label={`Bookmark ${j.title}`} aria-pressed="false">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12v18l-6-4-6 4Z"></path></svg>
                  </button>
                  <span class="jcaret mt-0.5 text-ink transition-transform duration-200 md:mt-0" aria-hidden="true">▾</span>
                  <span class="col-span-full mt-1.5 flex items-center justify-between gap-2 border-t border-dashed border-line2 pt-2 md:hidden">
                    <span class="flex min-w-0 items-baseline gap-1.5">
                      {live ? (
                        <span class="whitespace-nowrap font-mono text-[12.5px] italic text-mut" title="Pay not disclosed, see market bands in the rail">pay: n/d</span>
                      ) : (
                        <span class="statnum whitespace-nowrap text-[13.5px]">{payBand}{j.salaryMin != null && <span class="ml-1 font-mono text-[10px] font-normal uppercase tracking-[0.1em] text-mut">/ mo · band</span>}</span>
                      )}
                    </span>
                    <span class="flex shrink-0 items-center gap-1.5">
                      <span class="mono-label whitespace-nowrap" title={when}>{shortWhen}</span>
                      <button class="bookmark-btn btn btn-ghost -my-1.5 h-11 w-11 !min-h-0 !px-0 md:hidden" data-bm={j.id} aria-label={`Bookmark ${j.title}`} aria-pressed="false">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12v18l-6-4-6 4Z"></path></svg>
                      </button>
                    </span>
                  </span>
                </div>
                <div class="job-detail grid transition-[grid-template-rows] duration-300" style="grid-template-rows:0fr">
                  <div class="overflow-hidden">
                    <div class="border-t border-line px-4 py-4">
                      {live ? (
                        <p class="max-w-2xl text-[14px] leading-relaxed text-ink2">
                          Open role indexed live from {c.name}'s own {j.board} hiring board on {LIVE.fetchedAt}. Pay isn't published for this role, that's the norm here, not an oversight. The market bands in the rail tell you what similar roles pay.
                        </p>
                      ) : (
                        <p class="max-w-2xl text-[14px] leading-relaxed text-ink2">{j.description}</p>
                      )}
                      <div class="mt-3 flex flex-wrap gap-1.5">{j.tags.map((t) => <span class="chip chip-dashed">{t}</span>)}</div>
                      <div class="mt-4 flex flex-wrap gap-2">
                        <a class="btn btn-amber h-9" href={live ? j.applyUrl : (j.applyUrl || '#')} target={live || !j.applyUrl?.startsWith('mailto:') ? '_blank' : undefined} rel={live || !j.applyUrl?.startsWith('mailto:') ? 'noopener noreferrer' : undefined}>{live ? `Apply on ${c.name}'s ${j.board} board` : j.applyUrl?.startsWith('mailto:') ? 'Email your CV' : 'Apply on employer board'} &nearr;</a>
                        {!live && !j.applyUrl && <button class="btn btn-amber h-9" data-modal="apply">Apply now</button>}
                        <button class="btn btn-ghost h-9" data-modal="report">Report listing</button>
                      </div>
                      {live ? (
                        <p class="mono-label mt-3">Source: {c.name} {j.board} board · fetched {LIVE.fetchedAt} · Kenya-based roles only</p>
                      ) : (
                        j.source && <p class="mono-label mt-3">Source: {j.source}{j.salaryMin != null ? ' · salary shown is a market band, not the offer' : ' · pay as stated by the employer'}</p>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
        <p id="jobs-empty" class="hidden border border-dashed border-line2 p-8 text-center text-mut">No roles match, clear the category or remote filter.</p>
      </div>

      <!-- Right rail -->
      <aside class="space-y-6 lg:col-span-4">
        <div class="railbox">
          <div class="railbox-head"><span>Live board status</span><span class="mono-label">{LIVE.fetchedAt}</span></div>
          <div class="px-4 py-3">
            {LIVE.sources.map((s) => (
              <div class="flex items-center justify-between border-b border-line py-2 last:border-0">
                <span class="text-[13px]">{s.company} <span class="mono-label">· {s.board}</span></span>
                <span class={`font-mono text-[11px] uppercase tracking-[0.08em] ${s.kept ? 'text-green' : s.ok ? 'text-mut' : 'text-clay'}`}>
                  {s.kept ? `${s.kept} live` : s.ok ? 'board ok · 0 KE roles' : `unreachable${s.note ? ' · snapshot' : ''}`}
                </span>
              </div>
            ))}
            <p class="mono-label mt-3">{liveSources.length} employer boards checked at build · Kenya-relevant rows kept, everything else left out{LIVE.linkCheck && LIVE.linkCheck.dropped > 0 ? ` · ${LIVE.linkCheck.dropped} dead link${LIVE.linkCheck.dropped === 1 ? '' : 's'} auto-dropped on the last pull` : ''}. Boards re-pull on every deploy, daily via GitHub Actions.</p>
          </div>
        </div>

        <div class="railbox">
          <div class="railbox-head"><span>How listings are vetted</span><Chip kind="confirmed" /></div>
          <div class="px-4 py-3">
            <ul class="space-y-2 text-[13px] leading-snug text-ink2">
              <li><span class="mr-1.5 font-semibold text-green">✓</span>Every apply link is re-checked on each daily pull, dead ones drop automatically.</li>
              <li><span class="mr-1.5 font-semibold text-green">✓</span>Live roles come from employers' own hiring boards. Never a middleman, never scraped listings.</li>
              <li><span class="mr-1.5 font-semibold text-green">✓</span>Applying is free, always. Report anything that asks you for a fee.</li>
              <li><span class="mr-1.5 font-semibold text-green">✓</span>Pay bands come from published surveys, labelled as bands, never invented offers.</li>
            </ul>
            <p class="mono-label mt-3">Benchmark: StartupJobs Kenya tracked 54 startup roles nationwide (Oct 2026), we're smaller, and say so. <a class="text-green hover:underline" href="/methodology">Methodology →</a></p>
          </div>
        </div>

        <div class="railbox">
          <div class="railbox-head"><span>Post a job</span><span class="mono-label">from free</span></div>
          <div class="px-4 py-3">
            {SITE.jobPostPricing.map((p) => (
              <div class="border-b border-line py-2.5 last:border-0">
                <div class="flex items-center justify-between">
                  <span class="text-[13.5px]">{p.tier}</span><span class="statnum text-[13px]">{p.price}</span>
                </div>
                <p class="mono-label mt-0.5">{p.note}</p>
              </div>
            ))}
            <p class="mono-label mt-2.5">{SITE.jobPostPack}</p>
            <p class="mt-2 text-[12.5px] leading-relaxed text-mut">{SITE.jobPostPledge}</p>
            <button class="btn btn-amber mt-3 w-full" data-modal="postjob">Post a role</button>
          </div>
        </div>

        <div class="railbox">
          <div class="railbox-head"><span>Salary benchmark · KSh K/mo</span><Chip kind="estimated" /></div>
          <div class="px-4 py-4">
            {bands.map((b) => (
              <div class="mb-3 last:mb-0">
                <div class="mb-1 flex justify-between font-mono text-[10.5px] uppercase tracking-[0.08em] text-ink2">
                  <span>{b.role}</span><span>{b.min}–{b.max}</span>
                </div>
                <div class="relative h-3 bg-paper3">
                  <div class="absolute inset-y-0 bg-amber" style={`left:${(b.min / salaryMax) * 100}%;width:${((b.max - b.min) / salaryMax) * 100}%`}></div>
                </div>
              </div>
            ))}
            <p class="mono-label mt-3">Source: CareerBuddy (Jun 2026) · Mctaba (Jun 2026) · WageIndicator (2026) · axis 0–500K. Most Kenyan ads hide pay, these bands are the market context the ads leave out.</p>
          </div>
        </div>

        <div class="railbox">
          <div class="railbox-head"><span>Job alerts</span></div>
          <form class="px-4 py-4" data-kind="newsletter">
            <label class="mono-label block" for="ja-email">Email</label>
            <input id="ja-email" name="email" type="email" required class="input mt-1" placeholder="you@dev.co.ke" />
            <p class="mono-label mt-2">Weekly digest · one email a week</p>
            <button class="btn mt-3 w-full" type="submit">Create alert</button>
          </form>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  // Job filters
  const state = { cat: 'All', remote: false, pay: false, v: false, q: '', loc: '' };
  const rows = document.querySelectorAll<HTMLElement>('.job-row');
  function apply() {
    let n = 0;
    rows.forEach((r) => {
      const ok =
        (state.cat === 'All' || r.dataset.cat === state.cat) &&
        (!state.remote || r.dataset.mode === 'Remote') &&
        (!state.pay || r.dataset.pay === '1') &&
        (!state.v || r.dataset.v === '1') &&
        (!state.loc || (state.loc === 'remote' ? /remote/i.test(r.dataset.mode ?? '') : (r.dataset.loc || '').includes(state.loc))) &&
        (!state.q || r.dataset.title!.includes(state.q));
      r.classList.toggle('hidden', !ok);
      if (ok) n++;
    });
    document.getElementById('jobs-empty')?.classList.toggle('hidden', n > 0);
    const el = document.getElementById('job-count');
    if (el) el.textContent = `${n} of ${rows.length} roles`;
  }
  document.querySelectorAll('.job-cat').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.job-cat').forEach((x) => {
        x.classList.remove('border-ink', 'bg-ink', 'text-paper');
        x.classList.add('border-line', 'text-mut');
      });
      b.classList.add('border-ink', 'bg-ink', 'text-paper');
      b.classList.remove('border-line', 'text-mut');
      state.cat = (b as HTMLElement).dataset.cat!;
      apply();
    })
  );
  document.getElementById('remote-only')?.addEventListener('change', (e) => { state.remote = (e.target as HTMLInputElement).checked; apply(); });
  document.getElementById('pay-only')?.addEventListener('change', (e) => { state.pay = (e.target as HTMLInputElement).checked; apply(); });
  document.getElementById('verified-only')?.addEventListener('change', (e) => { state.v = (e.target as HTMLInputElement).checked; apply(); });
  document.getElementById('job-loc')?.addEventListener('change', (e) => { state.loc = (e.target as HTMLSelectElement).value; apply(); });
  document.getElementById('job-search-btn')?.addEventListener('click', () => {
    const q = (document.querySelector('input[name="q"]') as HTMLInputElement).value.trim().toLowerCase();
    state.q = q;
    apply();
  });

  // Expandable rows
  function toggleJob(row: HTMLElement) {
    const btn = row.querySelector<HTMLElement>('[data-expand]')!;
    const detail = row.querySelector<HTMLElement>('.job-detail')!;
    const open = detail.style.gridTemplateRows === '1fr';
    detail.style.gridTemplateRows = open ? '0fr' : '1fr';
    btn.setAttribute('aria-expanded', String(!open));
    row.querySelector('.jcaret')?.classList.toggle('rotate-180', !open);
  }
  document.querySelectorAll('.job-row').forEach((row) => {
    const el = row.querySelector<HTMLElement>('[data-expand]')!;
    el.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.bookmark-btn') || (e.target as HTMLElement).closest('a')) return;
      toggleJob(row as HTMLElement);
    });
    el.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if ((ev.key === 'Enter' || ev.key === ' ') && !(ev.target as HTMLElement).closest('.bookmark-btn') && !(ev.target as HTMLElement).closest('a')) {
        ev.preventDefault();
        toggleJob(row as HTMLElement);
      }
    });
  });

  // Bookmarks (persisted locally)
  const BM_KEY = 'sck-bookmarks';
  const bookmarks = new Set<string>(JSON.parse(localStorage.getItem(BM_KEY) || '[]'));
  function paintBm(id: string) {
    document.querySelectorAll(`[data-bm="${id}"]`).forEach((b) => {
      const on = bookmarks.has(id);
      b.setAttribute('aria-pressed', String(on));
      (b as HTMLElement).style.backgroundColor = on ? 'var(--color-amber2)' : '';
      (b as HTMLElement).style.color = on ? 'var(--color-ink)' : '';
    });
  }
  document.querySelectorAll('.bookmark-btn').forEach((b) =>
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = (b as HTMLElement).dataset.bm!;
      bookmarks.has(id) ? bookmarks.delete(id) : bookmarks.add(id);
      localStorage.setItem(BM_KEY, JSON.stringify([...bookmarks]));
      paintBm(id);
      const toast = (window as unknown as { sckToast: (t: { title: string; body?: string; kind?: string }) => void }).sckToast;
      toast({ title: bookmarks.has(id) ? 'Bookmarked' : 'Bookmark removed', body: 'Saved on this device.' });
    })
  );
  bookmarks.forEach(paintBm);

  // Job alerts inline form
  document.querySelector<HTMLFormElement>('form[data-kind="newsletter"]')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const email = (new FormData(form).get('email') as string) ?? '';
    const { subscribeNewsletter } = await import('@/lib/supabase');
    try {
      await subscribeNewsletter(email, 'job-alerts');
      const toast = (window as unknown as { sckToast: (t: { title: string; body?: string; kind?: string }) => void }).sckToast;
      toast({ title: 'Alert created', body: 'You are on the list. The digest goes out Mondays 06:30 EAT.' });
      form.reset();
    } catch {
      const toast = (window as unknown as { sckToast: (t: { title: string; body?: string; kind?: string }) => void }).sckToast;
      toast({ title: 'Saved locally', body: 'Supabase not connected in this environment.', kind: 'warn' });
    }
  });
</script>
