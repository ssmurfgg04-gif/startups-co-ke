---
import Base from '@/layouts/Base.astro';
import SectionHead from '@/components/SectionHead.astro';
import Chip from '@/components/Chip.astro';
import { REPORTS, TRENDS } from '@/data/ecosystem';
import { SITE } from '@/config/site';
const flagship = REPORTS.find((r) => r.flagship)!;
const library = REPORTS.filter((r) => !r.flagship);
const ARXIV = [
  { id: '2401.05760', title: 'Follow The Money: Key Factors Influencing Investment in African Startups', note: 'Funding drivers across African ecosystems — methodology reference for our status system.' },
  { id: '2408.09420', title: 'GraphRAG for startup-success prediction', note: 'Graph-based retrieval over funding graphs — informs how we link rounds, investors and companies.' },
  { id: '2410.03552', title: 'Risk ranking of AI startups in emerging markets (LATAM study)', note: 'Comparative emerging-market methodology — closest published analogue to Kenya\u2019s dataset.' },
];
---
<Base
  title="Research — Kenya startup ecosystem reports"
  description="Original research on Kenya's startup ecosystem: funding landscape, talent & compensation, payments infrastructure and hackathon impact."
  jsonld={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Research library',
      url: `${SITE.url}/research`,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How many startups are there in Kenya?',
          acceptedAnswer: { '@type': 'Answer', text: 'It depends who counts. Tracxn lists 13,642 Kenyan startups; StartupBlink counts 659. The difference is methodology, not market. This platform tracks a smaller, status-tagged index with a source on every figure.' },
        },
        {
          '@type': 'Question',
          name: 'How much did Kenyan startups raise in 2025?',
          acceptedAnswer: { '@type': 'Answer', text: '$984M in equity — the highest in Africa for a second straight year — and about $1.04B including debt (Tech In Africa; Invest Kenya).' },
        },
        {
          '@type': 'Question',
          name: 'What happened to Twiga Foods?',
          acceptedAnswer: { '@type': 'Answer', text: 'Twiga Foods entered administration on August 17, 2026 after raising $185.4M, per Techpoint Africa. Failure states like this are tracked on the platform alongside funding states.' },
        },
        {
          '@type': 'Question',
          name: 'Where can I find startup jobs in Nairobi?',
          acceptedAnswer: { '@type': 'Answer', text: 'The jobs board tracks roles seen live on employer boards (M-KOPA, SunCulture, BasiGo, Pula) with market-band salary context sourced from CareerBuddy, Mctaba and WageIndicator surveys.' },
        },
      ],
    },
  ]}}
>
  <section class="wrap py-10">
    <h1 class="text-[clamp(34px,4vw,56px)]">Research.</h1>
    <p class="mt-2 max-w-2xl text-[15px] text-mut">
      Original reports built on our index and methodology — every figure carries a status tag. Members unlock the full library.
    </p>

    <div class="mt-8 grid items-stretch gap-8 lg:grid-cols-12">
      <div class="rv lg:col-span-5">
        <div class="offset-shadow border-2 border-ink bg-green p-8 text-dpaper">
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-dmut">STARTUPS.CO.KE · RESEARCH</p>
          <svg viewBox="0 0 200 210" class="mx-auto my-6 w-44" aria-hidden="true">
            <path d="M40,180 L40,60 L100,30 L160,60 L160,180 Z" fill="none" stroke="#EFEAD9" stroke-width="1.4"></path>
            {[[62, 120], [70, 132], [78, 140], [88, 148], [96, 152], [104, 150], [112, 144], [120, 136], [128, 126], [98, 120], [92, 110], [86, 100], [78, 92], [70, 86], [108, 118], [116, 108], [124, 100], [132, 94]].map(([x, y]) => (
              <circle cx={x} cy={y} r="2" fill="#EFEAD9" opacity="0.75"></circle>
            ))}
            <circle cx="102" cy="132" r="4" fill="#E3A21A"></circle>
          </svg>
          <p class="text-center font-display text-[20px] leading-tight">{flagship.title}</p>
          <p class="mt-2 text-center font-mono text-[10px] uppercase tracking-[0.14em] text-dmut">{flagship.pages} pages · {flagship.date} · sourced edition</p>
        </div>
      </div>
      <div class="rv lg:col-span-7" style="--d:120ms">
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip chip-solid">Flagship</span>
          <Chip kind="confirmed" />
        </div>
        <h2 class="mt-3 text-[clamp(26px,3vw,38px)]">{flagship.title}</h2>
        <p class="mt-3 max-w-xl text-[15px] text-ink2">{flagship.blurb}</p>
        <ul class="mt-4 grid max-w-xl gap-1.5 text-[14px] text-ink2 md:grid-cols-2">
          <li>✓ Capital flows by quarter &amp; sector</li>
          <li>✓ County-level activity map</li>
          <li>✓ Talent &amp; compensation annex</li>
          <li>✓ Methodology &amp; status definitions</li>
        </ul>
        <div class="mt-5 flex flex-wrap gap-3">
          <button class="btn btn-amber" data-modal="buy">Buy — {flagship.price}</button>
          <button class="btn btn-ghost" data-modal="buy">Free sample chapter</button>
        </div>
      </div>
    </div>
    <div class="mt-14">
      <SectionHead title="Library — all reports." sub="Members unlock everything; individual reports available one-off." />
      <div class="border border-ink bg-paper">
        {library.map((r) => (
          <div class="rowline flex flex-wrap items-center gap-4 px-5 py-4">
            <div class="min-w-0 flex-1">
              <p class="text-[15.5px] font-medium">{r.title}</p>
              <p class="mt-0.5 text-[13px] text-mut">{r.blurb}</p>
              <p class="mono-label mt-1.5">{r.pages} pages · {r.date}</p>
            </div>
            <span class={`chip shrink-0 ${r.price === 'Free' ? 'chip-solid' : r.price === 'Members' ? '' : 'chip-amber'}`}>{r.price}</span>
            <button class="btn btn-ghost shrink-0" data-modal="buy">{r.price === 'Free' ? 'Download' : 'Unlock'}</button>
          </div>
        ))}
      </div>
    </div>

    <!-- Methodology & external research -->
    <div class="mt-14 grid gap-8 lg:grid-cols-2">
      <div class="railbox">
        <div class="railbox-head"><span>Methodology references · arXiv</span><Chip kind="reported" /></div>
        <div class="px-4 py-3">
          {ARXIV.map((a) => (
            <a class="rowline block py-2.5" href={`https://arxiv.org/abs/${a.id}`} target="_blank" rel="noopener noreferrer">
              <span class="block text-[14px] font-medium">{a.title}</span>
              <span class="mono-label">arXiv:{a.id} · {a.note}</span>
            </a>
          ))}
          <p class="mt-2 text-[12.5px] text-mut">Peer-reviewed and preprint work our status-tagging and graph-linking methodology draws on — cited, not buried.</p>
        </div>
      </div>
      <div class="railbox">
        <div class="railbox-head"><span>Consumer pulse · Google Trends KE</span><span class="mono-label">daily RSS · Oct 15, 2026</span></div>
        <div class="px-4 py-3">
          {TRENDS.map((t) => (
            <div class="rowline flex items-center justify-between py-2">
              <span class="text-[14px]">{t.keyword}</span>
              <span class="statnum text-[13px]">{t.volume}</span>
            </div>
          ))}
          <p class="mt-2 text-[12.5px] text-mut">Live consumer-search context from Google Trends (Kenya, daily RSS) — the demand-side backdrop to the funding data.</p>
        </div>
      </div>
    </div>

    <div class="railbox mt-8">
      <div class="railbox-head"><span>Why our counts differ from other databases</span></div>
      <div class="px-4 py-4 text-[14px] leading-relaxed text-ink2">
        <p>Tracxn lists 13,642 Kenyan startups; StartupBlink counts 659. Neither is a lie — they measure different things, and neither tells you which listings ever raised a shilling. This platform takes the opposite trade: fewer profiles, every figure status-tagged, every failure tracked. Where our coverage is thin we say so — a coverage gap is not a market gap.</p>
      </div>
    </div>
  </section>
</Base>
