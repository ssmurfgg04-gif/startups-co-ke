---
/**
 * FOUNDER-LISTED STARTUPS (community directory), /startups/community
 *
 * The index shell is prerendered; the listings themselves are fetched at
 * runtime from /startups/community/list.json (Cloudflare Worker over Supabase),
 * because founders publish INSTANTLY, no rebuild, no approval. Individual
 * profile pages are server-rendered by worker/index.js at /startups/community/:slug.
 */
import Base from '@/layouts/Base.astro';
import { SITE } from '@/config/site';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Founder-listed startups, Kenya',
  description:
    'Kenyan startups listed directly by their founders and published instantly, no approval queue. Founder-submitted listings are tagged until verified against public sources.',
  url: `${SITE.url}/startups/community`,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
};
---
<Base
  title="Founder-listed Kenyan startups, live instantly, no approval"
  description="Kenyan startups listed directly by their founders and published the moment they hit publish, no approval queue, free forever. Every listing is tagged Founder-submitted until verified against public sources."
  jsonld={jsonld}
>
  <section class="wrap py-10">
    <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-mut">
      <a href="/" class="hover:text-ink">Home</a> / <a href="/startups" class="hover:text-ink">Startups</a> / <span class="text-ink">Founder-listed</span>
    </p>

    <div class="mt-4 flex flex-col gap-6 border-b border-ink pb-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <h1 class="text-[clamp(30px,3.4vw,46px)] leading-[1.05]">Founder-listed startups.</h1>
        <p class="mt-3 text-[15px] text-ink2">
          Listed by the people building them, <strong class="text-ink">published the moment they hit publish</strong>.
          No approval queue, no waiting room, free forever. Each listing carries a
          <span class="chip chip-amber">Founder-submitted</span> tag until the desk cross-checks it
          against public sources, so investors always know what they're looking at.
        </p>
      </div>
      <div class="flex shrink-0 flex-col gap-2">
        <button class="btn btn-amber" data-modal="submit">List your startup, free, instant →</button>
        <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-mut">Your own URL · linked to your site · ~3 minutes</p>
      </div>
    </div>

    <div class="mt-8 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="font-display text-[22px]">The directory.</h2>
          <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-mut" data-community-count>Newest first · pulled live on every visit</p>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <input
            id="community-q"
            type="search"
            class="input input-mono h-10 min-w-0 flex-1 sm:max-w-xs"
            placeholder="Filter by name, sector, county…"
            aria-label="Filter founder listings"
          />
          <div id="community-sectors" class="flex flex-wrap gap-1.5" aria-label="Filter by sector"></div>
        </div>
        <div id="community-list" class="mt-5 grid gap-4 sm:grid-cols-2" aria-live="polite">
          <div class="border border-dashed border-line2 px-4 py-6 font-mono text-[11px] uppercase tracking-[0.12em] text-mut" data-community-loading>Loading listings…</div>
        </div>
        <noscript>
          <p class="mt-4 border border-line bg-paper2 px-4 py-3 text-[13.5px] text-ink2">
            Listing previews need JavaScript. Individual profile pages work without it —
            ask us for a direct link via the <a class="text-amber underline" href="/contact">contact page</a>.
          </p>
        </noscript>
      </div>

      <aside class="lg:col-span-4">
        <div class="railbox">
          <div class="railbox-head"><span>How publishing works</span><span class="text-green">✓ live</span></div>
          <ol class="list-decimal space-y-2.5 px-5 py-4 pl-8 text-[13.5px] text-ink2">
            <li>Fill the form, name, link, one-liner, logo if you have one.</li>
            <li>Hit <strong>publish</strong>. Your page goes live immediately at <span class="font-mono text-[12px]">/startups/community/your-name</span>.</li>
            <li>Drop the link in your deck, bio and email signature.</li>
            <li>We cross-check it against public sources and upgrade it to <strong>Verified</strong> when it holds up.</li>
          </ol>
        </div>
        <div class="railbox mt-4">
          <div class="railbox-head"><span>The honesty rules</span></div>
          <ul class="space-y-2.5 px-5 py-4 text-[13.5px] text-ink2">
            <li>· Instant listings are <strong>self-reported</strong>, always tagged, never passed off as verified.</li>
            <li>· Founder links are marked <span class="font-mono text-[11.5px]">nofollow ugc</span> until a listing is verified.</li>
            <li>· Spam gets rate-limited; fake listings can be reported and removed.</li>
            <li>· Your email is never shown on your page, the website link is what's public.</li>
          </ul>
        </div>
        <div class="railbox mt-4">
          <div class="railbox-head"><span>Verified instead?</span></div>
          <p class="px-5 py-4 text-[13.5px] text-ink2">
            Established company with public funding history? The <a class="text-amber underline" href="/startups">tracked company index</a>
            comes with editorial verification, funding rounds and investor links, <a class="text-amber underline" href="/contact">talk to the desk</a>.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <script>
    // Render founder listings client-side (instant-publish means the data is
    // dynamic, this page ships as a static shell and fills on load).
    // Viewability: instant search + sector chips derived from the live data,
    // live count in the header, monogrammed cards consistent with the index.
    (async () => {
      const host = document.getElementById('community-list');
      const qInput = document.getElementById('community-q') as HTMLInputElement | null;
      const sectorHost = document.getElementById('community-sectors');
      const countEl = document.querySelector('[data-community-count]');
      if (!host) return;
      const listEl = host; // narrowed alias so TS sees a non-null element in closures
      const fmtDate = (iso?: string) => {
        if (!iso) return '';
        const d = new Date(iso);
        return isNaN(d.getTime()) ? '' : d.toLocaleDateString('en-KE', { day: 'numeric', month: 'short', year: 'numeric' });
      };
      const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch] as string));
      const initials = (name: string) => {
        const w = String(name).replace(/[^a-zA-Z ]/g, '').split(/\s+/).filter(Boolean);
        return (w.length >= 2 ? w[0][0] + w[1][0] : String(name).slice(0, 2)).toUpperCase();
      };
      const SECTOR_HUES: Record<string, string> = {
        Fintech: '#0E4630', Commerce: '#B4530A', Logistics: '#4A4636', Agritech: '#4F7A28',
        Energy: '#B87503', 'Climate & Energy': '#4F7A28', Health: '#A63D2F', Edtech: '#1F5F5B',
        Proptech: '#6B4A2B', SaaS: '#3E4A3A', 'HR & Future of Work': '#7C6A00', Media: '#33312A',
        Mobility: '#44566B', Other: '#6E6A5B',
      };
      let rows: Array<Record<string, string | null>> = [];
      const activeSectors = new Set<string>();

      function render() {
        const q = (qInput?.value ?? '').trim().toLowerCase();
        const list = rows.filter((l) => {
          if (activeSectors.size && !activeSectors.has(String(l.sector ?? ''))) return false;
          if (!q) return true;
          const hay = `${l.name ?? ''} ${l.tagline ?? ''} ${l.sector ?? ''} ${l.stage ?? ''} ${l.county ?? ''}`.toLowerCase();
          return hay.includes(q);
        });
        if (countEl) countEl.textContent = rows.length
          ? `${rows.length} live founder listing${rows.length === 1 ? '' : 's'}${list.length !== rows.length ? ` · showing ${list.length}` : ''} · newest first`
          : 'Pulled live on every visit';
        if (!rows.length) {
          listEl.replaceChildren();
          const empty = document.createElement('div');
          empty.className = 'border border-dashed border-line2 px-5 py-8 text-center sm:col-span-2';
          empty.innerHTML = `
            <p class="font-display text-[20px]">The first listing is still up for grabs.</p>
            <p class="mt-2 text-[13.5px] text-mut">Three minutes, zero cost, no approval, your startup could be on this page right now.</p>
            <button class="btn btn-amber mt-4" data-modal="submit">Claim the first spot →</button>`;
          listEl.appendChild(empty);
          return;
        }
        if (!list.length) {
          listEl.replaceChildren();
          const none = document.createElement('div');
          none.className = 'border border-dashed border-line2 px-5 py-8 text-center sm:col-span-2';
          none.innerHTML = `<p class="font-display text-[18px]">Nothing matches that filter.</p><p class="mt-2 text-[13.5px] text-mut">Clear the search or pick another sector.</p>`;
          listEl.appendChild(none);
          return;
        }
        listEl.replaceChildren(...list.map((l) => {
          const a = document.createElement('a');
          a.className = 'group block border border-ink bg-paper p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_var(--color-paper3)]';
          a.href = `/startups/community/${encodeURIComponent(String(l.slug))}`;
          const hue = SECTOR_HUES[String(l.sector ?? '')] ?? SECTOR_HUES.Other;
          a.innerHTML = `
            <div class="flex items-start gap-3">
              <span aria-hidden="true" class="flex h-11 w-11 shrink-0 items-center justify-center font-mono text-[12px] font-semibold text-paper" style="background:${hue}">${esc(initials(String(l.name ?? '?')))}</span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center justify-between gap-2">
                  <h3 class="truncate font-display text-[19px] leading-tight">${esc(l.name)}</h3>
                  <span class="chip chip-amber shrink-0">Founder-submitted</span>
                </span>
                <p class="mt-1 line-clamp-2 text-[13.5px] text-mut">${esc(l.tagline)}</p>
              </span>
            </div>
            <div class="mt-3 flex flex-wrap gap-1.5">
              ${l.sector ? `<span class="chip">${esc(l.sector)}</span>` : ''}
              ${l.stage ? `<span class="chip chip-dashed">${esc(l.stage)}</span>` : ''}
              ${l.county ? `<span class="chip">${esc(l.county)}</span>` : ''}
            </div>
            <div class="mt-4 flex items-center justify-between border-t border-line pt-3 font-mono text-[10px] uppercase tracking-[0.1em] text-mut">
              <span class="truncate">${esc(String(l.website || '').replace(/^https?:\/\//, ''))}</span>
              <span class="flex items-center gap-2"><span>${esc(fmtDate(l.createdAt == null ? undefined : String(l.createdAt)))}</span><span class="text-ink transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span></span>
            </div>`;
          return a;
        }));
      }

      try {
        const r = await fetch('/startups/community/list.json', { headers: { Accept: 'application/json' } });
        const out = await r.json();
        rows = out?.startups ?? [];
        host.querySelector('[data-community-loading]')?.remove();
        // Sector chips only for sectors that actually have listings.
        const present = [...new Set(rows.map((l) => String(l.sector ?? '')).filter(Boolean))].sort();
        if (sectorHost && present.length > 1) {
          for (const s of present) {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'chip chip-dashed hover:bg-paper2';
            b.textContent = s;
            b.setAttribute('aria-pressed', 'false');
            b.addEventListener('click', () => {
              if (activeSectors.has(s)) { activeSectors.delete(s); b.classList.remove('chip-solid'); b.setAttribute('aria-pressed', 'false'); }
              else { activeSectors.add(s); b.classList.add('chip-solid'); b.setAttribute('aria-pressed', 'true'); }
              render();
            });
            sectorHost.appendChild(b);
          }
        }
        qInput?.addEventListener('input', render);
        render();
      } catch {
        const el = host?.querySelector('[data-community-loading]');
        if (el) el.textContent = 'Listings are temporarily unavailable, refresh in a moment.';
      }
    })();
  </script>
</Base>
